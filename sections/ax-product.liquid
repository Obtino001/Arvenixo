{%- liquid
  assign product = product | default: closest.product
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'ax-product-form-' | append: section.id
  assign featured_index = 0
  if current_variant.featured_media
    for media in product.media
      if media.id == current_variant.featured_media.id
        assign featured_index = forloop.index0
      endif
    endfor
  endif
  assign specs_html = product.metafields.custom.specs
  if specs_html == blank
    assign specs_html = section.settings.specs
  endif
  assign why_html = product.metafields.custom.why
  if why_html == blank
    assign why_html = section.settings.why
  endif
-%}

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

<section
  class="ax-pdp"
  data-ax-pdp
  data-url="{{ product.url }}"
  data-money-format="{{ shop.money_format | escape }}"
>
  <nav class="ax-pdp__crumbs ax-wrap">
    <a href="{{ routes.root_url }}">Home</a>
    <span>/</span>
    {%- if collection -%}
      <a href="{{ collection.url }}">{{ collection.title }}</a>
      <span>/</span>
    {%- endif -%}
    <span>{{ product.title }}</span>
  </nav>

  <div class="ax-pdp__top ax-wrap">
    <div class="ax-pdp__gallery" data-ax-gallery>
      <div class="ax-pdp__stage">
        {%- if product.media.size > 0 -%}
          {%- for media in product.media -%}
            {%- assign slide_active = false -%}
            {%- if forloop.index0 == featured_index -%}{%- assign slide_active = true -%}{%- endif -%}
            <div class="ax-pdp__slide{% if slide_active %} is-active{% endif %}" data-index="{{ forloop.index0 }}">
              {%- if media.media_type == 'image' -%}
                {%- assign img_alt = media.alt | default: product.title -%}
                {%- if slide_active -%}
                  {{ media | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', alt: img_alt, widths: '400, 700, 1000, 1400, 1600' }}
                {%- else -%}
                  {{ media | image_url: width: 1600 | image_tag: loading: 'lazy', alt: img_alt, widths: '400, 700, 1000, 1400, 1600' }}
                {%- endif -%}
              {%- else -%}
                {{ media | media_tag: image_size: '1400x' }}
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'ax-pdp__ph' }}
        {%- endif -%}
        {%- if product.media.size > 1 -%}
          <button type="button" class="ax-pdp__nav ax-pdp__nav--prev" data-ax-prev aria-label="Previous">‹</button>
          <button type="button" class="ax-pdp__nav ax-pdp__nav--next" data-ax-next aria-label="Next">›</button>
        {%- endif -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="ax-pdp__thumbs">
          {%- for media in product.media -%}
            <button type="button" class="ax-pdp__thumb{% if forloop.index0 == featured_index %} is-active{% endif %}" data-ax-thumb="{{ forloop.index0 }}" aria-label="Image {{ forloop.index }}">
              {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="ax-pdp__buy">
      {%- if section.settings.ship_note != blank -%}
        <p class="ax-pdp__ship">{{ section.settings.ship_note }}</p>
      {%- endif -%}
      <h1 class="ax-pdp__title">{{ product.title }}</h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="ax-pdp__sub">{{ section.settings.subtitle }}</p>
      {%- elsif product.metafields.descriptors.subtitle != blank -%}
        <p class="ax-pdp__sub">{{ product.metafields.descriptors.subtitle }}</p>
      {%- endif -%}
      <p class="ax-pdp__price" data-ax-price>
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <s>{{ current_variant.compare_at_price | money }}</s>
        {%- endif -%}
        {{ current_variant.price | money }}
      </p>

      {%- if section.blocks.size > 0 -%}
        <ul class="ax-pdp__benefits">
          {%- for block in section.blocks -%}
            {%- if block.type == 'benefit' and block.settings.text != blank -%}
              <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <product-form-component
        data-section-id="{{ section.id }}"
        data-product-id="{{ product.id }}"
        data-product-url="{{ product.url }}"
        on:submit="/handleSubmit"
        data-quantity-default="1"
      >
        <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
      {% form 'product', product, id: product_form_id, class: 'ax-pdp__form', data-type: 'add-to-cart-form' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-ax-variant-id ref="variantId">

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            {%- assign opt_down = option.name | downcase -%}
            <div class="ax-pdp__option" data-option-index="{{ forloop.index0 }}">
              <p class="ax-pdp__option-label">{{ option.name }}: <span data-ax-option-label>{{ option.selected_value }}</span></p>
              <div class="ax-pdp__swatches">
                {%- for value in option.values -%}
                  {%- assign option_disabled = true -%}
                  {%- for variant in product.variants -%}
                    {%- if variant.available -%}
                      {%- if option.position == 1 and variant.option1 == value -%}{%- assign option_disabled = false -%}{%- endif -%}
                      {%- if option.position == 2 and variant.option2 == value -%}{%- assign option_disabled = false -%}{%- endif -%}
                      {%- if option.position == 3 and variant.option3 == value -%}{%- assign option_disabled = false -%}{%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}
                  <button
                    type="button"
                    class="ax-pdp__chip{% if option.selected_value == value %} is-selected{% endif %}{% if opt_down contains 'color' or opt_down contains 'colour' %} is-color{% endif %}{% unless option_disabled == false %} is-unavailable{% endunless %}"
                    data-ax-option
                    data-option-position="{{ option.position }}"
                    data-value="{{ value | escape }}"
                    {% if value.swatch.color %}style="--swatch: {{ value.swatch.color }}"{% endif %}
                    {% if value.variant.featured_media %}data-media="{{ value.variant.featured_media.id }}"{% endif %}
                    aria-label="{{ value }}"
                  >
                    {%- if opt_down contains 'color' or opt_down contains 'colour' -%}
                      <span class="ax-pdp__dot" {% if value.swatch.image %}style="background-image:url({{ value.swatch.image | image_url: width: 72 }})"{% endif %}></span>
                    {%- else -%}
                      {{ value }}
                    {%- endif -%}
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
          <script type="application/json" data-ax-variants>
            [
              {%- for variant in product.variants -%}
                {"id":{{ variant.id }},"available":{{ variant.available }},"price":{{ variant.price | json }},"compare":{{ variant.compare_at_price | json }},"title":{{ variant.title | json }},"option1":{{ variant.option1 | json }},"option2":{{ variant.option2 | json }},"option3":{{ variant.option3 | json }},"featured":{% if variant.featured_media %}{{ variant.featured_media.position | minus: 1 }}{% else %}0{% endif %}}{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            ]
          </script>
        {%- endunless -%}

        <button
          type="submit"
          class="ax-pdp__atc"
          {% unless current_variant.available %}disabled{% endunless %}
          data-ax-atc
        >
          {%- if current_variant.available -%}
            {{ current_variant.price | money }} — Add to cart
          {%- else -%}
            Sold out
          {%- endif -%}
        </button>
      {% endform %}
      </product-form-component>

      <div class="ax-pdp__trust">
        <div>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V6l-8-3zm0 6.2 3.8 3.8-1.4 1.4L12 12l-2.4 2.4-1.4-1.4L12 9.2z" fill="currentColor"/></svg>
          <strong>{{ section.settings.trust_1_title }}</strong><span>{{ section.settings.trust_1_text }}</span>
        </div>
        <div>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7v3H4v10h16V12h-1V9a7 7 0 0 0-7-7zm0 2a5 5 0 0 1 5 5v3H7V9a5 5 0 0 1 5-5z" fill="currentColor"/></svg>
          <strong>{{ section.settings.trust_2_title }}</strong><span>{{ section.settings.trust_2_text }}</span>
        </div>
        <div>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h10l1 4H6l1-4zm-2 6h14v12H5V9zm5 3v6h4v-6h-4z" fill="currentColor"/></svg>
          <strong>{{ section.settings.trust_3_title }}</strong><span>{{ section.settings.trust_3_text }}</span>
        </div>
        <div>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C8 6 6 9.2 6 12.2A6 6 0 0 0 12 18a6 6 0 0 0 6-5.8C18 9.2 16 6 12 2zm0 14a3.5 3.5 0 0 1-3.5-3.8C8.5 10 10 7.6 12 5.2 14 7.6 15.5 10 15.5 12.2A3.5 3.5 0 0 1 12 16z" fill="currentColor"/></svg>
          <strong>{{ section.settings.trust_4_title }}</strong><span>{{ section.settings.trust_4_text }}</span>
        </div>
      </div>
    </div>
  </div>

  <div class="ax-pdp__tabs ax-wrap" data-ax-tabs>
    <div class="ax-pdp__tablist" role="tablist">
      <button type="button" class="is-active" data-tab="desc">Description</button>
      <button type="button" data-tab="specs">{{ section.settings.specs_label }}</button>
      <button type="button" data-tab="why">{{ section.settings.why_label }}</button>
    </div>
    <div class="ax-pdp__tabpanel is-active ax-pdp__desc" data-panel="desc">
      {{ product.description }}
    </div>
    <div class="ax-pdp__tabpanel" data-panel="specs" hidden>
      {%- if specs_html != blank -%}
        {{ specs_html }}
      {%- else -%}
        <p>Materials and fit details coming soon.</p>
      {%- endif -%}
    </div>
    <div class="ax-pdp__tabpanel" data-panel="why" hidden>
      {%- if why_html != blank -%}
        {{ why_html }}
      {%- else -%}
        <p>Designed to simplify daily carry — less bulk, more intention.</p>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.querySelector('[data-ax-pdp]');
    if (!root) return;

    var slides = root.querySelectorAll('.ax-pdp__slide');
    var thumbs = root.querySelectorAll('[data-ax-thumb]');
    var i = 0;
    slides.forEach(function (s, idx) { if (s.classList.contains('is-active')) i = idx; });
    function show(n) {
      if (!slides.length) return;
      i = (n + slides.length) % slides.length;
      slides.forEach(function (s, idx) { s.classList.toggle('is-active', idx === i); });
      thumbs.forEach(function (t, idx) { t.classList.toggle('is-active', idx === i); });
    }
    var prev = root.querySelector('[data-ax-prev]');
    var next = root.querySelector('[data-ax-next]');
    if (prev) prev.addEventListener('click', function () { show(i - 1); });
    if (next) next.addEventListener('click', function () { show(i + 1); });
    thumbs.forEach(function (t) {
      t.addEventListener('click', function () { show(parseInt(t.getAttribute('data-ax-thumb'), 10)); });
    });

    root.querySelectorAll('[data-ax-tabs] [data-tab]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var id = btn.getAttribute('data-tab');
        root.querySelectorAll('[data-ax-tabs] [data-tab]').forEach(function (b) { b.classList.toggle('is-active', b === btn); });
        root.querySelectorAll('[data-panel]').forEach(function (p) {
          var on = p.getAttribute('data-panel') === id;
          p.classList.toggle('is-active', on);
          p.hidden = !on;
        });
      });
    });

    var variantEl = root.querySelector('[data-ax-variant-id]');
    var atc = root.querySelector('[data-ax-atc]');
    var priceEl = root.querySelector('[data-ax-price]');
    var variants = [];
    var jsonEl = root.querySelector('[data-ax-variants]');
    if (jsonEl) {
      try { variants = JSON.parse(jsonEl.textContent); } catch (e) {}
    }
    var selected = {};
    root.querySelectorAll('.ax-pdp__option').forEach(function (opt, idx) {
      var current = opt.querySelector('.is-selected');
      if (current) selected[idx] = current.getAttribute('data-value');
    });
    function money(cents) {
      var fmt = root.getAttribute('data-money-format') || '${{amount}}';
      var amount = (Number(cents) / 100).toFixed(2);
      var noDec = String(Math.round(Number(cents) / 100));
      return fmt
        .replace(/\{\{\s*amount\s*\}\}/g, amount)
        .replace(/\{\{\s*amount_no_decimals\s*\}\}/g, noDec)
        .replace(/\{\{\s*amount_with_comma_separator\s*\}\}/g, amount.replace('.', ','))
        .replace(/\{\{\s*amount_with_apostrophe_separator\s*\}\}/g, amount.replace('.', "'"));
    }
    function matchVariant() {
      return variants.find(function (v) {
        return (v.option1 || null) === (selected[0] || v.option1 || null)
          && (v.option2 || null) === (selected[1] || v.option2 || null)
          && (v.option3 || null) === (selected[2] || v.option3 || null);
      }) || variants.find(function (v) { return v.option1 === selected[0]; });
    }
    root.querySelectorAll('[data-ax-option]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var wrap = btn.closest('.ax-pdp__option');
        var idx = parseInt(wrap.getAttribute('data-option-index'), 10);
        selected[idx] = btn.getAttribute('data-value');
        wrap.querySelectorAll('[data-ax-option]').forEach(function (b) { b.classList.toggle('is-selected', b === btn); });
        var label = wrap.querySelector('[data-ax-option-label]');
        if (label) label.textContent = selected[idx];
        var v = matchVariant();
        if (!v) return;
        if (variantEl) variantEl.value = v.id;
        if (priceEl) priceEl.innerHTML = v.compare && v.compare > v.price ? '<s>' + money(v.compare) + '</s> ' + money(v.price) : money(v.price);
        if (atc) {
          atc.disabled = !v.available;
          atc.textContent = v.available ? money(v.price) + ' — Add to cart' : 'Sold out';
        }
        if (typeof v.featured === 'number') show(v.featured);
        var url = new URL(window.location.href);
        url.searchParams.set('variant', v.id);
        history.replaceState({}, '', url.toString());
      });
    });
  })();
</script>

{% schema %}
{
  "name": "AX Product",
  "settings": [
    { "type": "text", "id": "subtitle", "label": "Subtitle", "info": "Leave blank to use product metafield descriptors.subtitle" },
    { "type": "text", "id": "ship_note", "label": "Shipping note", "default": "Free shipping on qualifying orders" },
    { "type": "text", "id": "trust_1_title", "label": "Trust 1 title", "default": "30-Day Returns" },
    { "type": "text", "id": "trust_1_text", "label": "Trust 1 text", "default": "Hassle-free" },
    { "type": "text", "id": "trust_2_title", "label": "Trust 2 title", "default": "Secure Checkout" },
    { "type": "text", "id": "trust_2_text", "label": "Trust 2 text", "default": "Encrypted" },
    { "type": "text", "id": "trust_3_title", "label": "Trust 3 title", "default": "MagSafe" },
    { "type": "text", "id": "trust_3_text", "label": "Trust 3 text", "default": "Compatible" },
    { "type": "text", "id": "trust_4_title", "label": "Trust 4 title", "default": "Premium materials" },
    { "type": "text", "id": "trust_4_text", "label": "Trust 4 text", "default": "Built to last" },
    { "type": "text", "id": "specs_label", "label": "Specs tab label", "default": "Compatibility / Specs" },
    { "type": "richtext", "id": "specs", "label": "Specs content", "default": "<p><strong>Compatible with</strong> MagSafe cases and iPhone 12 and newer.</p><p><strong>Materials:</strong> premium polymers, integrated magnets.</p>" },
    { "type": "text", "id": "why_label", "label": "Why tab label", "default": "Why we designed this" },
    { "type": "richtext", "id": "why", "label": "Why content", "default": "<p>Designed to solve the daily friction between access and security — a lighter carry, always at hand.</p>" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "AX Product" }],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
