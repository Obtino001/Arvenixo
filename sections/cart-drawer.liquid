{{ 'wi-cart-drawer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign ship_threshold = section.settings.ship_threshold | times: 100
  assign ship_remaining = ship_threshold | minus: cart.total_price
  if ship_remaining < 0
    assign ship_remaining = 0
  endif
  if ship_threshold > 0
    assign ship_percent = cart.total_price | times: 100.0 | divided_by: ship_threshold
    if ship_percent > 100
      assign ship_percent = 100
    endif
  else
    assign ship_percent = 0
  endif

  assign total_savings = 0
  for item in cart.items
    assign compare_price = item.variant.compare_at_price
    if item.original_line_price > item.line_price
      assign total_savings = total_savings | plus: item.original_line_price | minus: item.line_price
    elsif compare_price > item.final_price
      assign line_save = compare_price | minus: item.final_price | times: item.quantity
      assign total_savings = total_savings | plus: line_save
    endif
  endfor
-%}

<wi-cartdrawer>
  <div class="WI_cartDrawerin">
    {%- if section.settings.show_upsell_panel -%}
      <aside class="WI_cartDrawerin_upsell" aria-label="{{ section.settings.upsell_title | escape }}">
        <div class="WI_upsell_header">
          <h2 class="WI_upsell_title">{{ section.settings.upsell_title }}</h2>
        </div>
        <div class="WI_upsell_list" id="WI_upsell_list"></div>
        <div class="WI_upsell_trust">
          <div class="WI_upsell_trust_item">
            <span class="WI_upsell_trust_icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
            </span>
            <span>{{ section.settings.trust_1 }}</span>
          </div>
          <div class="WI_upsell_trust_item">
            <span class="WI_upsell_trust_icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </span>
            <span>{{ section.settings.trust_2 }}</span>
          </div>
          <div class="WI_upsell_trust_item">
            <span class="WI_upsell_trust_icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="4"/><path d="M6 20v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/></svg>
            </span>
            <span>{{ section.settings.trust_3 }}</span>
          </div>
        </div>
      </aside>
    {%- endif -%}

    <div class="WI_cartDrawerin_cart">
      <span data-cart-count hidden>{{ cart.item_count }}</span>

      <div class="WI_cartDrawerin_cart_header">
        <h2 class="WI_cartDrawerin_cart_headerH">
          <span class="WI_cartDrawer_count">{{ section.settings.cart_title }} ({{ cart.item_count }})</span>
          <button type="button" class="WI_cartDrawerCls" aria-label="Close bag">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </h2>
      </div>

      {%- if cart.item_count > 0 -%}
        <div class="WI_cartDrawer_shipping">
          {%- if cart.total_price >= ship_threshold -%}
            <p class="WI_cartDrawer_shipping_msg is-unlocked">{{ section.settings.ship_unlocked_text }}</p>
          {%- else -%}
            {%- assign ship_remaining_money = ship_remaining | money -%}
            <p class="WI_cartDrawer_shipping_msg">{{ section.settings.ship_progress_text | replace: '[amount]', ship_remaining_money }}</p>
          {%- endif -%}
          <div class="WI_cartDrawer_shipping_rail">
            <div class="WI_cartDrawer_shipping_bar">
              <div class="WI_cartDrawer_shipping_track">
                <div class="WI_cartDrawer_shipping_fill{% if cart.total_price >= ship_threshold %} is-full{% endif %}" style="width:{{ ship_percent }}%"></div>
                <span class="WI_ship_milestone WI_ship_milestone--ship{% if cart.total_price >= ship_threshold %} is-reached{% endif %}">
                  <span class="WI_ship_milestone_icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                  </span>
                </span>
                <span class="WI_ship_milestone WI_ship_milestone--gift{% if cart.total_price >= ship_threshold %} is-reached{% endif %}">
                  <span class="WI_ship_milestone_icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
                  </span>
                </span>
              </div>
              <div class="WI_cartDrawer_shipping_labels">
                <span class="WI_ship_caption WI_ship_caption--ship{% if cart.total_price >= ship_threshold %} is-reached{% endif %}">{{ section.settings.ship_milestone_label }}</span>
                <span class="WI_ship_caption WI_ship_caption--gift{% if cart.total_price >= ship_threshold %} is-reached{% endif %}">{{ section.settings.gift_milestone_label }}</span>
              </div>
            </div>
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.loyalty_banner != blank and cart.item_count > 0 -%}
        <div class="WI_loyalty_banner">{{ section.settings.loyalty_banner }}</div>
      {%- endif -%}

      <div class="wi-cart-global-loader hidden" aria-live="polite" aria-label="Loading">
        {% render 'wi-cart-spinner', size: 44 %}
      </div>

      {% if cart.item_count > 0 %}
        <div class="WI_cartDrawerin_cart_body">
          {% form 'cart', cart %}
            <div class="WI_cartDrawerin_cart_form_in">
              <div class="WI_cartDrawerin_cart_items">
                {% for item in cart.items %}
                  {%- liquid
                    assign is_gift = false
                    if item.original_price == 0 and item.final_price == 0
                      assign is_gift = true
                    endif
                    assign compare_price = item.variant.compare_at_price
                    assign on_sale = false
                    if compare_price > item.final_price or item.original_line_price > item.line_price
                      assign on_sale = true
                    endif
                  -%}
                  <div
                    class="WI_cartDrawer_item"
                    data-itemKey="{{ item.key }}"
                    data-savingPrice="{%- if compare_price > item.final_price -%}{{ compare_price | minus: item.final_price | times: item.quantity }}{%- endif -%}"
                  >
                    <div class="WI_cartDrawer_item_col WI_cartDrawer_item_col--media">
                      <div class="WI_cartDrawer_item_img">
                        <a href="{{ item.product.url }}">
                          {{ item.image | image_url: width: 200 | image_tag: loading: 'eager', alt: item.product.title }}
                        </a>
                      </div>
                      <button type="button" class="cartDrawerRemove text-remove-btn">{{ section.settings.remove_text }}</button>
                    </div>

                    <div class="WI_cartDrawer_item_col WI_cartDrawer_item_col--main">
                      <a href="{{ item.product.url }}" class="WI_cartDrawer_item_title">{{ item.product.title | escape }}</a>
                      {%- if item.product.has_only_default_variant == false -%}
                        <div class="WI_cartDrawer_item_options">
                          {%- for option in item.options_with_values -%}
                            <span class="option-tag">{{ option.value }}</span>
                          {%- endfor -%}
                        </div>
                      {%- endif -%}
                      {%- unless is_gift -%}
                        <div class="WI_cartDrawer_quantity">
                          <div class="wi-cart-qty-loader hidden" aria-hidden="true">
                            {% render 'wi-cart-spinner', size: 16 %}
                          </div>
                          <button type="button" class="WI_cartDrawer_minus" aria-label="Decrease quantity">−</button>
                          <input value="{{ item.quantity }}" type="number" readonly aria-label="Quantity">
                          <button type="button" class="WI_cartDrawer_plus" aria-label="Increase quantity">+</button>
                        </div>
                      {%- else -%}
                        <span class="WI_cartDrawer_gift_label">Complimentary</span>
                      {%- endunless -%}
                    </div>

                    <div class="WI_cartDrawer_item_col WI_cartDrawer_item_col--price">
                      {%- if is_gift -%}
                        <span class="WI_cartDrawer_item_price WI_cartDrawer_item_price--gift">Complimentary</span>
                      {%- elsif on_sale -%}
                        <span class="WI_cartDrawer_item_price WI_cartDrawer_item_price--sale">{{ item.final_price | money }}</span>
                        {%- if compare_price > item.final_price -%}
                          <span class="WI_cartDrawer_item_price WI_cartDrawer_item_price--was">{{ compare_price | money }}</span>
                        {%- elsif item.original_line_price > item.line_price -%}
                          <span class="WI_cartDrawer_item_price WI_cartDrawer_item_price--was">{{ item.original_price | money }}</span>
                        {%- endif -%}
                      {%- else -%}
                        <span class="WI_cartDrawer_item_price">{{ item.final_price | money }}</span>
                      {%- endif -%}
                    </div>

                    <div class="wi-cart-item-loader hidden" aria-hidden="true">
                      {% render 'wi-cart-spinner', size: 32 %}
                    </div>
                  </div>
                {% endfor %}
              </div>

              <div
                id="cart-drawer-data"
                style="display:none;"
                data-first-product-id="{% if cart.items.size > 0 %}{{ cart.items.first.product.id }}{% endif %}"
                data-cart-handles="{% for item in cart.items %}{{ item.product.handle }}{% unless forloop.last %},{% endunless %}{% endfor %}"
              ></div>

              {% if section.settings.show_discount_code %}
                <button type="button" class="WI_discount_toggle">{{ section.settings.discount_toggle_text }}</button>
                <div class="WI_discount_wrap is-collapsed">
                  <input
                    type="text"
                    name="discount"
                    class="WI_discount_input"
                    placeholder="{{ section.settings.discount_placeholder | escape }}"
                    autocomplete="off"
                  >
                  <button type="button" class="WI_discount_btn">{{ section.settings.discount_btn_text }}</button>
                </div>
              {% endif %}
            </div>

            <div class="WI_cartDrawerin_cart_footer">
              {%- if total_savings > 0 -%}
                <div class="WI_cartDrawer_savings">
                  <span>{{ section.settings.savings_label }}</span>
                  <span class="WI_cartDrawer_savings_val">−{{ total_savings | money }}</span>
                </div>
              {%- endif -%}
              <div class="WI_cartDrawer_total">
                <span>{{ section.settings.total_label }}</span>
                <span class="WI_cartDrawer_total_price">{{ cart.total_price | money }}</span>
              </div>
              <button type="submit" name="checkout" value="Checkout" class="WI_cartDrawer_checkout">
                {{ section.settings.checkout_btn_text }}
              </button>
              <ul class="WI_cartDrawer_badges">
                {% render 'wi-cart-payments' %}
              </ul>
            </div>
          {% endform %}
        </div>
      {%- else -%}
        <div class="WI_cartDrawerin_cart_empty">
          <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <p>{{ 'content.your_cart_is_empty' | t }}</p>
          <span>{{ section.settings.empty_text }}</span>
        </div>
      {% endif %}
    </div>
  </div>
</wi-cartdrawer>

<script src="{{ 'wi-cart-drawer.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Cart Drawer",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "show_upsell_panel",
      "label": "Show recommended products panel",
      "default": true
    },
    {
      "type": "text",
      "id": "upsell_title",
      "label": "Recommended panel title",
      "default": "Recommended products"
    },
    {
      "type": "text",
      "id": "cart_title",
      "label": "Cart title",
      "default": "Your bag"
    },
    {
      "type": "text",
      "id": "remove_text",
      "label": "Remove link text",
      "default": "Remove"
    },
    {
      "type": "header",
      "content": "Shipping progress"
    },
    {
      "type": "number",
      "id": "ship_threshold",
      "label": "Free shipping threshold (£)",
      "default": 75
    },
    {
      "type": "text",
      "id": "ship_progress_text",
      "label": "Progress text",
      "default": "Spend [amount] more for free shipping",
      "info": "Use [amount] for the remaining amount."
    },
    {
      "type": "text",
      "id": "ship_unlocked_text",
      "label": "Unlocked text",
      "default": "You've unlocked free shipping"
    },
    {
      "type": "text",
      "id": "ship_milestone_label",
      "label": "Shipping milestone label",
      "default": "Free shipping"
    },
    {
      "type": "text",
      "id": "gift_milestone_label",
      "label": "Gift milestone label",
      "default": "Member perk"
    },
    {
      "type": "richtext",
      "id": "loyalty_banner",
      "label": "Loyalty banner",
      "default": "<p>Arvenixo members get early access and exclusive offers. <a href=\"/account/login\">Sign in</a> or <a href=\"/account/register\">create an account</a></p>"
    },
    {
      "type": "header",
      "content": "Trust messages (left panel)"
    },
    {
      "type": "text",
      "id": "trust_1",
      "label": "Trust message 1",
      "default": "Free shipping on qualifying orders"
    },
    {
      "type": "text",
      "id": "trust_2",
      "label": "Trust message 2",
      "default": "30-day easy returns"
    },
    {
      "type": "text",
      "id": "trust_3",
      "label": "Trust message 3",
      "default": "Secure encrypted checkout"
    },
    {
      "type": "header",
      "content": "Discount & checkout"
    },
    {
      "type": "checkbox",
      "id": "show_discount_code",
      "label": "Show discount code",
      "default": true
    },
    {
      "type": "text",
      "id": "discount_toggle_text",
      "label": "Discount toggle text",
      "default": "Use gift card / discount code — click here"
    },
    {
      "type": "text",
      "id": "discount_placeholder",
      "label": "Discount placeholder",
      "default": "Enter code"
    },
    {
      "type": "text",
      "id": "discount_btn_text",
      "label": "Discount button",
      "default": "Apply"
    },
    {
      "type": "text",
      "id": "savings_label",
      "label": "Total savings label",
      "default": "Total savings:"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Total label",
      "default": "Total"
    },
    {
      "type": "text",
      "id": "checkout_btn_text",
      "label": "Checkout button",
      "default": "Go to checkout"
    },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "Empty cart text",
      "default": "Your bag is empty. Discover MagSafe cases and beauty tech designed to elevate every day."
    }
  ]
}
{% endschema %}
