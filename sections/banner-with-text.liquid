<div class="shopify-section section px-6 sm:px-10 lg:px-12 xl:px-16 pt-16 xs:pt-20 sm:pt-24 md:pt-28 lg:pt-32 xl:pt-36 pb-12" id="BannerText-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="w-full mx-auto max-w-screen-full">
    
    <!-- Top Header -->
    {%- if section.settings.section_heading != blank or section.settings.section_description != blank -%}
      <div class="space-y-4 sm:space-y-6 lg:space-y-7 xl:space-y-8 mb-8 lg:mb-10 xl:mb-12">
        {%- if section.settings.section_heading != blank -%}
          <h2 class="text-[28px] sm:text-[40px] md:text-[56px] lg:text-[72px] xl:text-[88px] leading-tight pb-4 sm:pb-5 xl:pb-6 border-b border-gray-300 font-medium tracking-tight text-black">
            {{ section.settings.section_heading }}
          </h2>
        {%- endif -%}
        
        {%- if section.settings.section_description != blank -%}
          <p class="w-full text-[14px] sm:text-[16px] xl:text-[18px] font-light text-gray-600 max-w-4xl">
            {{ section.settings.section_description }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- Banner Area -->
    <div class="w-full relative rounded-2xl md:rounded-[32px] overflow-hidden group shadow-xl">
      
      <!-- Overlay Content -->
      <div class="absolute z-10 inset-y-0 px-6 py-10 sm:px-12 sm:py-16 lg:px-20 flex items-center pointer-events-none">
        <div class="space-y-6 sm:space-y-8 lg:space-y-10 max-w-xl xl:max-w-2xl pointer-events-auto">
          {%- if section.settings.banner_heading != blank -%}
            <h3 class="text-[24px] xs:text-[28px] sm:text-[36px] md:text-[42px] lg:text-[56px] xl:text-[64px] leading-tight font-medium tracking-tight" style="color: {{ section.settings.text_color }};">
              {{ section.settings.banner_heading | newline_to_br }}
            </h3>
          {%- endif -%}
          
          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_link }}" class="block w-max text-[14px] xs:text-[15px] sm:text-[16px] lg:text-[18px] xl:text-[20px] leading-none font-medium py-3 sm:py-3.5 lg:py-4 px-8 sm:px-10 lg:px-12 rounded-full transition-transform duration-300 hover:scale-105 shadow-lg" style="background-color: {{ section.settings.button_bg_color }}; color: {{ section.settings.button_text_color }};">
              {{ section.settings.button_label }}
            </a>
          {%- endif -%}
        </div>
      </div>
      
      <!-- Background Overlay (for better text readability) -->
      <div class="absolute inset-0 z-[1] pointer-events-none transition-opacity duration-500 group-hover:opacity-80" style="background: linear-gradient(to right, rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 }}), transparent);"></div>

      <!-- Banner Image -->
      <div class="aspect-w-4 aspect-h-5 sm:aspect-w-4 sm:aspect-h-3 md:aspect-w-16 md:aspect-h-7 lg:aspect-w-21 lg:aspect-h-8 w-full relative z-0">
        {%- if section.settings.image_desktop != blank -%}
          {{ section.settings.image_desktop | image_url: width: 2400 | image_tag: class: 'block w-full h-full object-cover transition-transform duration-[10s] group-hover:scale-105 hidden md:block' }}
          
          {%- if section.settings.image_mobile != blank -%}
            {{ section.settings.image_mobile | image_url: width: 1000 | image_tag: class: 'block w-full h-full object-cover transition-transform duration-[10s] group-hover:scale-105 md:hidden' }}
          {%- else -%}
            {{ section.settings.image_desktop | image_url: width: 1000 | image_tag: class: 'block w-full h-full object-cover transition-transform duration-[10s] group-hover:scale-105 md:hidden' }}
          {%- endif -%}
        {%- else -%}
          <div class="w-full h-full bg-gray-200 flex items-center justify-center">
            {{ 'lifestyle-2' | placeholder_svg_tag: 'w-full h-full object-cover opacity-50' }}
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Feature Banner",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Top Header"
    },
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading",
      "default": "Style up by collections"
    },
    {
      "type": "textarea",
      "id": "section_description",
      "label": "Section Description",
      "default": "Complete your journey with our meticulously crafted accessories designed to complement and elevate your essentials."
    },
    {
      "type": "header",
      "content": "Banner Image"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Image (Optional)"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "label": "Dark Gradient Overlay Opacity",
      "info": "Helps make text readable on bright images.",
      "default": 30
    },
    {
      "type": "header",
      "content": "Banner Content"
    },
    {
      "type": "textarea",
      "id": "banner_heading",
      "label": "Banner Heading",
      "default": "Sunset Collection,\nDecorate Your Life"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Feature Banner"
    }
  ]
}
{% endschema %}
