<style>
  .custom-faq-image {
    display: flex;
    flex-wrap: wrap;
    background-color: {{ section.settings.bg_color }};
  }
  .custom-faq-image__left,
  .custom-faq-image__right {
    flex: 1 1 50%;
    width: 50%;
  }
  .custom-faq-image__left {
    min-height: 400px;
  }
  .custom-faq-image__left img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .custom-faq-image__left svg {
    width: 100%;
    height: 100%;
    background-color: #e2e2e2;
  }
  .custom-faq-image__right {
    padding: 60px 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  .custom-faq-image__content {
    max-width: 500px;
    width: 100%;
  }
  .custom-faq-image__heading {
    text-align: center;
    font-size: 32px;
    margin-bottom: 40px;
    color: #282828;
    text-transform: uppercase;
    font-weight: 900;
    line-height: 1.2;
    letter-spacing: 1px;
  }
  .custom-faq-item {
    border-bottom: 1px solid #d1d1d1;
  }
  .custom-faq-item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 0;
    cursor: pointer;
    font-weight: 500;
    font-size: 16px;
    color: #282828;
    list-style: none;
    letter-spacing: 0.5px;
  }
  .custom-faq-item summary::-webkit-details-marker {
    display: none;
  }
  .custom-faq-item summary .icon {
    font-size: 20px;
    font-weight: 300;
    transition: transform 0.3s ease;
  }
  .custom-faq-item[open] summary .icon {
    transform: rotate(45deg);
  }
  .custom-faq-item .faq-answer {
    padding-bottom: 18px;
    color: #555;
    font-size: 14px;
    line-height: 1.6;
  }
  .custom-faq-image__footer {
    text-align: center;
    margin-top: 40px;
  }
  .custom-faq-image__button {
    background-color: #0b2e21;
    color: #fff;
    padding: 15px 30px;
    text-decoration: none;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
    display: inline-block;
    border-radius: 2px;
    font-size: 12px;
  }
  
  @media screen and (max-width: 768px) {
    .custom-faq-image__left,
    .custom-faq-image__right {
      flex: 1 1 100%;
      width: 100%;
    }
    .custom-faq-image__right {
      padding: 40px 20px;
    }
    .custom-faq-image__heading {
      font-size: 28px;
    }
  }
</style>

<div class="custom-faq-image" id="CustomFaqImage-{{ section.id }}">
  <div class="custom-faq-image__left">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1500 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}">
    {%- else -%}
      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
  
  <div class="custom-faq-image__right">
    <div class="custom-faq-image__content">
      <h2 class="custom-faq-image__heading title">{{ section.settings.heading | replace: '\n', '<br>' }}</h2>
      
      {%- if section.settings.note_text != blank -%}
        <div class="custom-faq-note" style="margin-bottom: 20px; font-size: 15px; color: #444;">
          {{ section.settings.note_text }}
        </div>
      {%- endif -%}
      
      <div class="custom-faq-accordion">
        {%- for block in section.blocks -%}
          <details class="custom-faq-item" {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question }} <span class="icon">+</span></summary>
            <div class="faq-answer">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
      
      {%- if section.settings.button_label != blank -%}
        <div class="custom-faq-image__footer">
          <a href="{{ section.settings.button_link }}" class="custom-faq-image__button">
            {{ section.settings.button_label }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const detailsElements = document.querySelectorAll('#CustomFaqImage-{{ section.id }} details');
    detailsElements.forEach(targetDetail => {
      targetDetail.addEventListener('click', () => {
        detailsElements.forEach(detail => {
          if (detail !== targetDetail) {
            detail.removeAttribute('open');
          }
        });
      });
    });
  });
</script>

{% schema %}
{
  "name": "Image + FAQ",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Left Image"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "YOUR QUESTIONS\nANSWERED"
    },
    {
      "type": "richtext",
      "id": "note_text",
      "label": "Note Text",
      "default": "<p><strong><em>Note:</em></strong> <em>The 60-day guarantee applies to new customers and covers one pair only.</em></p>"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F6F5F0"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "READ ALL FAQS"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Block",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "WHY DOES OUR PRODUCT PERFORM BETTER?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We use premium materials and modern engineering.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image + FAQ",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "Product Description"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Materials & Care"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Shipping"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Size Guide"
          }
        }
      ]
    }
  ]
}
{% endschema %}
