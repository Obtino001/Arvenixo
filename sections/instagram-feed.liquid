{% schema %}
{
  "name": "Instagram Feed",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f4f4f4"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join 1.5M+ followers of @burgeofficial"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Instagram Link"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Image Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram Feed",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}

<style>
  .instagram-feed-section {
    background-color: var(--insta-bg);
    width: 100%;
    overflow: hidden;
  }
  .instagram-feed__header {
    text-align: center;
    padding: 3rem 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }
  .instagram-feed__header a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: #000;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .instagram-feed__header svg {
    width: 24px;
    height: 24px;
  }
  .instagram-feed__grid {
    display: flex;
    width: 100%;
    flex-wrap: nowrap;
  }
  .instagram-feed__item {
    flex: 1;
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }
  .instagram-feed__item img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .instagram-feed__item:hover img {
    transform: scale(1.05);
  }
  .instagram-feed__item svg.placeholder-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #e5e5e5;
    fill: #a3a3a3;
  }
  @media (max-width: 768px) {
    .instagram-feed__grid {
      flex-wrap: wrap;
    }
    .instagram-feed__item {
      flex: 0 0 33.333%;
    }
  }
</style>

<div class="instagram-feed-section" style="--insta-bg: {{ section.settings.bg_color }}">
  <div class="instagram-feed__header">
    <a href="{{ section.settings.link | default: '#' }}" target="_blank">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
        <path d="M12 2c2.717 0 3.056.01 4.122.06 1.065.05 1.79.217 2.428.465.66.254 1.216.598 1.772 1.153a4.908 4.908 0 0 1 1.153 1.772c.247.637.415 1.363.465 2.428.047 1.066.06 1.405.06 4.122 0 2.717-.01 3.056-.06 4.122-.05 1.065-.218 1.79-.465 2.428a4.883 4.883 0 0 1-1.153 1.772 4.915 4.915 0 0 1-1.772 1.153c-.637.247-1.363.415-2.428.465-1.066.047-1.405.06-4.122.06-2.717 0-3.056-.01-4.122-.06-1.065-.05-1.79-.218-2.428-.465a4.89 4.89 0 0 1-1.772-1.153 4.904 4.904 0 0 1-1.153-1.772c-.248-.637-.415-1.363-.465-2.428C2.013 15.056 2 14.717 2 12c0-2.717.01-3.056.06-4.122.05-1.066.217-1.79.465-2.428a4.88 4.88 0 0 1 1.153-1.772A4.897 4.897 0 0 1 5.45 2.525c.638-.248 1.362-.415 2.428-.465C8.944 2.013 9.283 2 12 2zm0 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm6.5-.25a1.25 1.25 0 1 0-2.5 0 1.25 1.25 0 0 0 2.5 0zM12 9a3 3 0 1 1 0 6 3 3 0 0 1 0-6z"></path>
      </svg>
      {{ section.settings.heading }}
    </a>
  </div>
  <div class="instagram-feed__grid">
    {% for block in section.blocks %}
      {% if block.settings.link %}
        <a href="{{ block.settings.link }}" class="instagram-feed__item" {{ block.shopify_attributes }}>
      {% else %}
        <div class="instagram-feed__item" {{ block.shopify_attributes }}>
      {% endif %}
        
        {% if block.settings.image %}
          <img src="{{ block.settings.image | image_url: width: 600 }}" alt="Instagram image" loading="lazy" width="600" height="600">
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}

      {% if block.settings.link %}
        </a>
      {% else %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>
