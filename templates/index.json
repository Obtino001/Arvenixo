{
  "sections": {
    "ax_hero": {
      "type": "ax-hero",
      "settings": {
        "min_height": 88,
        "eyebrow": "Arvenixo",
        "heading": "Carry lighter.",
        "text": "Precision MagSafe cases and beauty tech — made for everyday luxury.",
        "button_label": "Shop MagSafe",
        "button_link": "shopify://collections/all",
        "button2_label": "Explore beauty",
        "button2_link": "shopify://collections/all"
      }
    },
    "ax_worlds": {
      "type": "ax-shop-worlds",
      "blocks": {
        "w1": {
          "type": "world",
          "settings": {
            "title": "Protect",
            "asset": "ax-world-protect.png",
            "link": "shopify://collections/all"
          }
        },
        "w2": {
          "type": "world",
          "settings": {
            "title": "Charge",
            "asset": "ax-world-charge.png",
            "link": "shopify://collections/all"
          }
        },
        "w3": {
          "type": "world",
          "settings": {
            "title": "Beauty",
            "asset": "ax-world-beauty.png",
            "link": "shopify://collections/all"
          }
        }
      },
      "block_order": ["w1", "w2", "w3"],
      "settings": {
        "kicker": "Shop",
        "heading": "Protect. Charge. Glow."
      }
    },
    "ax_trust": {
      "type": "ax-trust",
      "blocks": {
        "t1": { "type": "item", "settings": { "title": "Free shipping", "text": "On qualifying orders." } },
        "t2": { "type": "item", "settings": { "title": "30-day returns", "text": "No fuss, no drama." } },
        "t3": { "type": "item", "settings": { "title": "Secure checkout", "text": "Encrypted payments." } },
        "t4": { "type": "item", "settings": { "title": "Built to last", "text": "Materials chosen for daily use." } }
      },
      "block_order": ["t1", "t2", "t3", "t4"],
      "settings": {}
    },
    "product_list": {
      "type": "product-list",
      "blocks": {
        "static-header": {
          "type": "_product-list-content",
          "static": true,
          "settings": {
            "content_direction": "row",
            "vertical_on_mobile": false,
            "horizontal_alignment": "space-between",
            "vertical_alignment": "flex-end",
            "align_baseline": true,
            "horizontal_alignment_flex_direction_column": "flex-start",
            "vertical_alignment_flex_direction_column": "center",
            "gap": 12,
            "width": "fill",
            "custom_width": 100,
            "width_mobile": "fill",
            "custom_width_mobile": 100,
            "height": "fit",
            "custom_height": 100,
            "background_media": "none",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "product_list_text": {
              "type": "_product-list-text",
              "settings": {
                "text": "<h3>Featured</h3>",
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "h4",
                "font": "var(--font-heading--family)",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "product_list_button": {
              "type": "_product-list-button",
              "settings": {
                "label": "View all",
                "open_in_new_tab": false,
                "style_class": "link",
                "width": "fit-content",
                "custom_width": 100,
                "width_mobile": "fit-content",
                "custom_width_mobile": 100
              }
            }
          },
          "block_order": ["product_list_text", "product_list_button"]
        },
        "static-product-card": {
          "type": "_product-card",
          "static": true,
          "settings": {
            "product_card_gap": 8,
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "gallery": {
              "type": "_product-card-gallery",
              "settings": {
                "image_ratio": "portrait",
                "border": "none",
                "border_width": 1,
                "border_opacity": 100,
                "border_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "title": {
              "type": "product-title",
              "settings": {
                "width": "100%",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "rte",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 8,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "price": {
              "type": "price",
              "settings": {
                "show_sale_price_first": true,
                "show_installments": false,
                "show_tax_info": false,
                "type_preset": "h6",
                "width": "100%",
                "alignment": "left",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            }
          },
          "block_order": ["gallery", "title", "price"]
        }
      },
      "settings": {
        "collection": "all",
        "layout_type": "grid",
        "carousel_on_mobile": true,
        "max_products": 8,
        "columns": 4,
        "mobile_columns": "2",
        "mobile_card_size": "60cqw",
        "columns_gap": 12,
        "rows_gap": 24,
        "icons_style": "arrow",
        "icons_shape": "none",
        "section_width": "page-width",
        "horizontal_alignment": "flex-start",
        "gap": 28,
        "background_color": "#f4f1ec",
        "padding-block-start": 56,
        "padding-block-end": 56
      }
    },
    "ax_story": {
      "type": "ax-story",
      "settings": {
        "kicker": "MagSafe",
        "heading": "Aligned. Protected. Invisible.",
        "text": "Neodymium magnets sit flush inside a slim case, so charging feels native — not added on.",
        "button_label": "Shop MagShield",
        "button_link": "shopify://collections/all"
      }
    },
    "ax_editorial": {
      "type": "ax-editorial",
      "settings": {
        "kicker": "Beauty tech",
        "heading": "Ritual, not clutter.",
        "text": "Devices designed to sit on a nightstand without shouting. Clinical performance, quiet presence.",
        "button_label": "Shop beauty tech",
        "button_link": "shopify://collections/all"
      }
    },
    "ax_newsletter": {
      "type": "ax-newsletter-split",
      "settings": {
        "kicker": "Arvenixo",
        "offer": "15% OFF",
        "text": "Save on your first order.",
        "button_label": "Get my code"
      }
    }
  },
  "order": [
    "ax_hero",
    "ax_worlds",
    "ax_trust",
    "product_list",
    "ax_story",
    "ax_editorial",
    "ax_newsletter"
  ]
}
