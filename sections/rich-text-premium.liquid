{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="shopify-section section section-{{ section.id }}-padding px-6 sm:px-10 lg:px-12 xl:px-16" id="RichText-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="w-full mx-auto {{ section.settings.page_width }}">
      <div class="w-11/12 sm:w-3/4 md:w-max mx-auto text-center space-y-8">
        <div class="space-y-4 sm:space-y-5 lg:space-y-6 xl:space-y-7">
          {%- if section.settings.heading != blank -%}
            <h2 class="text-[30px] xs:text-[36px] sm:text-[48px] md:text-[64px] lg:text-[80px] xl:text-[96px] leading-none tracking-tight font-medium" style="color: {{ section.settings.text_color }};">
              {{ section.settings.heading | newline_to_br }}
            </h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <div class="text-[14px] sm:text-[16px] xl:text-[18px] font-light opacity-80 max-w-3xl mx-auto" style="color: {{ section.settings.text_color }};">
              {{ section.settings.text }}
            </div>
          {%- endif -%}
        </div>
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="premium-btn block w-max mx-auto text-[14px] sm:text-[15px] xl:text-[16px] leading-none py-3 px-6 sm:px-8 xl:px-10 border rounded-full transition-all duration-300">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<style>
  #RichText-{{ section.id }} .premium-btn {
    color: {{ section.settings.text_color }};
    border-color: {{ section.settings.text_color | color_modify: 'alpha', 0.3 }};
  }
  #RichText-{{ section.id }} .premium-btn:hover {
    background-color: {{ section.settings.text_color }};
    color: {{ section.settings.bg_color }};
    transform: scale(1.05);
  }
</style>

{% schema %}
{
  "name": "Premium Rich Text",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "page_width",
      "label": "Page Width",
      "options": [
        { "value": "max-w-screen-xl", "label": "Standard" },
        { "value": "max-w-[1440px]", "label": "Wide" },
        { "value": "max-w-screen-full", "label": "Full Width" }
      ],
      "default": "max-w-screen-full"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 96
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Carry Lighter, Live Now."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Built from high-performance materials and intentional design,<br>Arvenixo redefines the way we carry — light, precise, and present.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "About Our Philosophy"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Premium Rich Text"
    }
  ]
}
{% endschema %}
