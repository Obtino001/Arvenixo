{% comment %}
  Samling med modellvelger
  © Panthure.dk

  Lar kunder velge mellom flere robotmodeller og se alle deler for den modellen.
  Perfekt for å organisere robotstøvsuger deler etter modell.
{% endcomment %}

{% style %}
  .featured-collection-selector-{{ section.id }} {
    --color-foreground: 18, 18, 17;
    --color-background: 255,255,255;
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .featured-collection-selector-{{ section.id }} .section-header {
    text-align: {{ section.settings.heading_alignment }};
    margin-bottom: 2rem;
  }

  .featured-collection-selector-{{ section.id }} .section-title {
    margin: 0 0 1rem;
  }

  .featured-collection-selector-{{ section.id }} .section-subtitle {
    margin: 0 0 2rem;
    opacity: 0.7;
  }

  .featured-collection-selector-{{ section.id }} .model-selector-wrapper {
    max-width: 500px;
    margin: 0 auto 3rem;
  }

  .featured-collection-selector-{{ section.id }} .model-dropdown {
    position: relative;
    width: 100%;
  }

  .featured-collection-selector-{{ section.id }} .dropdown-button {
    width: 100%;
    padding: 1rem 1.5rem;
    border: 2px solid rgba(var(--color-foreground), 0.2);
    background: rgb(var(--color-background));
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
    font-size: inherit;
    font-family: inherit;
    color: inherit;
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-align: left;
  }

  .featured-collection-selector-{{ section.id }} .dropdown-button:hover {
    border-color: rgba(var(--color-foreground), 0.4);
  }

  .featured-collection-selector-{{ section.id }} .dropdown-button.open {
    border-color: rgb(var(--color-foreground));
  }

  .featured-collection-selector-{{ section.id }} .dropdown-arrow {
    transition: transform 0.2s ease;
    display: flex;
    align-items: center;
  }

  .featured-collection-selector-{{ section.id }} .dropdown-button.open .dropdown-arrow {
    transform: rotate(180deg);
  }

  .featured-collection-selector-{{ section.id }} .dropdown-menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    right: 0;
    background: rgb(var(--color-background));
    border: 2px solid rgba(var(--color-foreground), 0.2);
    border-radius: 8px;
    max-height: 400px;
    overflow-y: auto;
    z-index: 100;
    display: none;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
  }

  .featured-collection-selector-{{ section.id }} .dropdown-menu.open {
    display: block;
  }

  .featured-collection-selector-{{ section.id }} .dropdown-item {
    padding: 1rem 1.5rem;
    cursor: pointer;
    transition: background 0.2s ease;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.1);
  }

  .featured-collection-selector-{{ section.id }} .dropdown-item:last-child {
    border-bottom: none;
  }

  .featured-collection-selector-{{ section.id }} .dropdown-item:hover {
    background: rgba(var(--color-foreground), 0.05);
  }

  .featured-collection-selector-{{ section.id }} .dropdown-item.active {
    background: rgba(var(--color-foreground), 0.1);
    font-weight: 600;
  }

  .featured-collection-selector-{{ section.id }} .collection-content {
    display: none;
  }

  .featured-collection-selector-{{ section.id }} .collection-content.active {
    display: block;
  }

  .featured-collection-selector-{{ section.id }} .collection-header {
    margin-bottom: 2rem;
    text-align: {{ section.settings.heading_alignment }};
  }

  .featured-collection-selector-{{ section.id }} .collection-title {
    margin: 0 0 0.5rem;
  }

  .featured-collection-selector-{{ section.id }} .collection-description {
    margin: 0;
    opacity: 0.7;
  }

  .featured-collection-selector-{{ section.id }} .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 2rem;
  }

  @media (max-width: 749px) {
    .featured-collection-selector-{{ section.id }} .products-grid {
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 1.25rem;
    }
  }

  @media (max-width: 490px) {
    .featured-collection-selector-{{ section.id }} .products-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }

  .featured-collection-selector-{{ section.id }} .product-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .featured-collection-selector-{{ section.id }} .product-card-link {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease;
  }

  .featured-collection-selector-{{ section.id }} .product-card-link:hover {
    transform: translateY(-4px);
  }

  .featured-collection-selector-{{ section.id }} .product-image-wrapper {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    border-radius: 8px;
    background: rgba(var(--color-foreground), 0.04);
  }

  .featured-collection-selector-{{ section.id }} .product-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .featured-collection-selector-{{ section.id }} .product-card-link:hover .product-image {
    transform: scale(1.08);
  }

  .featured-collection-selector-{{ section.id }} .product-info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .featured-collection-selector-{{ section.id }} .product-title {
    margin: 0;
  }

  .featured-collection-selector-{{ section.id }} .product-price {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .featured-collection-selector-{{ section.id }} .price-compare {
    text-decoration: line-through;
    opacity: 0.6;
  }

  .featured-collection-selector-{{ section.id }} .no-products {
    text-align: center;
    padding: 4rem 1rem;
    opacity: 0.6;
    grid-column: 1 / -1;
  }

  .featured-collection-selector-{{ section.id }} .view-all-wrapper {
    text-align: {{ section.settings.heading_alignment }};
    margin-top: 3rem;
  }

  .featured-collection-selector-{{ section.id }} .view-all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 2rem;
    border: 2px solid rgba(var(--color-foreground), 0.2);
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .featured-collection-selector-{{ section.id }} .view-all-link:hover {
    background: rgba(var(--color-foreground), 0.05);
    border-color: rgba(var(--color-foreground), 0.4);
  }

{% endstyle %}

<div class="featured-collection-selector-{{ section.id }} page-width">
  {% if section.settings.heading != blank or section.settings.subheading != blank %}
    <div class="section-header">
      {% if section.settings.heading != blank %}
        <h2 class="section-title h1">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <div class="section-subtitle rte">{{ section.settings.subheading }}</div>
      {% endif %}
    </div>
  {% endif %}

  {% assign has_collections = false %}
  {% if section.settings.collections.size > 0 %}
    {% assign has_collections = true %}
  {% endif %}

  {% if has_collections %}
    <div class="model-selector-wrapper">
      <div class="model-dropdown">
        <button class="dropdown-button" type="button" aria-expanded="false">
          <span class="dropdown-text">{{ section.settings.dropdown_placeholder }}</span>
          <span class="dropdown-arrow">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </button>
        <div class="dropdown-menu">
          {% for collection in section.settings.collections %}
            <div class="dropdown-item{% if forloop.first %} active{% endif %}" data-collection-handle="{{ collection.handle }}">
              {{ collection.title }}
            </div>
          {% endfor %}
        </div>
      </div>
    </div>

    {% for collection in section.settings.collections %}
      <div class="collection-content{% if forloop.first %} active{% endif %}" data-collection="{{ collection.handle }}">
          {% if section.settings.show_collection_info %}
            <div class="collection-header">
              <h3 class="collection-title h2">{{ collection.title }}</h3>
              {% if collection.description != blank %}
                <div class="collection-description rte">{{ collection.description | strip_html | truncate: 200 }}</div>
              {% endif %}
            </div>
          {% endif %}

          {% if collection.products.size > 0 %}
            <div class="products-grid">
              {% for product in collection.products limit: section.settings.products_to_show %}
                <div class="product-card">
                  <a href="{{ product.url }}" class="product-card-link">
                    <div class="product-image-wrapper">
                      {% if product.featured_image %}
                        <img
                          srcset="
                            {%- if product.featured_image.width >= 165 -%}{{ product.featured_image | image_url: width: 165 }} 165w,{%- endif -%}
                            {%- if product.featured_image.width >= 330 -%}{{ product.featured_image | image_url: width: 330 }} 330w,{%- endif -%}
                            {%- if product.featured_image.width >= 535 -%}{{ product.featured_image | image_url: width: 535 }} 535w,{%- endif -%}
                            {%- if product.featured_image.width >= 750 -%}{{ product.featured_image | image_url: width: 750 }} 750w,{%- endif -%}
                            {%- if product.featured_image.width >= 1000 -%}{{ product.featured_image | image_url: width: 1000 }} 1000w,{%- endif -%}
                            {{ product.featured_image | image_url }} {{ product.featured_image.width }}w"
                          src="{{ product.featured_image | image_url: width: 535 }}"
                          sizes="(min-width: 990px) calc((100vw - 10rem) / 4), (min-width: 750px) calc((100vw - 8rem) / 3), calc(50vw - 3rem)"
                          alt="{{ product.featured_image.alt | escape }}"
                          class="product-image"
                          loading="lazy"
                          width="{{ product.featured_image.width }}"
                          height="{{ product.featured_image.height }}"
                        >
                      {% else %}
                        {{ 'product-1' | placeholder_svg_tag: 'product-image' }}
                      {% endif %}
                    </div>

                    <div class="product-info">
                      <h4 class="product-title h5">{{ product.title }}</h4>

                      <div class="product-price">
                        <span class="price">{{ product.price | money }}</span>
                        {% if product.compare_at_price > product.price %}
                          <span class="price-compare">{{ product.compare_at_price | money }}</span>
                        {% endif %}
                      </div>
                    </div>
                  </a>
                </div>
              {% endfor %}
            </div>

            {% if section.settings.show_view_all and collection.products.size > section.settings.products_to_show %}
              <div class="view-all-wrapper">
                <a href="{{ collection.url }}" class="view-all-link button button--secondary">
                  {{ section.settings.view_all_text }}
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M6.75 4.5L11.25 9L6.75 13.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              </div>
            {% endif %}
          {% else %}
            <div class="products-grid">
              <div class="no-products">
                <p class="h4">{{ section.settings.no_products_text }}</p>
              </div>
            </div>
          {% endif %}
      </div>
    {% endfor %}
  {% else %}
    <div class="no-products">
      <p class="h4">{{ section.settings.no_collections_text }}</p>
    </div>
  {% endif %}

</div>

<script>
  (function() {
    const sectionId = '{{ section.id }}';
    const container = document.querySelector('.featured-collection-selector-' + sectionId);

    if (!container) return;

    const dropdownButton = container.querySelector('.dropdown-button');
    const dropdownMenu = container.querySelector('.dropdown-menu');
    const dropdownText = container.querySelector('.dropdown-text');
    const dropdownItems = container.querySelectorAll('.dropdown-item');
    const collectionContents = container.querySelectorAll('.collection-content');

    if (!dropdownButton || !dropdownMenu) return;

    dropdownButton.addEventListener('click', function(e) {
      e.stopPropagation();
      const isOpen = dropdownMenu.classList.contains('open');
      dropdownButton.classList.toggle('open', !isOpen);
      dropdownMenu.classList.toggle('open', !isOpen);
      dropdownButton.setAttribute('aria-expanded', !isOpen);
    });

    document.addEventListener('click', function() {
      dropdownButton.classList.remove('open');
      dropdownMenu.classList.remove('open');
      dropdownButton.setAttribute('aria-expanded', 'false');
    });

    dropdownMenu.addEventListener('click', function(e) {
      e.stopPropagation();
    });

    dropdownItems.forEach(function(item) {
      if (item.classList.contains('active')) {
        dropdownText.textContent = item.textContent;
      }

      item.addEventListener('click', function() {
        const collectionHandle = this.getAttribute('data-collection-handle');

        dropdownItems.forEach(function(i) {
          i.classList.remove('active');
        });
        this.classList.add('active');

        dropdownText.textContent = this.textContent;

        collectionContents.forEach(function(content) {
          content.classList.remove('active');
        });

        const targetContent = container.querySelector('.collection-content[data-collection="' + collectionHandle + '"]');
        if (targetContent) {
          targetContent.classList.add('active');
        }

        dropdownButton.classList.remove('open');
        dropdownMenu.classList.remove('open');
        dropdownButton.setAttribute('aria-expanded', 'false');
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Samling med modellvelger",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "default": "Velg din robotmodell"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Undertekst",
      "default": "<p>Velg robotstøvsugermodellen din for å se alle kompatible deler</p>"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Samlinger",
      "limit": 50
    },
    {
      "type": "text",
      "id": "dropdown_placeholder",
      "label": "Nedtrekksmeny plassholder",
      "default": "Velg en modell"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Overskriftjustering",
      "options": [
        {
          "value": "left",
          "label": "Venstre"
        },
        {
          "value": "center",
          "label": "Sentrert"
        },
        {
          "value": "right",
          "label": "Høyre"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "show_collection_info",
      "label": "Vis samlingstittel og beskrivelse",
      "default": false
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 50,
      "step": 1,
      "label": "Maksimalt antall produkter å vise per modell",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Vis 'Se alle' knapp",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "'Se alle' knappetekst",
      "default": "Se alle produkter"
    },
    {
      "type": "text",
      "id": "no_products_text",
      "label": "Ingen produkter tekst",
      "default": "Ingen produkter funnet i denne samlingen."
    },
    {
      "type": "text",
      "id": "no_collections_text",
      "label": "Ingen samlinger tekst",
      "default": "Vennligst legg til samlinger for å vise."
    },
    {
      "type": "header",
      "content": "Avstander"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin topp",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin bunn",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding topp",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bunn",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Samling med modellvelger"
    }
  ]
}
{% endschema %}
