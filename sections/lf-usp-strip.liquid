<style>
  .lf-usp {
    background: {{ section.settings.bg_color }};
    padding: 42px 0 38px;
    border-bottom: 1px solid rgba(12, 12, 12, 0.05);
  }
  .lf-usp__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
  }
  .lf-usp__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 8px 28px;
    position: relative;
  }
  .lf-usp__item + .lf-usp__item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 18%;
    bottom: 18%;
    width: 1px;
    background: linear-gradient(to bottom, transparent, {{ section.settings.icon_color | color_modify: 'alpha', 0.28 }}, transparent);
  }
  .lf-usp__icon {
    width: 52px;
    height: 52px;
    margin-bottom: 14px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ section.settings.icon_color }};
    background: {{ section.settings.icon_color | color_modify: 'alpha', 0.08 }};
    box-shadow: inset 0 0 0 1px {{ section.settings.icon_color | color_modify: 'alpha', 0.22 }};
    transition: transform 0.28s ease, box-shadow 0.28s ease, background 0.28s ease;
  }
  .lf-usp__item:hover .lf-usp__icon {
    transform: translateY(-3px);
    background: {{ section.settings.icon_color | color_modify: 'alpha', 0.14 }};
    box-shadow: inset 0 0 0 1px {{ section.settings.icon_color | color_modify: 'alpha', 0.4 }}, 0 8px 18px rgba(12, 12, 12, 0.06);
  }
  .lf-usp__icon svg {
    width: 22px;
    height: 22px;
    display: block;
  }
  .lf-usp__label {
    font-family: var(--font-heading--family), serif;
    font-size: 17px;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: {{ section.settings.heading_color }};
    margin: 0 0 6px;
    line-height: 1.25;
  }
  .lf-usp__sub {
    font-family: var(--font-body--family), sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: {{ section.settings.sub_color }};
    line-height: 1.5;
    max-width: 220px;
    margin: 0;
  }
  @media (max-width: 989px) {
    .lf-usp { padding: 32px 0 28px; }
    .lf-usp__inner { padding: 0 16px; grid-template-columns: 1fr 1fr; gap: 8px 0; }
    .lf-usp__item { padding: 18px 16px; }
    .lf-usp__item + .lf-usp__item::before { display: none; }
    .lf-usp__item:nth-child(even) { border-left: 1px solid rgba(12, 12, 12, 0.06); }
    .lf-usp__item:nth-child(n + 3) { border-top: 1px solid rgba(12, 12, 12, 0.06); }
    .lf-usp__icon { width: 46px; height: 46px; margin-bottom: 10px; }
    .lf-usp__label { font-size: 15px; }
    .lf-usp__sub { font-size: 12px; }
  }
</style>

<section class="lf-usp" aria-label="Why shop with us">
  <div class="lf-usp__inner">
    <div class="lf-usp__item">
      <div class="lf-usp__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="1.5"/><path d="M16 8h4l3 5v4h-7V8z"/><circle cx="5.5" cy="18.5" r="2.2"/><circle cx="18.5" cy="18.5" r="2.2"/></svg>
      </div>
      <h3 class="lf-usp__label">{{ section.settings.usp1_label | default: 'Free UK Delivery' }}</h3>
      <p class="lf-usp__sub">{{ section.settings.usp1_sub | default: 'On all orders over £400' }}</p>
    </div>

    <div class="lf-usp__item">
      <div class="lf-usp__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
      </div>
      <h3 class="lf-usp__label">{{ section.settings.usp2_label | default: '100% Authentic' }}</h3>
      <p class="lf-usp__sub">{{ section.settings.usp2_sub | default: 'Genuine products, direct from brands' }}</p>
    </div>

    <div class="lf-usp__item">
      <div class="lf-usp__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.6"/><path d="M5.5 20v-1.2A4.3 4.3 0 0 1 9.8 14.5h4.4A4.3 4.3 0 0 1 18.5 18.8V20"/><path d="M18.2 8.2c.9.3 1.5 1.1 1.5 2.1s-.6 1.8-1.5 2.1"/></svg>
      </div>
      <h3 class="lf-usp__label">{{ section.settings.usp3_label | default: 'Expert Advice' }}</h3>
      <p class="lf-usp__sub">{{ section.settings.usp3_sub | default: 'Free personal consultation service' }}</p>
    </div>

    <div class="lf-usp__item">
      <div class="lf-usp__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><polyline points="3 4 3 9 8 9"/></svg>
      </div>
      <h3 class="lf-usp__label">{{ section.settings.usp4_label | default: 'Easy Returns' }}</h3>
      <p class="lf-usp__sub">{{ section.settings.usp4_sub | default: '30-day hassle-free returns' }}</p>
    </div>
  </div>
</section>

