{% comment %}
  THE SKIN BAY — LUXURY FOOTER (brand-matched: Playfair Display + Lato, black & cream)
{% endcomment %}

{% style %}
  :root {
    --lux-bg: {{ section.settings.bg_color }};
    --lux-text: {{ section.settings.text_color }};
    --lux-accent: {{ section.settings.accent_color }};
    --lux-cream: #efe7d8;
    --lux-line: rgba(239,231,216,0.16);
    --lux-muted: rgba(239,231,216,0.62);
    --lux-head: var(--font-heading--family), serif;
    --lux-body: var(--font-body--family), sans-serif;
  }

  .lux-footer-wrapper {
    background-color: var(--lux-bg);
    color: var(--lux-cream);
    font-family: var(--lux-body);
    padding: 0 0 34px 0;
    border-top: 1px solid var(--lux-line);
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
  }
  .lux-footer-container { max-width: 1440px; margin: 0 auto; padding: 0 48px; }
  .lux-brand-banner { text-align: center; padding: 4px 20px 34px; }
  .lux-brand-banner img { display: block; width: min(380px, 74vw); height: auto; margin: 0 auto; opacity: .96; }

  /* TRUST BAR */
  .lux-trust-bar {
    display: flex; justify-content: center; gap: 64px; flex-wrap: wrap;
    padding: 26px 48px;
    border-bottom: 1px solid var(--lux-line);
    margin-bottom: 60px;
  }
  .lux-trust-item { display: flex; align-items: center; gap: 12px; }
  .lux-trust-icon { width: 22px; height: 22px; }
  .lux-trust-icon path { fill: var(--lux-accent); }
  .lux-trust-text {
    font-family: var(--lux-body); font-size: 12px; font-weight: 600;
    letter-spacing: 1.6px; text-transform: uppercase; color: var(--lux-cream);
  }

  /* TOP */
  .lux-footer-top {
    display: flex; justify-content: space-between; align-items: flex-start;
    margin-bottom: 56px; padding-bottom: 46px; border-bottom: 1px solid var(--lux-line);
    flex-wrap: wrap; gap: 50px;
  }
  .lux-footer-brand { flex: 1; min-width: 300px; max-width: 460px; }
  .lux-logo-link { text-decoration: none; display: inline-block; margin-bottom: 22px; }
  .lux-footer-logo-svg, .lux-footer-logo-img { width: {{ section.settings.logo_width }}px; height: auto; display: block; }
  .lux-brand-bio { font-family: var(--lux-body); font-size: 15px; color: var(--lux-muted); margin: 0; line-height: 1.75; font-weight: 400; }

  .lux-newsletter-col { flex: 1; min-width: 300px; display: flex; flex-direction: column; align-items: flex-end; text-align: right; }
  .lux-social-row { display: flex; gap: 14px; margin-bottom: 28px; }
  .lux-social-link {
    display: flex; align-items: center; justify-content: center; width: 42px; height: 42px;
    border: 1px solid var(--lux-line); border-radius: 50%; transition: all .3s ease;
  }
  .lux-social-link:hover { border-color: var(--lux-accent); background: var(--lux-accent); transform: translateY(-2px); }
  .lux-social-icon { width: 19px; height: 19px; }
  .lux-social-icon path { fill: var(--lux-cream); }
  .lux-social-link:hover .lux-social-icon path { fill: var(--lux-bg); }

  .lux-newsletter-col h4 {
    font-family: var(--lux-head); font-size: 22px; margin: 0 0 6px 0; color: var(--lux-cream); font-weight: 500; letter-spacing: .3px;
  }
  .lux-news-sub { font-family: var(--lux-body); font-size: 13px; color: var(--lux-muted); margin: 0 0 16px 0; letter-spacing: .3px; }
  .lux-input-group { display: flex; border-bottom: 1px solid var(--lux-muted); padding-bottom: 9px; width: 100%; max-width: 360px; }
  .lux-input-group:focus-within { border-bottom-color: var(--lux-accent); }
  .lux-input {
    background: transparent; border: none; color: var(--lux-cream); padding: 5px 0; width: 100%; outline: none;
    font-family: var(--lux-body); font-size: 14px; text-align: right; font-weight: 400; letter-spacing: .3px;
  }
  .lux-input::placeholder { color: var(--lux-muted); font-size: 12px; letter-spacing: 1.4px; text-transform: uppercase; text-align: right; }
  .lux-submit {
    background: transparent; border: none; color: var(--lux-accent); text-transform: uppercase;
    font-size: 12px; letter-spacing: 1.6px; cursor: pointer; padding: 0 0 0 22px; font-weight: 700;
  }
  .lux-submit:hover { color: var(--lux-cream); }

  /* LINK COLUMNS */
  .lux-links-grid { display: grid; gap: 40px; margin-bottom: 58px; }
  .lux-col h3 {
    font-family: var(--lux-head); font-size: 17px; margin: 0 0 22px 0; color: var(--lux-cream);
    letter-spacing: .4px; font-weight: 500;
  }
  .lux-col ul { list-style: none; padding: 0; margin: 0; }
  .lux-col li { margin-bottom: 13px; }
  .lux-col a {
    text-decoration: none; color: var(--lux-muted); font-family: var(--lux-body); font-size: 12.5px;
    font-weight: 500; letter-spacing: 1.1px; text-transform: uppercase;
    transition: color .25s ease, padding .25s ease; display: inline-block;
  }
  .lux-col a:hover { color: var(--lux-cream); padding-left: 4px; }

  /* CONTACT COLUMN */
  .lux-contact-list { list-style: none; padding: 0; margin: 0; }
  .lux-contact-item { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 20px; }
  .lux-contact-item svg { width: 17px; height: 17px; flex: 0 0 17px; margin-top: 2px; }
  .lux-contact-item svg path { fill: var(--lux-accent); }
  .lux-contact-item .lux-ci-text { font-family: var(--lux-body); font-size: 14px; line-height: 1.55; color: var(--lux-cream); white-space: pre-line; }
  .lux-contact-item .lux-ci-text.muted { color: var(--lux-muted); }
  .lux-contact-link { color: var(--lux-cream) !important; font-size: 14px !important; font-weight: 400 !important; text-transform: none !important; letter-spacing: .3px !important; }
  .lux-contact-link:hover { color: #fff !important; }

  /* BOTTOM */
  .lux-payment-row { display: flex; justify-content: center; gap: 10px; margin-bottom: 26px; flex-wrap: wrap; }
  .lux-payment-icon { width: 40px; height: 25px; background: #fff; border-radius: 4px; padding: 3px; }
  .lux-footer-bottom { padding-top: 28px; border-top: 1px solid var(--lux-line); }
  .lux-bottom-row {
    display: flex; justify-content: space-between; align-items: center; gap: 18px; flex-wrap: wrap;
    font-family: var(--lux-body); font-size: 11px; color: var(--lux-muted);
    text-transform: uppercase; letter-spacing: 1.4px;
  }
  .lux-bottom-note { color: var(--lux-muted); }

  @media (max-width: 1024px) { .lux-links-grid { grid-template-columns: repeat(2, 1fr) !important; } }

  @media (max-width: 749px) {
    .lux-footer-container { padding: 0 24px; }
    .lux-trust-bar { flex-direction: column; gap: 18px; align-items: flex-start; padding: 22px 24px; margin-bottom: 40px; }
    .lux-footer-top { flex-direction: column; align-items: center; text-align: center; gap: 34px; }
    .lux-footer-brand, .lux-newsletter-col { width: 100%; align-items: center; text-align: center; }
    .lux-input-group { max-width: 100%; }
    .lux-input, .lux-input::placeholder { text-align: center; }
    .lux-links-grid { display: flex; flex-direction: column; gap: 0; margin-bottom: 26px; width: 100%; }
    .lux-col { width: 100%; border-bottom: 1px solid var(--lux-line); }
    .lux-col h3 { margin: 0; padding: 20px 0; cursor: pointer; display: flex; justify-content: space-between; align-items: center; font-size: 16px; }
    .lux-col h3::after { content: '+'; font-size: 20px; color: var(--lux-accent); font-weight: 300; }
    .lux-col.active h3::after { content: '\2013'; }
    .lux-col ul { max-height: 0; overflow: hidden; transition: max-height .4s ease, opacity .4s ease; opacity: 0; text-align: left; }
    .lux-col.active ul { max-height: 600px; opacity: 1; padding-bottom: 18px; }
    .lux-col a { padding: 8px 0; font-size: 15px; }
    .lux-bottom-row { flex-direction: column; gap: 12px; text-align: center; }
  }
{% endstyle %}

<div class="lux-footer-wrapper">

  {% if section.settings.show_trust_bar %}
  <div class="lux-trust-bar">
    <div class="lux-trust-item">
      <svg class="lux-trust-icon" viewBox="0 0 24 24"><path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/></svg>
      <span class="lux-trust-text">{{ section.settings.trust_1_text }}</span>
    </div>
    <div class="lux-trust-item">
      <svg class="lux-trust-icon" viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
      <span class="lux-trust-text">{{ section.settings.trust_2_text }}</span>
    </div>
    <div class="lux-trust-item">
      <svg class="lux-trust-icon" viewBox="0 0 24 24"><path d="M12.5 8H11v6l4.75 2.85.75-1.23-4-2.37V8zM12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/></svg>
      <span class="lux-trust-text">{{ section.settings.trust_3_text }}</span>
    </div>
  </div>
  {% endif %}

  <div class="lux-footer-container">
    <div class="lux-footer-top">
      <div class="lux-footer-brand">
        <a href="{{ section.settings.logo_url | default: routes.root_url }}" class="lux-logo-link">
          {% if section.settings.svg_logo_code != blank %}
            <div class="lux-footer-logo-svg">{{ section.settings.svg_logo_code }}</div>
          {% elsif section.settings.image_logo != blank %}
            <img src="{{ section.settings.image_logo | image_url: width: 600 }}" alt="{{ shop.name }}" class="lux-footer-logo-img" loading="lazy"
                 onerror="this.onerror=null;this.src='{{ 'arvenixo-logo-lockup-dark.png' | asset_url }}';">
          {% else %}
            <img src="{{ 'arvenixo-logo-lockup-dark.png' | asset_url }}" alt="{{ shop.name }}" class="lux-footer-logo-img" loading="lazy">
          {% endif %}
        </a>
        <div class="lux-brand-bio">{{ section.settings.brand_bio }}</div>
      </div>

      <div class="lux-newsletter-col">
        <div class="lux-social-row">
          {% if section.settings.social_instagram != blank %}<a href="{{ section.settings.social_instagram }}" target="_blank" rel="noopener" class="lux-social-link" aria-label="Instagram"><svg class="lux-social-icon" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg></a>{% endif %}
          {% if section.settings.social_tiktok != blank %}<a href="{{ section.settings.social_tiktok }}" target="_blank" rel="noopener" class="lux-social-link" aria-label="TikTok"><svg class="lux-social-icon" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 1 0-1 13.6 6.84 6.84 0 0 0 6.82-6.85V8.89a7.3 7.3 0 0 0 3.3 1.14V6.62a3.92 3.92 0 0 1 .11.07z"/></svg></a>{% endif %}
          {% if section.settings.social_facebook != blank %}<a href="{{ section.settings.social_facebook }}" target="_blank" rel="noopener" class="lux-social-link" aria-label="Facebook"><svg class="lux-social-icon" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg></a>{% endif %}
          {% if section.settings.social_youtube != blank %}<a href="{{ section.settings.social_youtube }}" target="_blank" rel="noopener" class="lux-social-link" aria-label="YouTube"><svg class="lux-social-icon" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg></a>{% endif %}
          {% if section.settings.social_twitter != blank %}<a href="{{ section.settings.social_twitter }}" target="_blank" rel="noopener" class="lux-social-link" aria-label="X"><svg class="lux-social-icon" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>{% endif %}
        </div>

        <h4>{{ section.settings.newsletter_title }}</h4>
        {% if section.settings.newsletter_subtitle != blank %}<p class="lux-news-sub">{{ section.settings.newsletter_subtitle }}</p>{% endif %}
        {% form 'customer', id: 'lux-footer-newsletter' %}
          <input type="hidden" name="form_type" value="customer">
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="lux-input-group">
            <input type="email" name="contact[email]" class="lux-input" placeholder="{{ section.settings.newsletter_placeholder }}" required>
            <button type="submit" class="lux-submit">Join</button>
          </div>
          {% if form.posted_successfully? %}<p style="font-size:13px;color:var(--lux-accent);margin-top:8px;width:100%;">Thank you. You are on the list.</p>{% endif %}
          {% if form.errors %}<p style="font-size:13px;color:#e58a8a;margin-top:8px;width:100%;">{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}</p>{% endif %}
        {% endform %}
      </div>
    </div>

    <div class="lux-links-grid" style="grid-template-columns: repeat({{ section.blocks.size }}, 1fr);">
      {% for block in section.blocks %}
        <div class="lux-col" {{ block.shopify_attributes }}>
          {% if block.type == 'menu_column' %}
            <h3>{{ block.settings.title }}</h3>
            <ul>
              {% if block.settings.menu != blank %}
                {% for link in linklists[block.settings.menu].links %}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {% endfor %}
              {% endif %}
            </ul>
          {% elsif block.type == 'contact_column' %}
            <h3>{{ block.settings.title }}</h3>
            <ul class="lux-contact-list">
              {% if block.settings.pre_email != blank %}
                <li class="lux-contact-item">
                  <svg viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z"/></svg>
                  <span class="lux-ci-text muted">{{ block.settings.pre_email }}</span>
                </li>
              {% endif %}
              {% if block.settings.email != blank %}
                <li class="lux-contact-item">
                  <svg viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
                  <span class="lux-ci-text"><a href="mailto:{{ block.settings.email }}" class="lux-contact-link">{{ block.settings.email }}</a></span>
                </li>
              {% endif %}
              {% if block.settings.phone != blank %}
                <li class="lux-contact-item">
                  <svg viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
                  <span class="lux-ci-text"><a href="tel:{{ block.settings.phone }}" class="lux-contact-link">{{ block.settings.phone }}</a></span>
                </li>
              {% endif %}
              {% if block.settings.hours != blank %}
                <li class="lux-contact-item">
                  <svg viewBox="0 0 24 24"><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm4.2 14.2L11 13V7h1.5v5.2l4.5 2.7-.8 1.3z"/></svg>
                  <span class="lux-ci-text muted">{{ block.settings.hours }}</span>
                </li>
              {% endif %}
            </ul>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    <div class="lux-footer-bottom">
      {% if section.settings.show_payment_icons %}
        <div class="lux-payment-row">
          {% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag: class: 'lux-payment-icon' }}{% endfor %}
        </div>
      {% endif %}
      <div class="lux-bottom-row">
        <div class="lux-copyright">&copy; {{ 'now' | date: "%Y" }} {{ section.settings.copyright_text }}</div>
        <div class="lux-bottom-note">{{ section.settings.bottom_note }}</div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    document.querySelectorAll('.lux-col h3').forEach(function(header){
      header.addEventListener('click', function(){
        if (window.innerWidth <= 749) {
          var parent = this.parentElement;
          document.querySelectorAll('.lux-col').forEach(function(col){ if (col !== parent) col.classList.remove('active'); });
          parent.classList.toggle('active');
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Luxury Footer",
  "settings": [
    { "type": "header", "content": "Trust & Security" },
    { "type": "checkbox", "id": "show_trust_bar", "label": "Show Trust Badge Bar", "default": true },
    { "type": "text", "id": "trust_1_text", "label": "Trust Icon 1 Text", "default": "Fast Shipping" },
    { "type": "text", "id": "trust_2_text", "label": "Trust Icon 2 Text", "default": "Secure Checkout" },
    { "type": "text", "id": "trust_3_text", "label": "Trust Icon 3 Text", "default": "Easy Returns" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show Payment Icons", "info": "Displays payment methods enabled in Shopify settings.", "default": true },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#111111" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#efe7d8" },
    { "type": "color", "id": "accent_color", "label": "Accent (cream)", "default": "#c9b79b" },
    { "type": "header", "content": "Branding" },
    { "type": "textarea", "id": "svg_logo_code", "label": "SVG Logo Code", "info": "Paste full <svg> code. Overrides image." },
    { "type": "image_picker", "id": "image_logo", "label": "Image Logo (Fallback)" },
    { "type": "range", "id": "logo_width", "min": 100, "max": 400, "step": 10, "unit": "px", "label": "Logo Width", "default": 260 },
    { "type": "url", "id": "logo_url", "label": "Logo Link", "info": "Leave blank for homepage" },
    { "type": "richtext", "id": "brand_bio", "label": "Brand Bio", "default": "<p>Precision MagSafe cases and elevated beauty tech — designed for everyday luxury.</p>" },
    { "type": "header", "content": "Social Media" },
    { "type": "text", "id": "social_instagram", "label": "Instagram URL" },
    { "type": "text", "id": "social_tiktok", "label": "TikTok URL" },
    { "type": "text", "id": "social_facebook", "label": "Facebook URL" },
    { "type": "text", "id": "social_youtube", "label": "YouTube URL" },
    { "type": "text", "id": "social_twitter", "label": "X (Twitter) URL" },
