{% style %}
  .custom-info-banner-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  .info-banner-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
    align-items: center;
  }

  @media screen and (min-width: 769px) {
    .info-banner-grid-{{ section.id }} {
      grid-template-columns: 1fr 1fr;
      gap: 0;
    }
  }

  /* Left Column: Quote */
  .info-banner-quote-{{ section.id }} {
    font-family: var(--typeHeaderPrimary), var(--typeHeaderFallback);
    font-size: clamp(24px, 2.5vw, 32px);
    font-weight: 700;
    
    color: #1a1a1a;
    margin: 0;
    text-align: center;
    line-height: 1.2;
  }

  @media screen and (min-width: 769px) {
    .info-banner-quote-{{ section.id }} {
      text-align: right;
      padding-right: 50px;
    }
  }

  /* Right Column: Container for Text + Logo */
  .info-banner-right-col-{{ section.id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 25px;
  }

  @media screen and (min-width: 769px) {
    .info-banner-right-col-{{ section.id }} {
      flex-direction: row;
      justify-content: space-between;
      border-left: 1px solid #1a1a1a;
      padding-left: 50px;
    }
  }

  /* Right Column: Text List */
  .info-banner-text-{{ section.id }} {
    font-family: var(--typeBasePrimary), var(--typeBaseFallback);
    font-size: clamp(14px, 1.2vw, 16px);
    line-height: 1.6;
    color: #333333;
    margin: 0;
    text-align: center;
  }

  @media screen and (min-width: 769px) {
    .info-banner-text-{{ section.id }} {
      text-align: left;
    }
  }

  .info-banner-text-{{ section.id }} p {
    margin: 0;
  }

  /* Right Column: Logo */
  .info-banner-logo-{{ section.id }} {
    display: flex;
    justify-content: center;
    flex-shrink: 0;
  }

  .info-banner-logo-{{ section.id }} img {
    max-width: {{ section.settings.logo_width }}px;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .info-banner-logo-svg {
    width: {{ section.settings.logo_width }}px;
    height: auto;
  }
{% endstyle %}

<div class="custom-info-banner-{{ section.id }}">
  <div class="page-width">
    <div class="info-banner-grid-{{ section.id }}">
      
      <!-- LEFT HALF: Quote -->
      <div class="info-banner-left-col">
        {% if section.settings.quote != blank %}
          <h2 class="info-banner-quote-{{ section.id }}">
            "{{ section.settings.quote | remove: '"' }}"
          </h2>
        {% endif %}
      </div>

      <!-- RIGHT HALF: Divider, Text List, and Logo -->
      <div class="info-banner-right-col-{{ section.id }}">
        
        <div class="info-banner-text-{{ section.id }}">
          {{ section.settings.text }}
        </div>

        <div class="info-banner-logo-{{ section.id }}">
          {% if section.settings.logo != blank %}
            {{ section.settings.logo | image_url: width: 200 | image_tag: loading: 'lazy' }}
          {% else %}
            <!-- Fallback SVG to match your 1:1 B-Corp shape if no image is uploaded -->
            <svg class="info-banner-logo-svg" viewBox="0 0 100 120" fill="none" xmlns="http://www.w3.org/2000/svg">
              <text x="50" y="20" font-family="Arial" font-size="12" font-weight="bold" text-anchor="middle" fill="#000">Certified</text>
              <circle cx="50" cy="65" r="30" stroke="#000" stroke-width="3"/>
              <text x="50" y="78" font-family="Arial" font-size="36" font-weight="bold" text-anchor="middle" fill="#000">B</text>
              <text x="50" y="115" font-family="Arial" font-size="10" font-weight="bold" text-anchor="middle" fill="#000">Corporation</text>
            </svg>
          {% endif %}
        </div>

      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom Info Banner",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f6f5f3"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote Text",
      "default": "A passion for Good Design & Quality Products"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "List Text",
      "default": "<p>Tech Accessories Reimagined<br>Designed in Paris<br>Delivering only USA</p>"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Certification Logo",
      "info": "Leave blank to use the default B-Corp placeholder"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 40,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Logo Max Width",
      "default": 65
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Custom Info Banner"
    }
  ]
}
{% endschema %}