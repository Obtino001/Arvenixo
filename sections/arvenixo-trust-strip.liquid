<section id="ArvenixoTrust-{{ section.id }}" class="ax-trust-strip">
  <div class="page-width">
    <ul class="ax-trust-strip__list">
      {%- for block in section.blocks -%}
        <li class="ax-trust-strip__item" {{ block.shopify_attributes }}>
          <span class="ax-trust-strip__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'truck' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 7h11v10H3z"/><path d="M14 10h4l3 3v4h-7V10z"/><circle cx="7" cy="18" r="1.5"/><circle cx="17" cy="18" r="1.5"/></svg>
              {%- when 'shield' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z"/><path d="M9 12l2 2 4-4"/></svg>
              {%- when 'return' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 7H5v4"/><path d="M5 11a7 7 0 1 0 2-4.9"/><path d="M12 8v5l3 2"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18"/></svg>
            {%- endcase -%}
          </span>
          <div>
            <p class="ax-trust-strip__title">{{ block.settings.title }}</p>
            {%- if block.settings.text != blank -%}
              <p class="ax-trust-strip__text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Arvenixo Trust Strip",
  "tag": "section",
  "class": "section-arvenixo-trust",
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Shipping" },
            { "value": "shield", "label": "Secure" },
            { "value": "return", "label": "Returns" },
            { "value": "card", "label": "Payment" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Free standard shipping" },
        { "type": "text", "id": "text", "label": "Text", "default": "On every order · arrives in 7–10 business days" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Arvenixo Trust Strip",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "title": "Free standard shipping", "text": "On every order · 7–10 business days" } },
        { "type": "item", "settings": { "icon": "shield", "title": "Secure checkout", "text": "Encrypted payments · Shop Pay ready" } },
        { "type": "item", "settings": { "icon": "return", "title": "30-day returns", "text": "Clear policy · support@arvenixo.com" } },
        { "type": "item", "settings": { "icon": "card", "title": "Order tracking", "text": "Tracking emailed when your order ships" } }
      ]
    }
  ]
}
{% endschema %}
