{
  "sections": {
    "ax_hero": {
      "type": "arvenixo-hero",
      "settings": {
        "eyebrow": "ARVENIXO",
        "heading": "Elevate everyday",
        "text": "Premium MagSafe cases and beauty tech designed for modern living. Free standard shipping on every order.",
        "button_label": "Shop bestsellers",
        "button_link": "shopify://collections/all",
        "button_label_2": "Shop phone cases",
        "button_link_2": "shopify://collections/all",
        "min_height": 85,
        "overlay_opacity": 45,
        "color_scheme": "scheme-1"
      }
    },
    "ax_trust": {
      "type": "arvenixo-trust-strip",
      "blocks": {
        "t1": {
          "type": "item",
          "settings": {
            "icon": "truck",
            "title": "Free standard shipping",
            "text": "On every order · arrives in 7–10 business days"
          }
        },
        "t2": {
          "type": "item",
          "settings": {
            "icon": "shield",
            "title": "Secure checkout",
            "text": "Encrypted payments · Shop Pay ready"
          }
        },
        "t3": {
          "type": "item",
          "settings": {
            "icon": "return",
            "title": "30-day returns",
            "text": "Clear policy · support@arvenixo.com"
          }
        },
        "t4": {
          "type": "item",
          "settings": {
            "icon": "card",
            "title": "Order tracking",
            "text": "Tracking emailed when your order ships"
          }
        }
      },
      "block_order": [
        "t1",
        "t2",
        "t3",
        "t4"
      ],
      "settings": {
        "color_scheme": "scheme-5"
      }
    },
    "ax_categories": {
      "type": "arvenixo-categories",
      "blocks": {
        "c1": {
          "type": "category",
          "settings": {
            "title": "Phone Cases",
            "text": "MagSafe-ready protection with everyday style.",
            "cta": "Shop cases",
            "link": "shopify://collections/all"
          }
        },
        "c2": {
          "type": "category",
          "settings": {
            "title": "Beauty Tech",
            "text": "At-home LED and facial care devices.",
            "cta": "Shop beauty",
            "link": "shopify://collections/all"
          }
        },
        "c3": {
          "type": "category",
          "settings": {
            "title": "Smart Tech",
            "text": "Cameras, gimbals, and everyday gadgets.",
            "cta": "Shop tech",
            "link": "shopify://collections/all"
          }
        }
      },
      "block_order": [
        "c1",
        "c2",
        "c3"
      ],
      "settings": {
        "heading": "Shop by category",
        "subheading": "Focused essentials for everyday life — cases, beauty tech, and smart gadgets.",
        "color_scheme": "scheme-1",
        "padding_top": 56,
        "padding_bottom": 56
      }
    },
    "ax_bestsellers_header": {
      "type": "custom-header",
      "blocks": {
        "content": {
          "type": "_product-list-content",
          "settings": {
            "content_direction": "row",
            "vertical_on_mobile": true,
            "horizontal_alignment": "space-between",
            "vertical_alignment": "center",
            "horizontal_alignment_flex_direction_column": "flex-start",
            "vertical_alignment_flex_direction_column": "flex-start",
            "gap": 12,
            "width": "fill",
            "padding-block-start": 48,
            "padding-block-end": 12
          },
          "blocks": {
            "title": {
              "type": "_product-list-text",
              "settings": {
                "text": "<h3>Bestsellers</h3>",
                "width": "fit-content",
                "type_preset": "h3",
                "color": "var(--color-foreground-heading)"
              }
            },
            "link": {
              "type": "_product-list-button",
              "settings": {
                "label": "View all",
                "style_class": "cc-link",
                "url": "shopify://collections/all"
              }
            }
          },
          "block_order": [
            "title",
            "link"
          ]
        }
      },
      "block_order": [
        "content"
      ],
      "settings": {}
    },
    "ax_bestsellers": {
      "type": "featured-collection",
      "blocks": {
        "static-product-card": {
          "type": "_product-card",
          "static": true,
          "settings": {
            "product_card_gap": 0,
            "inherit_color_scheme": true,
            "border": "none",
            "border_radius": 0
          },
          "blocks": {
            "gallery": {
              "type": "_product-card-gallery",
              "settings": {
                "image_ratio": "square",
                "border": "none",
                "border_radius": 8
              }
            },
            "title": {
              "type": "product-title",
              "settings": {
                "type_preset": "custom",
                "font": "var(--font-heading--family)",
                "font_size": "1rem",
                "color": "var(--color-foreground-heading)"
              }
            },
            "price": {
              "type": "price",
              "settings": {
                "show_sale_price_first": true,
                "type_preset": "h6",
                "width": "100%",
                "alignment": "left"
              }
            },
            "buy": {
              "type": "buy-buttons",
              "settings": {
                "stacking": false,
                "show_pickup_availability": false
              },
              "blocks": {
                "quantity": {
                  "type": "quantity",
                  "disabled": true,
                  "static": true,
                  "settings": {}
                },
                "add-to-cart": {
                  "type": "add-to-cart",
                  "static": true,
                  "settings": {
                    "style_class": "button"
                  }
                },
                "accelerated-checkout": {
                  "type": "accelerated-checkout",
                  "disabled": true,
                  "static": true,
                  "settings": {}
                }
              },
              "block_order": []
            }
          },
          "block_order": [
            "gallery",
            "title",
            "price",
            "buy"
          ]
        }
      },
      "settings": {
        "collection": "all",
        "enable_autoplay": false,
        "desktop_slides": 4,
        "desktop_spacing": 16,
        "desktop_arrows": true,
        "desktop_progress_bar": false,
        "tablet_slides": 3,
        "mobile_slides": 1.6,
        "mobile_spacing": 12,
        "mobile_arrows": true,
        "mobile_progress_bar": false
      }
    },
    "ax_story": {
      "type": "section",
      "blocks": {
        "copy": {
          "type": "group",
          "settings": {
            "content_direction": "column",
            "gap": 14,
            "width": "custom",
            "custom_width": 100,
            "vertical_alignment": "center"
          },
          "blocks": {
            "h": {
              "type": "text",
              "settings": {
                "text": "<p>Designed for modern living</p>",
                "type_preset": "h3",
                "width": "fit-content",
                "max_width": "narrow"
              }
            },
            "p": {
              "type": "text",
              "settings": {
                "text": "<p>Arvenixo selects practical essentials that feel premium in daily use — from MagSafe cases with real everyday function to beauty devices that fit a calm home ritual. Every product page is built for clarity: shipping, returns, and support before you buy.</p>",
                "type_preset": "rte",
                "width": "fit-content",
                "max_width": "normal"
              }
            },
            "btn": {
              "type": "button",
              "settings": {
                "label": "About Arvenixo",
                "link": "shopify://pages/about-us",
                "style_class": "button"
              }
            }
          },
          "block_order": [
            "h",
            "p",
            "btn"
          ]
        },
        "img": {
          "type": "image",
          "settings": {
            "image_ratio": "square",
            "width": "fill",
            "border": "none",
            "border_radius": 12
          }
        }
      },
      "block_order": [
        "copy",
        "img"
      ],
      "settings": {
        "content_direction": "row",
        "vertical_on_mobile": true,
        "gap": 32,
        "section_width": "page-width",
        "color_scheme": "scheme-1",
        "padding-block-start": 56,
        "padding-block-end": 56
      }
    },
    "ax_faq": {
      "type": "section",
      "blocks": {
        "heading": {
          "type": "text",
          "settings": {
            "text": "<p>Frequently asked questions</p>",
            "type_preset": "h3",
            "width": "fit-content"
          }
        },
        "accordion": {
          "type": "accordion",
          "settings": {
            "icon": "caret",
            "dividers": true,
            "type_preset": "h5"
          },
          "blocks": {
            "r1": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Do you offer free shipping?",
                "icon": "none"
              },
              "blocks": {
                "t": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes. Arvenixo offers <strong>free standard shipping on all orders</strong>. Estimated delivery is <strong>7–10 business days</strong> after your order ships. You’ll receive tracking by email.</p>",
                    "type_preset": "rte",
                    "width": "100%"
                  }
                }
              },
              "block_order": [
                "t"
              ]
            },
            "r2": {
              "type": "_accordion-row",
              "settings": {
                "heading": "What is your return policy?",
                "icon": "none"
              },
              "blocks": {
                "t": {
                  "type": "text",
                  "settings": {
                    "text": "<p>You have <strong>30 days</strong> after receiving your item to request a return for eligible products in original condition. Opened personal-care/beauty devices may have hygiene restrictions — defective or incorrect items are always covered. Contact <strong>support@arvenixo.com</strong>.</p>",
                    "type_preset": "rte",
                    "width": "100%"
                  }
                }
              },
              "block_order": [
                "t"
              ]
            },
            "r3": {
              "type": "_accordion-row",
              "settings": {
                "heading": "How do I choose the right iPhone case model?",
                "icon": "none"
              },
              "blocks": {
                "t": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Select your exact iPhone model on the product page before adding to cart. If you’re unsure, check Settings → General → About on your phone, or message support and we’ll help.</p>",
                    "type_preset": "rte",
                    "width": "100%"
                  }
                }
              },
              "block_order": [
                "t"
              ]
            },
            "r4": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Are beauty devices returnable?",
                "icon": "none"
              },
              "blocks": {
                "t": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Unopened beauty devices may be returned within 30 days. For hygiene reasons, opened personal-care products generally aren’t eligible unless they arrive damaged, defective, or incorrect.</p>",
                    "type_preset": "rte",
                    "width": "100%"
                  }
                }
              },
              "block_order": [
                "t"
              ]
            },
            "r5": {
              "type": "_accordion-row",
              "settings": {
                "heading": "How can I contact support?",
                "icon": "none"
              },
              "blocks": {
                "t": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Email <strong>support@arvenixo.com</strong> or use the Contact page. We typically reply within 1–2 business days.</p>",
                    "type_preset": "rte",
                    "width": "100%"
                  }
                }
              },
              "block_order": [
                "t"
              ]
            }
          },
          "block_order": [
            "r1",
            "r2",
            "r3",
            "r4",
            "r5"
          ]
        }
      },
      "block_order": [
        "heading",
        "accordion"
      ],
      "settings": {
        "content_direction": "column",
        "gap": 24,
        "section_width": "page-width",
        "color_scheme": "scheme-1",
        "padding-block-start": 48,
        "padding-block-end": 64
      }
    }
  },
  "order": [
    "ax_hero",
    "ax_trust",
    "ax_categories",
    "ax_bestsellers_header",
    "ax_bestsellers",
    "ax_story",
    "ax_faq"
  ]
}