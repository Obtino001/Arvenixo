{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section id="video-caroussel-{{ section.id }}" class="cvt section-{{ section.id }}-padding" style="
  --cvt-bg: {{ section.settings.bg_color }};
  --cvt-slide-width: {{ section.settings.slide_width }}px;
  --cvt-padding-top: 12px;
  --cvt-padding-bottom: 12px;
">
  <div class="cvt__inner">
    {%- if section.settings.heading != blank -%}
      <div class="cvt__heading rte">
        <p>{{ section.settings.heading }}</p>
      </div>
    {%- endif -%}

    <div class="cvt__carousel" data-cvt-carousel="">
      <div class="cvt__track" data-cvt-track="" tabindex="0">
        {%- for block in section.blocks -%}
          <article class="cvt__card" data-cvt-slide="" {{ block.shopify_attributes }}>
            <div class="cvt__media-wrap">
              {%- if block.settings.video != blank -%}
                {{ block.settings.video | video_tag:
                  class: 'cvt__video',
                  controls: true,
                  playsinline: true,
                  preload: 'metadata',
                  loop: true,
                  muted: true,
                  image_size: '800x'
                }}
              {%- elsif block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 800 | image_tag:
                  class: 'cvt__slide-image',
                  loading: 'lazy',
                  sizes: '(max-width: 749px) 60vw, 220px',
                  widths: '220, 440, 800'
                }}
              {%- else -%}
                <div class="cvt__placeholder">
                  {{ 'product-1' | placeholder_svg_tag: 'cvt__placeholder-svg' }}
                </div>
              {%- endif -%}
            </div>
            {%- if block.settings.product_title != blank -%}
              <a href="{{ block.settings.product_link }}" class="cvt__product-bar">
                <span class="cvt__product-bar-title">{{ block.settings.product_title }}</span>
              </a>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>

      <div class="cvt__nav">
        <button type="button" class="cvt__nav-btn" data-cvt-prev="" aria-label="Previous">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M10 12L6 8L10 4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
        <button type="button" class="cvt__nav-btn" data-cvt-next="" aria-label="Next">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M6 4L10 8L6 12" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .cvt {
    background: var(--cvt-bg, #fbf6f0);
    overflow: hidden;
    width: 100%;
  }

  .cvt__inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  @media screen and (min-width: 750px) {
    .cvt__inner {
      padding: 0 40px;
    }
  }

  .cvt__heading {
    text-align: center;
    margin-bottom: 24px;
  }

  .cvt__heading p {
    font-size: 22px;
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.01em;
  }

  @media screen and (min-width: 750px) {
    .cvt__heading p {
      font-size: 28px;
    }
  }

  .cvt__carousel {
    position: relative;
  }

  .cvt__track {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 8px;
  }

  .cvt__track::-webkit-scrollbar {
    display: none;
  }

  .cvt__card {
    flex: 0 0 var(--cvt-slide-width, 220px);
    scroll-snap-align: start;
    scroll-snap-stop: always;
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .cvt__card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0,0,0,0.1);
  }

  @media screen and (max-width: 749px) {
    .cvt__card {
      flex: 0 0 60vw;
    }
  }

  .cvt__media-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    background: #f0f0f0;
  }

  .cvt__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cvt__slide-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cvt__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e8e8e8;
  }

  .cvt__placeholder-svg {
    width: 60%;
    height: auto;
    opacity: 0.4;
  }

  .cvt__product-bar {
    display: block;
    padding: 12px 16px;
    text-decoration: none;
    color: inherit;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-align: center;
    transition: background 0.2s ease;
  }

  .cvt__product-bar:hover {
    background: #f5f5f5;
  }

  .cvt__product-bar-title {
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Nav buttons */
  .cvt__nav {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 20px;
  }

  .cvt__nav-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid #ccc;
    background: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    color: #333;
  }

  .cvt__nav-btn:hover:not(:disabled) {
    background: #000;
    color: #fff;
    border-color: #000;
  }

  .cvt__nav-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }
</style>

<script>
  (function () {
    function initCVT(root) {
      if (!root || root.dataset.cvtInit === 'true') return;
      root.dataset.cvtInit = 'true';

      const track = root.querySelector('[data-cvt-track]');
      const prevBtn = root.querySelector('[data-cvt-prev]');
      const nextBtn = root.querySelector('[data-cvt-next]');
      if (!track) return;

      const slides = track.querySelectorAll('[data-cvt-slide]');
      const videos = track.querySelectorAll('.cvt__video');

      videos.forEach(function (video) {
        video.addEventListener('dblclick', function (e) {
          e.preventDefault();
          e.stopPropagation();
        });
      });

      function getScrollAmount() {
        const first = slides[0];
        if (!first) return track.clientWidth * 0.8;
        const style = getComputedStyle(track);
        const gap = parseFloat(style.columnGap || style.gap) || 16;
        return first.offsetWidth + gap;
      }

      function updateNav() {
        if (!prevBtn || !nextBtn) return;
        var maxScroll = track.scrollWidth - track.clientWidth - 2;
        prevBtn.disabled = track.scrollLeft <= 2;
        nextBtn.disabled = track.scrollLeft >= maxScroll;
      }

      function scrollByDir(dir) {
        track.scrollBy({ left: dir * getScrollAmount(), behavior: 'smooth' });
      }

      if (prevBtn) prevBtn.addEventListener('click', function () { scrollByDir(-1); });
      if (nextBtn) nextBtn.addEventListener('click', function () { scrollByDir(1); });

      track.addEventListener('scroll', updateNav, { passive: true });
      window.addEventListener('resize', updateNav);
      updateNav();
    }

    function initAll(scope) {
      (scope || document).querySelectorAll('[data-cvt-carousel]').forEach(initCVT);
    }

    document.addEventListener('DOMContentLoaded', function () { initAll(); });
    document.addEventListener('shopify:section:load', function (e) { initAll(e.target); });
  })();
</script>

{% schema %}
{
  "name": "Video Carousel",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Reviews & Unboxings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fbf6f0"
    },
    {
      "type": "range",
      "id": "slide_width",
      "min": 160,
      "max": 320,
      "step": 10,
      "unit": "px",
      "label": "Slide Width (Desktop)",
      "default": 220
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Upload a video. If both video and image are set, video takes priority."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Fallback if no video is provided."
        },
        {
          "type": "text",
          "id": "product_title",
          "label": "Product Title",
          "default": "Product Name"
        },
        {
          "type": "url",
          "id": "product_link",
          "label": "Product Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video Carousel",
      "blocks": [
        { "type": "slide", "settings": { "product_title": "Original Leather Case" } },
        { "type": "slide", "settings": { "product_title": "Reserve Trackable Bifold" } },
        { "type": "slide", "settings": { "product_title": "Trackable Keychain" } },
        { "type": "slide", "settings": { "product_title": "Leather iPad Case" } }
      ]
    }
  ]
}
{% endschema %}
