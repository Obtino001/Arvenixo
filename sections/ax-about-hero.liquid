<section class="ax-about-hero">
  <div class="ax-about-hero__media" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', alt: '' }}
    {%- else -%}
      <img src="{{ 'ax-about-hero.png' | asset_url }}" alt="" width="1920" height="1080" loading="eager" fetchpriority="high">
    {%- endif -%}
  </div>
  <div class="ax-about-hero__overlay"></div>
  <div class="ax-about-hero__copy">
    {%- if section.settings.kicker != blank -%}
      <p>{{ section.settings.kicker }}</p>
    {%- endif -%}
    <h1>{{ section.settings.heading }}</h1>
  </div>
</section>

{% schema %}
{
  "name": "AX About hero",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Arvenixo" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our story" }
  ],
  "presets": [{ "name": "AX About hero" }]
}
{% endschema %}
