{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = page.title | default: shop.name
  endif
  assign phone = section.settings.phone | default: shop.phone
  assign email = section.settings.email | default: shop.email
  assign form_id = 'ContactForm-' | append: section.id
-%}

<section class="ax-contact">
  <div class="ax-wrap">
    {%- if heading != blank -%}
      <h1 class="ax-contact__heading">{{ heading }}</h1>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <p class="ax-contact__intro">{{ section.settings.intro }}</p>
    {%- endif -%}

    <div class="ax-contact__grid">
      <div class="ax-contact__info">
        {%- if section.settings.hours_heading != blank -%}
          <h2>{{ section.settings.hours_heading }}</h2>
        {%- endif -%}

        {%- if phone != blank -%}
          <p>
            <span class="ax-contact__label">{{ section.settings.phone_label }}</span>
            <a href="tel:{{ phone | replace: ' ', '' | replace: '-', '' }}">{{ phone }}</a>
          </p>
        {%- endif -%}

        {%- if section.settings.hours != blank -%}
          <div class="ax-contact__hours">{{ section.settings.hours }}</div>
        {%- endif -%}

        {%- if email != blank -%}
          <p>
            <span class="ax-contact__label">{{ section.settings.email_label }}</span>
            <a href="mailto:{{ email }}">{{ email }}</a>
          </p>
        {%- endif -%}
      </div>

      <div class="ax-contact__form-wrap">
        {%- if section.settings.form_heading != blank -%}
          <h2>{{ section.settings.form_heading }}</h2>
        {%- endif -%}

        {%- form 'contact', id: form_id, class: 'ax-contact__form' -%}
          <input name="contact[id]" type="hidden" value="{{ form_id }}">

          {%- if form.errors -%}
            <p class="ax-contact__note ax-contact__note--error" tabindex="-1" autofocus>
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </p>
          {%- endif -%}

          {%- if form.posted_successfully? -%}
            <p class="ax-contact__note ax-contact__note--ok" tabindex="-1" autofocus>
              {{ 'blocks.contact_form.post_success' | t }}
            </p>
          {%- endif -%}

          <label class="visually-hidden" for="{{ form_id }}-name">{{ 'blocks.contact_form.name' | t }}</label>
          <input
            type="text"
            id="{{ form_id }}-name"
            name="contact[name]"
            autocomplete="name"
            placeholder="{{ 'blocks.contact_form.name' | t }} *"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
          >

          <label class="visually-hidden" for="{{ form_id }}-email">{{ 'blocks.contact_form.email' | t }}</label>
          <input
            type="email"
            id="{{ form_id }}-email"
            name="contact[email]"
            autocomplete="email"
            required
            aria-required="true"
            placeholder="{{ 'blocks.contact_form.email' | t }} *"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
          >

          <label class="visually-hidden" for="{{ form_id }}-phone">{{ 'blocks.contact_form.phone' | t }}</label>
          <input
            type="tel"
            id="{{ form_id }}-phone"
            name="contact[phone]"
            autocomplete="tel"
            placeholder="{{ 'blocks.contact_form.phone' | t }}"
            value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
          >

          <label class="visually-hidden" for="{{ form_id }}-body">{{ 'blocks.contact_form.comment' | t }}</label>
          <textarea
            id="{{ form_id }}-body"
            name="contact[body]"
            rows="6"
            placeholder="{{ 'blocks.contact_form.comment' | t }}"
          >{{ form.body }}</textarea>

          <button type="submit" class="button">{{ section.settings.submit_label }}</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact",
  "tag": "section",
  "class": "ax-contact-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Edit heading, hours, phone, and email here. These fields are not hardcoded."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "We're here to help with questions about orders, products, or returns."
    },
    {
      "type": "header",
      "content": "Customer service"
    },
    {
      "type": "text",
      "id": "hours_heading",
      "label": "Hours heading",
      "default": "Customer service hours"
    },
    {
      "type": "richtext",
      "id": "hours",
      "label": "Hours",
      "default": "<p>Monday – Friday: 9:00 – 17:00</p>"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone label",
      "default": "Phone"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number",
      "info": "Leave blank to use the store phone from Shopify settings."
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email address",
      "info": "Leave blank to use the store email from Shopify settings."
    },
    {
      "type": "header",
      "content": "Form"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form heading",
      "default": "Send a message"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit button",
      "default": "Send"
    }
  ],
  "presets": [
    {
      "name": "Contact"
    }
  ]
}
{% endschema %}
