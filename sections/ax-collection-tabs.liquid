{%- liquid
  assign tabs_id = 'ax-tabs-' | append: section.id
-%}

{% render 'quick-add-styles' %}
{% render 'quick-add-modal-styles' %}
{% render 'product-card-styles' %}
{% render 'product-badges-styles' %}
{% render 'swatch-styles' %}
{% render 'variant-picker-styles' %}

<section class="ax-tabs" id="{{ tabs_id }}">
  <div class="ax-wrap">
    <div class="ax-tabs__nav" role="tablist">
      {%- assign tab_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type != 'ax-collection-tab' -%}{%- continue -%}{%- endif -%}
        {%- assign tab_index = tab_index | plus: 1 -%}
        <button
          type="button"
          class="ax-tabs__tab{% if tab_index == 1 %} is-active{% endif %}"
          role="tab"
          aria-selected="{% if tab_index == 1 %}true{% else %}false{% endif %}"
          aria-controls="{{ tabs_id }}-panel-{{ tab_index }}"
          id="{{ tabs_id }}-tab-{{ tab_index }}"
          data-ax-tab="{{ tab_index }}"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.title }}
        </button>
      {%- endfor -%}
    </div>

    {%- assign tab_index = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type != 'ax-collection-tab' -%}{%- continue -%}{%- endif -%}
      {%- assign tab_index = tab_index | plus: 1 -%}
      {%- assign collection = block.settings.collection -%}
      {%- if collection == blank -%}
        {%- assign collection = collections.all -%}
      {%- endif -%}

      <div
        class="ax-tabs__panel{% if tab_index == 1 %} is-active{% endif %}"
        role="tabpanel"
        id="{{ tabs_id }}-panel-{{ tab_index }}"
        aria-labelledby="{{ tabs_id }}-tab-{{ tab_index }}"
        {% unless tab_index == 1 %}hidden{% endunless %}
      >
        <div class="ax-tabs__viewport">
          <div class="ax-tabs__track" data-ax-track>
            {%- if collection != blank and collection.products_count > 0 -%}
              {%- for product in collection.products limit: section.settings.products_limit -%}
                <div class="ax-tabs__item">
                  {% content_for 'block',
                    type: '_product-card',
                    id: 'static-product-card',
                    closest.product: product,
                    product_view_context: 'collection'
                  %}
                </div>
              {%- endfor -%}
            {%- else -%}
              {%- for i in (1..4) -%}
                <div class="ax-tabs__item">
                  {% content_for 'block',
                    type: '_product-card',
                    id: 'static-product-card',
                    closest.product: null
                  %}
                </div>
              {%- endfor -%}
            {%- endif -%}
          </div>
          <button type="button" class="ax-tabs__next" data-ax-next aria-label="Next products">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById({{ tabs_id | json }});
    if (!root) return;

    root.querySelectorAll('[data-ax-tab]').forEach(function (tab) {
      tab.addEventListener('click', function () {
        var id = tab.getAttribute('data-ax-tab');
        root.querySelectorAll('[data-ax-tab]').forEach(function (t) {
          var on = t === tab;
          t.classList.toggle('is-active', on);
          t.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        root.querySelectorAll('.ax-tabs__panel').forEach(function (panel) {
          var on = panel.id === {{ tabs_id | json }} + '-panel-' + id;
          panel.classList.toggle('is-active', on);
          panel.hidden = !on;
        });
      });
    });

    root.querySelectorAll('[data-ax-next]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var track = btn.parentElement.querySelector('[data-ax-track]');
        if (!track) return;
        var card = track.querySelector('.ax-tabs__item');
        var w = card ? card.getBoundingClientRect().width + 24 : 280;
        track.scrollBy({ left: w, behavior: 'smooth' });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Collection tabs",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "range",
      "id": "products_limit",
      "min": 4,
      "max": 16,
      "step": 1,
      "label": "Products per tab",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Collection tabs",
      "blocks": {
        "tab_new": {
          "type": "ax-collection-tab",
          "settings": {
            "title": "New arrivals"
          }
        },
        "tab_best": {
          "type": "ax-collection-tab",
          "settings": {
            "title": "Best sellers"
          }
        },
        "static-product-card": {
          "type": "_product-card",
          "static": true,
          "settings": {
            "product_card_gap": 4
          },
          "blocks": {
            "product-card-gallery": {
              "type": "_product-card-gallery",
              "settings": {
                "image_ratio": "square"
              }
            },
            "product_title": {
              "type": "product-title"
            },
            "price": {
              "type": "price"
            },
            "swatches": {
              "type": "swatches"
            }
          },
          "block_order": ["product-card-gallery", "product_title", "price", "swatches"]
        }
      },
      "block_order": ["tab_new", "tab_best"]
    }
  ]
}
{% endschema %}
