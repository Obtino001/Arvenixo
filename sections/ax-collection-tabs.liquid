{%- liquid
  assign tabs_id = 'ax-tabs-' | append: section.id
  assign limit = section.settings.products_limit
  assign collection_1 = section.settings.collection_1
  assign collection_2 = section.settings.collection_2
  if collection_1 == blank
    assign collection_1 = collections.all
  endif
  if collection_2 == blank
    assign collection_2 = collections.all
  endif
-%}

{% render 'quick-add-styles' %}
{% render 'quick-add-modal-styles' %}
{% render 'product-card-styles' %}
{% render 'product-badges-styles' %}
{% render 'swatch-styles' %}
{% render 'quantity-selector-styles' %}
{% render 'variant-picker-styles' %}

<section class="ax-tabs" id="{{ tabs_id }}">
  <div class="ax-wrap">
    <div class="ax-tabs__nav" role="tablist">
      {%- if section.settings.title_1 != blank -%}
        <button
          type="button"
          class="ax-tabs__tab is-active"
          role="tab"
          aria-selected="true"
          aria-controls="{{ tabs_id }}-panel-1"
          id="{{ tabs_id }}-tab-1"
          data-ax-tab="1"
        >
          {{ section.settings.title_1 }}
        </button>
      {%- endif -%}
      {%- if section.settings.title_2 != blank -%}
        <button
          type="button"
          class="ax-tabs__tab"
          role="tab"
          aria-selected="false"
          aria-controls="{{ tabs_id }}-panel-2"
          id="{{ tabs_id }}-tab-2"
          data-ax-tab="2"
        >
          {{ section.settings.title_2 }}
        </button>
      {%- endif -%}
    </div>

    {%- for tab_n in (1..2) -%}
      {%- if tab_n == 1 -%}
        {%- assign tab_collection = collection_1 -%}
      {%- else -%}
        {%- assign tab_collection = collection_2 -%}
      {%- endif -%}

      <div
        class="ax-tabs__panel{% if tab_n == 1 %} is-active{% endif %}"
        role="tabpanel"
        id="{{ tabs_id }}-panel-{{ tab_n }}"
        aria-labelledby="{{ tabs_id }}-tab-{{ tab_n }}"
        {% unless tab_n == 1 %}hidden{% endunless %}
      >
        <div class="ax-tabs__viewport">
          <div class="ax-tabs__track" data-ax-track>
            {%- if tab_collection != blank and tab_collection.products_count > 0 -%}
              {%- for product in tab_collection.products limit: limit -%}
                <div class="ax-tabs__item">
                  {% content_for 'block',
                    type: '_product-card',
                    id: 'static-product-card',
                    closest.product: product,
                    product_view_context: 'collection'
                  %}
                </div>
              {%- endfor -%}
            {%- else -%}
              {%- for i in (1..4) -%}
                <div class="ax-tabs__item">
                  {% content_for 'block',
                    type: '_product-card',
                    id: 'static-product-card',
                    closest.product: null
                  %}
                </div>
              {%- endfor -%}
            {%- endif -%}
          </div>
          <button type="button" class="ax-tabs__next" data-ax-next aria-label="Next products">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>
    {%- endfor -%}
  </div>
  {% content_for 'blocks' %}
</section>

<script>
  (function () {
    var root = document.getElementById({{ tabs_id | json }});
    if (!root) return;

    root.querySelectorAll('[data-ax-tab]').forEach(function (tab) {
      tab.addEventListener('click', function () {
        var id = tab.getAttribute('data-ax-tab');
        root.querySelectorAll('[data-ax-tab]').forEach(function (t) {
          var on = t === tab;
          t.classList.toggle('is-active', on);
          t.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        root.querySelectorAll('.ax-tabs__panel').forEach(function (panel) {
          var on = panel.id === {{ tabs_id | json }} + '-panel-' + id;
          panel.classList.toggle('is-active', on);
          panel.hidden = !on;
        });
      });
    });

    root.querySelectorAll('[data-ax-next]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var track = btn.parentElement.querySelector('[data-ax-track]');
        if (!track) return;
        var card = track.querySelector('.ax-tabs__item');
        var w = card ? card.getBoundingClientRect().width + 24 : 280;
        track.scrollBy({ left: w, behavior: 'smooth' });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Collection tabs",
  "class": "ax-collection-tabs",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title_1",
      "label": "Tab 1 title",
      "default": "New arrivals"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "Tab 1 collection"
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "Tab 2 title",
      "default": "Best sellers"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Tab 2 collection"
    },
    {
      "type": "range",
      "id": "products_limit",
      "min": 4,
      "max": 16,
      "step": 1,
      "label": "Products per tab",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Collection tabs",
      "blocks": {
        "static-product-card": {
          "type": "_product-card",
          "static": true,
          "settings": {
            "product_card_gap": 4,
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "product-card-gallery": {
              "type": "_product-card-gallery",
              "settings": {
                "image_ratio": "square",
                "border": "none",
                "border_width": 1,
                "border_opacity": 100,
                "border_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "product_title": {
              "type": "product-title",
              "settings": {
                "width": "100%",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "paragraph",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 8,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "price": {
              "type": "price",
              "settings": {
                "show_sale_price_first": true,
                "show_installments": false,
                "show_tax_info": false,
                "type_preset": "h6",
                "width": "100%",
                "alignment": "left",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "swatches": {
              "type": "swatches",
              "settings": {
                "product_swatches_alignment": "flex-start",
                "product_swatches_alignment_mobile": "flex-start",
                "product_swatches_padding_top": 8,
                "product_swatches_padding_bottom": 0,
                "product_swatches_padding_left": 0,
                "product_swatches_padding_right": 0
              }
            }
          },
          "block_order": ["product-card-gallery", "product_title", "price", "swatches"]
        }
      },
      "block_order": []
    }
  ]
}
{% endschema %}
