<section class="ax-mission">
  <div class="ax-mission__inner ax-wrap">
    {%- if section.settings.quote != blank -%}
      <p class="ax-mission__quote">“{{ section.settings.quote | replace: '"', '' | replace: '“', '' | replace: '”', '' }}”</p>
    {%- endif -%}

    <div class="ax-mission__facts">
      {%- if section.settings.line_1 != blank -%}<span>{{ section.settings.line_1 }}</span>{%- endif -%}
      {%- if section.settings.line_2 != blank -%}<span>{{ section.settings.line_2 }}</span>{%- endif -%}
      {%- if section.settings.line_3 != blank -%}<span>{{ section.settings.line_3 }}</span>{%- endif -%}
    </div>

    <div class="ax-mission__mark">
      {%- if section.settings.badge != blank -%}
        {%- assign badge_alt = section.settings.badge_alt | default: 'Certified' -%}
        {{ section.settings.badge | image_url: width: 280 | image_tag: loading: 'lazy', alt: badge_alt }}
      {%- else -%}
        <svg class="ax-mission__bcorp" viewBox="0 0 88 120" aria-label="{{ section.settings.badge_alt | default: 'Certified' }}">
          <text x="44" y="14" text-anchor="middle" font-size="11" font-family="Georgia, serif" letter-spacing="1.4">Certified</text>
          <circle cx="44" cy="52" r="28" fill="none" stroke="currentColor" stroke-width="3.5"/>
          <text x="44" y="64" text-anchor="middle" font-size="36" font-family="Georgia, serif" font-weight="700">B</text>
          <line x1="12" y1="90" x2="76" y2="90" stroke="currentColor" stroke-width="1.5"/>
          <text x="44" y="108" text-anchor="middle" font-size="12" font-family="Georgia, serif" letter-spacing="0.6">Corporation</text>
        </svg>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AX Mission bar",
  "class": "ax-mission-section",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "text", "id": "quote", "label": "Quote", "default": "A passion for Good Design & Quality Products" },
    { "type": "text", "id": "line_1", "label": "Line 1", "default": "Tech Accessories Reimagined" },
    { "type": "text", "id": "line_2", "label": "Line 2", "default": "Designed in Paris" },
    { "type": "text", "id": "line_3", "label": "Line 3", "default": "Delivering Worldwide" },
    { "type": "image_picker", "id": "badge", "label": "Badge image" },
    { "type": "text", "id": "badge_alt", "label": "Badge alt text", "default": "Certified B Corporation" }
  ],
  "presets": [{ "name": "AX Mission bar" }]
}
{% endschema %}
