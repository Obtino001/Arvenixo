{% comment %} Arvenixo shop-by-category tiles with asset image fallbacks {% endcomment %}

<section id="ArvenixoCategories-{{ section.id }}" class="ax-categories">
  <div class="page-width">
    <div class="ax-section-head">
      {%- if section.settings.heading != blank -%}
        <h2 class="ax-section-title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="ax-section-sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="ax-cat-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign fallback = 'arvenixo-category-cases.png'
          if forloop.index == 2
            assign fallback = 'arvenixo-category-beauty.png'
          elsif forloop.index == 3
            assign fallback = 'arvenixo-category-tech.png'
          endif
        -%}
        <a
          class="ax-cat-card"
          href="{{ block.settings.link | default: routes.all_products_collection_url }}"
          {{ block.shopify_attributes }}
        >
          <div class="ax-cat-card__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1000
                | image_tag: loading: 'lazy', class: 'ax-cat-card__img', widths: '400,700,1000', sizes: '(min-width: 750px) 33vw, 100vw', alt: block.settings.title
              }}
            {%- else -%}
              <img
                class="ax-cat-card__img"
                src="{{ fallback | asset_url }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
                width="800"
                height="800"
              >
            {%- endif -%}
          </div>
          <div class="ax-cat-card__body">
            <h3 class="ax-cat-card__title">{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}
              <p class="ax-cat-card__text">{{ block.settings.text }}</p>
            {%- endif -%}
            <span class="ax-cat-card__cta">{{ block.settings.cta | default: 'Shop now' }}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Arvenixo Categories",
  "tag": "section",
  "class": "section-arvenixo-categories",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Focused essentials for everyday life — cases, beauty tech, and smart gadgets."
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Phone Cases" },
        { "type": "text", "id": "text", "label": "Text", "default": "MagSafe-ready protection with everyday style." },
        { "type": "text", "id": "cta", "label": "CTA label", "default": "Shop cases" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Arvenixo Categories",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Phone Cases",
            "text": "MagSafe-ready protection with everyday style.",
            "cta": "Shop cases"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Beauty Tech",
            "text": "At-home LED and facial care devices.",
            "cta": "Shop beauty"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Smart Tech",
            "text": "Cameras, gimbals, and everyday gadgets.",
            "cta": "Shop tech"
          }
        }
      ]
    }
  ]
}
{% endschema %}
