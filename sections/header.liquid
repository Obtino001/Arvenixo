        <script>
        window.sbUpdateWishCount=function(){var el=document.getElementById('sbWishCount');if(!el)return;var n=0;try{n=(JSON.parse(localStorage.getItem('sb_wishlist')||'[]')).length;}catch(e){}if(n>0){el.textContent=n;el.style.display='';}else{el.style.display='none';}};
        document.addEventListener('DOMContentLoaded',window.sbUpdateWishCount);
        window.addEventListener('storage',function(e){if(e.key==='sb_wishlist')window.sbUpdateWishCount();});
        window.sbUpdateWishCount();
        </script>
        <script>
        /* Global wishlist toggle for .sb-card-wish (works on every page: home, collection, PDP) */
        (function(){
          if(window.__sbWishToggleInit) return; window.__sbWishToggleInit=true;
          var KEY='sb_wishlist';
          function read(){try{return JSON.parse(localStorage.getItem(KEY)||'[]');}catch(e){return[];}}
          function write(l){try{localStorage.setItem(KEY,JSON.stringify(l));}catch(e){} if(window.sbUpdateWishCount)window.sbUpdateWishCount();}
          function idxOf(l,h){for(var i=0;i<l.length;i++){if(l[i].handle===h)return i;} return -1;}
          function mark(){var l=read();document.querySelectorAll('.sb-card-wish').forEach(function(b){b.setAttribute('aria-pressed', idxOf(l,b.dataset.handle)>-1?'true':'false');});}
          document.addEventListener('click',function(e){
            var btn=e.target.closest('.sb-card-wish'); if(!btn) return;
            e.preventDefault(); e.stopPropagation();
            var l=read(), h=btn.dataset.handle, i=idxOf(l,h);
            if(i>-1){ l.splice(i,1); btn.setAttribute('aria-pressed','false'); }
            else { l.push({handle:h,url:btn.dataset.url,title:btn.dataset.title,vendor:btn.dataset.vendor,img:btn.dataset.img,price:parseInt(btn.dataset.price||'0',10),cprice:parseInt(btn.dataset.cprice||'0',10)}); btn.setAttribute('aria-pressed','true'); }
            write(l);
          });
          if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',mark); else mark();
          window.addEventListener('storage',function(e){ if(e.key===KEY) mark(); });
        })();
        </script>
