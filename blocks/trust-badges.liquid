{%- style -%}
  .section-{{ block.id }}-wrapper {
    padding-top: {{ block.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ block.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ block.id }}-wrapper {
      padding-top: {{ block.settings.padding_top }}px;
      padding-bottom: {{ block.settings.padding_bottom }}px;
    }
  }

  .sales-points-header {
    margin-bottom: 20px;
  }

  .sales-points-orange-text {
    color: #e65100; /* Orange accent */
    font-weight: 700;
    font-size: 14px;
    margin-bottom: 8px;
    display: block;
  }

  .sales-points-description {
    font-size: 14px;
    line-height: 1.5;
    color: #545453;
    margin-bottom: 12px;
  }

  .sales-points-big-icon {
    max-width: 100%;
    height: auto;
    border-radius: 4px;
  }

  .section-{{ block.id }}-wrapper .sales-points-container {
    background-color: {{ block.settings.bg_color }};
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 20px;
  }

  .sales-points-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .sales-point-item {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .sales-point-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sales-point-icon svg,
  .sales-point-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .sales-point-text {
    font-size: 13px;
    line-height: 1.4;
    letter-spacing: 0.5px;
    color: #333333;
  }

  .sales-point-text p {
    margin: 0;
  }

  .sales-point-text strong {
    font-weight: 700;
    color: #111111;
  }

  @media screen and (max-width: 400px) {
    .sales-point-text {
      font-size: 12px;
    }
    .section-{{ block.id }}-wrapper .sales-points-container {
      padding: 16px;
    }
  }
{%- endstyle -%}

<div class="section-{{ block.id }}-wrapper" {{ section.shopify_attributes }}>
  <div class="sales-points-container">
    <div class="sales-points-list">

      {%- if block.settings.shipping_text != blank -%}
        <div class="sales-point-item">
          <div class="sales-point-icon">
            {%- if block.settings.shipping_svg != blank -%}
              {{ block.settings.shipping_svg }}
            {%- elsif block.settings.shipping_icon_url != blank -%}
              <img src="{{ block.settings.shipping_icon_url | image_url: width: 60 }}" alt="Icon" width="20" height="20" loading="lazy">
            {%- endif -%}
          </div>
          <div class="sales-point-text">
            {{ block.settings.shipping_text }}
          </div>
        </div>
      {%- endif -%}

      {%- if block.settings.shipping_text1 != blank -%}
        <div class="sales-point-item">
          <div class="sales-point-icon">
            {%- if block.settings.shipping_svg1 != blank -%}
              {{ block.settings.shipping_svg1 }}
            {%- elsif block.settings.shipping_icon_url1 != blank -%}
              <img src="{{ block.settings.shipping_icon_url1 | image_url: width: 60 }}" alt="Icon" width="20" height="20" loading="lazy">
            {%- endif -%}
          </div>
          <div class="sales-point-text">
            {{ block.settings.shipping_text1 }}
          </div>
        </div>
      {%- endif -%}

      {%- if block.settings.return_text != blank -%}
        <div class="sales-point-item">
          <div class="sales-point-icon">
            {%- if block.settings.return_svg != blank -%}
              {{ block.settings.return_svg }}
            {%- elsif block.settings.return_icon_url != blank -%}
              <img src="{{ block.settings.return_icon_url | image_url: width: 60 }}" alt="Icon" width="20" height="20" loading="lazy">
            {%- endif -%}
          </div>
          <div class="sales-point-text">
            {{ block.settings.return_text }}
          </div>
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Sales Points",
  "settings": [
    {
      "type": "header",
      "content": "Container Settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F7F8F9"
    },
    {
      "type": "header",
      "content": "List Item 1"
    },
    {
      "type": "image_picker",
      "id": "shipping_icon_url",
      "label": "Icon Image"
    },
    {
      "type": "html",
      "id": "shipping_svg",
      "label": "Custom SVG Code",
      "info": "Overrides the image above."
    },
    {
      "type": "richtext",
      "id": "shipping_text",
      "label": "Text",
      "default": "<p>Envío seguro y seguimiento con Correos</p>"
    },
    {
      "type": "header",
      "content": "List Item 2"
    },
    {
      "type": "image_picker",
      "id": "shipping_icon_url1",
      "label": "Icon Image"
    },
    {
      "type": "html",
      "id": "shipping_svg1",
      "label": "Custom SVG Code",
      "info": "Overrides the image above."
    },
    {
      "type": "richtext",
      "id": "shipping_text1",
      "label": "Text",
      "default": "<p>Entrega rápida y confiable</p>"
    },
    {
      "type": "header",
      "content": "List Item 3"
    },
    {
      "type": "image_picker",
      "id": "return_icon_url",
      "label": "Icon Image"
    },
    {
      "type": "html",
      "id": "return_svg",
      "label": "Custom SVG Code",
      "info": "Overrides the image above."
    },
    {
      "type": "richtext",
      "id": "return_text",
      "label": "Text",
      "default": "<p>30 días de devolución garantizados</p>"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Sales Points icons"
    }
  ]
}
{% endschema %}