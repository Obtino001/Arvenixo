{%- comment -%}
  Arvenixo lockup: MagSafe ring + A mark and serif wordmark.
  Pass linked: false when already wrapped in an anchor.
{%- endcomment -%}
{%- if linked != false -%}
  <a href="{{ routes.root_url }}" class="ax-logo" aria-label="{{ shop.name }}">
{%- else -%}
  <span class="ax-logo">
{%- endif -%}
    <svg class="ax-logo__mark" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
      <circle cx="32" cy="32" r="29.2" fill="none" stroke="currentColor" stroke-width="1.55"/>
      <circle cx="32" cy="32" r="23" fill="none" stroke="currentColor" stroke-width="1.15"/>
      <path fill="currentColor" fill-rule="evenodd" d="M32.1 14.8 45.6 50h-4.85l-2.55-6.85H25.8L23.25 50H18.4L32.1 14.8Zm-4.55 23.4h9.1L32.1 26.2l-4.55 12z"/>
    </svg>
    <span class="ax-logo__word">Arvenixo</span>
{%- if linked != false -%}
  </a>
{%- else -%}
  </span>
{%- endif -%}
