{% comment %} Mobile sticky add-to-cart bar for product pages {% endcomment %}
{%- if product != blank -%}
  <div class="ax-sticky-atc" data-ax-sticky-atc>
    <div class="ax-sticky-atc__meta">
      <span class="ax-sticky-atc__price">{{ product.selected_or_first_available_variant.price | money }}</span>
      <span class="ax-sticky-atc__note">Free shipping · 7–10 business days</span>
    </div>
    <button type="button" class="button" data-ax-sticky-atc-trigger>
      Add to cart
    </button>
  </div>
  <script>
    (function () {
      var btn = document.querySelector('[data-ax-sticky-atc-trigger]');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var real =
          document.querySelector('product-form-component button[type="submit"], .product-form button[name="add"], button[name="add"]');
        if (real) real.click();
        else window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    })();
  </script>
{%- endif -%}
