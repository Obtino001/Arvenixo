{
  "sections": {
    "faq_main": {
      "type": "section",
      "blocks": {
        "heading": {
          "type": "text",
          "settings": {
            "text": "<h1>Frequently asked questions</h1>",
            "type_preset": "h2",
            "width": "fit-content"
          }
        },
        "intro": {
          "type": "text",
          "settings": {
            "text": "<p>Quick answers about shipping, returns, MagSafe cases, and beauty devices. Need more help? Email <strong>support@arvenixo.com</strong>.</p>",
            "type_preset": "rte",
            "width": "fit-content",
            "max_width": "normal"
          }
        },
        "accordion": {
          "type": "accordion",
          "settings": {
            "icon": "caret",
            "dividers": true,
            "type_preset": "h5"
          },
          "blocks": {
            "r1": {
              "type": "_accordion-row",
              "settings": { "heading": "Do you offer free shipping?", "icon": "none" },
              "blocks": {
                "t": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes. Free standard shipping on all orders. Estimated delivery is <strong>7–10 business days</strong> after your order ships. Tracking is emailed when the package is on the way.</p>",
                    "type_preset": "rte",
                    "width": "100%"
                  }
                }
              },
              "block_order": ["t"]
            },
            "r2": {
              "type": "_accordion-row",
              "settings": { "heading": "What is your return policy?", "icon": "none" },
              "blocks": {
                "t": {
                  "type": "text",
                  "settings": {
                    "text": "<p>You have <strong>30 days</strong> after delivery to request a return for eligible items in original condition. Opened personal-care/beauty products may be excluded for hygiene reasons. Damaged, defective, or incorrect items are always covered — contact support first.</p>",
                    "type_preset": "rte",
                    "width": "100%"
                  }
                }
              },
              "block_order": ["t"]
            },
            "r3": {
              "type": "_accordion-row",
              "settings": { "heading": "How do I pick the correct iPhone model?", "icon": "none" },
              "blocks": {
                "t": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Choose your exact model on the product page before adding to cart. You can confirm your model under Settings → General → About on your iPhone.</p>",
                    "type_preset": "rte",
                    "width": "100%"
                  }
                }
              },
              "block_order": ["t"]
            },
            "r4": {
              "type": "_accordion-row",
              "settings": { "heading": "Are beauty devices safe / returnable?", "icon": "none" },
              "blocks": {
                "t": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Beauty devices are for cosmetic skincare use; results vary. Follow the product safety notes. Unopened devices may be returned within 30 days. Opened devices generally aren’t returnable unless defective or incorrect.</p>",
                    "type_preset": "rte",
                    "width": "100%"
                  }
                }
              },
              "block_order": ["t"]
            },
            "r5": {
              "type": "_accordion-row",
              "settings": { "heading": "How do I contact support?", "icon": "none" },
              "blocks": {
                "t": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Email <strong>support@arvenixo.com</strong> or use the Contact page. We typically reply within 1–2 business days.</p>",
                    "type_preset": "rte",
                    "width": "100%"
                  }
                }
              },
              "block_order": ["t"]
            }
          },
          "block_order": ["r1", "r2", "r3", "r4", "r5"]
        }
      },
      "block_order": ["heading", "intro", "accordion"],
      "settings": {
        "content_direction": "column",
        "gap": 20,
        "section_width": "page-width",
        "color_scheme": "scheme-1",
        "padding-block-start": 56,
        "padding-block-end": 72
      }
    }
  },
  "order": ["faq_main"]
}
