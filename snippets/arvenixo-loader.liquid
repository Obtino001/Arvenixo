<!-- Arvenixo Animated Loader -->
<div id="main_loader" class="fixed inset-0 bg-[#f9f9f9] flex items-center justify-center z-[9999] transition-opacity duration-700 ease-in-out">
  <div class="relative w-64 md:w-80 h-32 flex items-center justify-center">
    <svg viewBox="0 0 400 100" class="w-full h-full">
      <text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" class="loader-text" font-family="'Haffer', sans-serif" font-size="48" font-weight="600" letter-spacing="4">
        ARVENIXO
      </text>
    </svg>
  </div>
</div>

<style>
  .loader-text {
    fill: transparent;
    stroke: #1a1a1a;
    stroke-width: 1px;
    stroke-dasharray: 400;
    stroke-dashoffset: 400;
    /* 1. Draw outline for 1.5s 
       2. Fill color gracefully for 0.8s */
    animation: 
      drawText 1.5s cubic-bezier(0.25, 1, 0.5, 1) forwards,
      fillText 0.8s ease-in 1.2s forwards;
  }

  @keyframes drawText {
    0% {
      stroke-dashoffset: 400;
    }
    100% {
      stroke-dashoffset: 0;
    }
  }

  @keyframes fillText {
    0% { 
      fill: transparent; 
      stroke-width: 1px;
    }
    100% { 
      fill: #1a1a1a; 
      stroke-width: 0; 
    }
  }

  .fade-out {
    opacity: 0;
    pointer-events: none;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const loader = document.getElementById("main_loader");
    if(loader) {
      // The total SVG animation takes around 2 seconds.
      // Wait 2.2s before fading out the white background.
      setTimeout(() => {
        loader.classList.add("fade-out");
        setTimeout(() => {
          loader.style.display = "none";
        }, 700); // Wait for the CSS fade transition to finish
      }, 2200);
    }
  });
</script>
