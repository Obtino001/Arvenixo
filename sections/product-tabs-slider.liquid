<div class="shopify-section section product-tabs-slider px-6 sm:px-10 lg:px-12 xl:px-16 pt-16 xs:pt-20 sm:pt-24 md:pt-28 lg:pt-32 xl:pt-36 pb-12" id="ProductTabs-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="w-full mx-auto max-w-screen-full">
    <!-- Tab Headers (Handled via Custom Pagination) -->
    <div class="border-b border-gray-300 lg:mb-8 relative">
      <div class="swiper-pagination custom-tabs-pagination !relative !bottom-0 !left-0 !w-full flex flex-wrap" id="pagination_{{ section.id }}"></div>
    </div>

    <!-- Navigation Arrows for Active Tab -->
    <div class="flex justify-end space-x-4 my-6 md:my-8">
      <button class="swiper-button-custom-prev w-10 h-10 md:w-12 md:h-12 border border-gray-300 rounded-full flex items-center justify-center transition-all hover:bg-black hover:text-white disabled:opacity-30" id="button_prev_{{ section.id }}">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button class="swiper-button-custom-next w-10 h-10 md:w-12 md:h-12 border border-gray-300 rounded-full flex items-center justify-center transition-all hover:bg-black hover:text-white disabled:opacity-30" id="button_next_{{ section.id }}">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>

    <!-- Parent Swiper (Holds the Collections as Tabs) -->
    <div class="swiper parent-tabs-swiper w-full" id="swiper_parent_{{ section.id }}">
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          {%- assign collection = collections[block.settings.collection] -%}
          <div class="swiper-slide w-full" data-title="{{ block.settings.title }}" {{ block.shopify_attributes }}>
            <!-- Nested Swiper (Products Slider) -->
            <div class="swiper nested-products-swiper w-full" id="swiper_child_{{ section.id }}_{{ forloop.index }}">
              <div class="swiper-wrapper">
                {%- if collection.products.size > 0 -%}
                  {%- for product in collection.products limit: block.settings.limit -%}
                    <div class="swiper-slide md:pb-2 md:border-b border-transparent hover:border-black transition-colors duration-300 group">
                      <div class="grid-product-item w-full h-full flex flex-col rounded overflow-hidden relative">
                        <div class="images-container bg-[#f5f5f7] flex-shrink-0 relative rounded-2xl overflow-hidden mb-4 group/image" style="aspect-ratio: 4/5;">
                          <a href="{{ product.url }}" class="w-full h-full block relative p-4 sm:p-6">
                            {%- if product.featured_image -%}
                              {%- if product.media[1] -%}
                                {{ product.featured_image | image_url: width: 800 | image_tag: class: 'w-full h-full object-contain mix-blend-multiply transition-opacity duration-500 group-hover/image:opacity-0 absolute inset-0 m-auto p-4 sm:p-6' }}
                                {{ product.media[1] | image_url: width: 800 | image_tag: class: 'w-full h-full object-contain mix-blend-multiply absolute inset-0 m-auto opacity-0 transition-opacity duration-500 group-hover/image:opacity-100 scale-105 p-4 sm:p-6' }}
                              {%- else -%}
                                {{ product.featured_image | image_url: width: 800 | image_tag: class: 'w-full h-full object-contain mix-blend-multiply transition-transform duration-700 group-hover/image:scale-110 absolute inset-0 m-auto p-4 sm:p-6' }}
                              {%- endif -%}
                            {%- else -%}
                              {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover opacity-50 absolute inset-0 m-auto p-4 sm:p-6' }}
                            {%- endif -%}
                          </a>
                          
                          <!-- Badges -->
                          <div class="absolute top-3 left-3 flex flex-col gap-1.5 z-10">
                            {%- if product.compare_at_price > product.price -%}
                              <span class="bg-black text-white text-[10px] md:text-[11px] uppercase tracking-wider px-2.5 py-1 rounded-sm font-medium shadow-sm leading-none">Sale</span>
                            {%- endif -%}
                            {%- if product.tags.size > 0 -%}
                              {%- for tag in product.tags limit: 1 -%}
                                <span class="bg-white/90 backdrop-blur text-black text-[10px] md:text-[11px] uppercase tracking-wider px-2.5 py-1 rounded-sm font-medium shadow-sm border border-gray-100 leading-none">{{ tag }}</span>
                              {%- endfor -%}
                            {%- endif -%}
                          </div>

                          <!-- Quick Add Overlay -->
                          <div class="absolute bottom-4 left-0 right-0 px-4 opacity-0 translate-y-4 transition-all duration-300 group-hover/image:opacity-100 group-hover/image:translate-y-0 z-20">
                            <form method="post" action="{{ routes.cart_add_url }}" class="w-full m-0">
                              <input type="hidden" name="id" value="{{ product.variants.first.id }}">
                              <button type="submit" class="w-full bg-black/90 backdrop-blur-md hover:bg-black text-white text-[13px] font-medium py-3 rounded-xl transition-colors shadow-lg flex items-center justify-center space-x-2">
                                <span>Add to Cart</span>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
                              </button>
                            </form>
                          </div>
                        </div>
                        
                        <!-- Animated Hover Line -->
                        <div class="w-full h-px bg-gray-200 mb-3 scale-x-0 group-hover:scale-x-100 transition-transform origin-left duration-500"></div>
                        
                        <div class="info-container w-full flex flex-col px-1">
                          <a href="{{ product.url }}" class="w-full flex flex-col space-y-1">
                            <!-- Star Rating (CRO) -->
                            <div class="flex items-center space-x-0.5 mb-1">
                              {% for i in (1..5) %}
                                <svg class="w-3.5 h-3.5 text-black" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                              {% endfor %}
                              <span class="text-[11px] text-gray-500 ml-1 font-medium">(4.9)</span>
                            </div>

                            <h4 class="text-[15px] lg:text-[17px] font-medium leading-tight text-black line-clamp-2 transition-colors group-hover:text-gray-600">
                              {{ product.title }}
                            </h4>
                            
                            <div class="flex items-center flex-wrap gap-2 pt-1.5">
                              <span class="text-[15px] lg:text-[16px] font-semibold text-black">
                                {{ product.price | money }}
                              </span>
                              {%- if product.compare_at_price > product.price -%}
                                <span class="text-[13px] line-through text-gray-400 font-light">{{ product.compare_at_price | money }}</span>
                                {%- assign save_amount = product.compare_at_price | minus: product.price -%}
                                {%- assign save_percent = save_amount | times: 100.0 | divided_by: product.compare_at_price | round -%}
                                <span class="text-[10px] md:text-[11px] font-medium text-orange-600 bg-orange-50 px-2 py-0.5 rounded uppercase tracking-wide">Save {{ save_percent }}%</span>
                              {%- endif -%}
                            </div>
                          </a>
                        </div>
                      </div>
                    </div>
                  {%- endfor -%}
                {%- else -%}
                  <!-- Placeholder Slides -->
                  {%- for i in (1..4) -%}
                    <div class="swiper-slide md:pb-2 md:border-b border-transparent">
                      <div class="grid-product-item w-full h-full flex flex-col rounded overflow-hidden relative group">
                        <div class="images-container bg-[#f5f5f7] flex-shrink-0 aspect-[4/5] relative rounded-2xl overflow-hidden mb-4">
                          {{ 'product-' | append: i | placeholder_svg_tag: 'w-full h-full object-cover opacity-30' }}
                        </div>
                        <div class="info-container w-full px-1">
                          <h4 class="text-[16px] lg:text-[18px] xl:text-[20px] font-medium leading-tight text-black">Product Title</h4>
                          <h3 class="text-[14px] lg:text-[16px] text-gray-500 font-light">$99.00</h3>
                        </div>
                      </div>
                    </div>
                  {%- endfor -%}
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<style>
  /* FOUC Fix for Swipers */
  #swiper_parent_{{ section.id }}:not(.swiper-initialized) > .swiper-wrapper > .swiper-slide:not(:first-child) {
    display: none;
  }
  #swiper_parent_{{ section.id }}:not(.swiper-initialized) > .swiper-wrapper > .swiper-slide {
    width: 100%;
  }
  .product-tabs-slider .nested-products-swiper:not(.swiper-initialized) > .swiper-wrapper {
    flex-wrap: nowrap;
    overflow: hidden;
  }
  .product-tabs-slider .nested-products-swiper:not(.swiper-initialized) > .swiper-wrapper > .swiper-slide {
    width: 85%; /* Mobile default */
    flex-shrink: 0;
  }
  @media (min-width: 640px) {
    .product-tabs-slider .nested-products-swiper:not(.swiper-initialized) > .swiper-wrapper > .swiper-slide { width: 45%; }
  }
  @media (min-width: 1024px) {
    .product-tabs-slider .nested-products-swiper:not(.swiper-initialized) > .swiper-wrapper > .swiper-slide { width: 30%; }
  }
  @media (min-width: 1440px) {
    .product-tabs-slider .nested-products-swiper:not(.swiper-initialized) > .swiper-wrapper > .swiper-slide { width: 23%; }
  }

  .product-tabs-slider .custom-tabs-pagination .swiper-pagination-bullet {
    background: transparent;
    opacity: 0.4;
    width: auto;
    height: auto;
    border-radius: 0;
    margin: 0 32px 0 0 !important;
    padding-bottom: 16px;
    font-size: clamp(28px, 5vw, 96px);
    line-height: 1;
    font-weight: 300;
    color: #000;
    transition: all 0.3s ease;
    cursor: pointer;
  }
  
  .product-tabs-slider .custom-tabs-pagination .swiper-pagination-bullet-active {
    opacity: 1;
    font-weight: 500;
    position: relative;
  }

  .product-tabs-slider .custom-tabs-pagination .swiper-pagination-bullet-active::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 3px;
    background-color: #000;
    border-radius: 2px;
  }

  @media (max-width: 768px) {
    .product-tabs-slider .custom-tabs-pagination .swiper-pagination-bullet {
      margin-right: 20px !important;
    }
  }
  .product-tabs-slider .parent-tabs-swiper > .swiper-wrapper > .swiper-slide {
    pointer-events: none;
  }
  .product-tabs-slider .parent-tabs-swiper > .swiper-wrapper > .swiper-slide.swiper-slide-active {
    pointer-events: auto;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const parentId = '#swiper_parent_{{ section.id }}';
    const nextBtn = document.querySelector('#button_next_{{ section.id }}');
    const prevBtn = document.querySelector('#button_prev_{{ section.id }}');
    
    // Store nested swipers to control them easily
    const nestedSwipers = [];

    // 1. Initialize Nested Swipers (Products)
    const childSwiperEls = document.querySelectorAll(`${parentId} .nested-products-swiper`);
    childSwiperEls.forEach((el, index) => {
      const swiper = new Swiper(el, {
        nested: true,
        slidesPerView: 1.2,
        spaceBetween: 16,
        watchOverflow: true,
        preventClicks: false,
        preventClicksPropagation: false,
        breakpoints: {
          640: { slidesPerView: 2.2, spaceBetween: 20 },
          1024: { slidesPerView: 3.2, spaceBetween: 24 },
          1440: { slidesPerView: 4, spaceBetween: 32 }
        },
        on: {
          slideChange: function () {
            updateNavButtons(this);
          }
        }
      });
      nestedSwipers.push(swiper);
    });

    // 2. Initialize Parent Swiper (Tabs)
    const parentSwiper = new Swiper(parentId, {
      allowTouchMove: false, // Only switch via tabs
      autoHeight: true,
      effect: 'fade',
      fadeEffect: { crossFade: true },
      pagination: {
        el: '#pagination_{{ section.id }}',
        clickable: true,
        renderBullet: function (index, className) {
          // Get title from data attribute
          const slide = document.querySelectorAll(`${parentId} > .swiper-wrapper > .swiper-slide`)[index];
          const title = slide ? slide.getAttribute('data-title') : `Tab ${index + 1}`;
          return `<div class="${className}">${title}</div>`;
        }
      },
      on: {
        slideChange: function () {
          // When tab changes, update the nav buttons to control the active nested swiper
          const activeIndex = this.activeIndex;
          const activeNestedSwiper = nestedSwipers[activeIndex];
          if(activeNestedSwiper) {
            updateNavButtons(activeNestedSwiper);
          }
        }
      }
    });

    // Handle Custom Arrows Click
    nextBtn.addEventListener('click', () => {
      const activeNested = nestedSwipers[parentSwiper.activeIndex];
      if (activeNested) activeNested.slideNext();
    });

    prevBtn.addEventListener('click', () => {
      const activeNested = nestedSwipers[parentSwiper.activeIndex];
      if (activeNested) activeNested.slidePrev();
    });

    // Utility to update button states based on active child swiper
    function updateNavButtons(swiperInstance) {
      if (swiperInstance.isEnd) {
        nextBtn.classList.add('opacity-30', 'pointer-events-none');
      } else {
        nextBtn.classList.remove('opacity-30', 'pointer-events-none');
      }
      
      if (swiperInstance.isBeginning) {
        prevBtn.classList.add('opacity-30', 'pointer-events-none');
      } else {
        prevBtn.classList.remove('opacity-30', 'pointer-events-none');
      }
    }

    // Init button states for the first tab
    if(nestedSwipers.length > 0) {
      updateNavButtons(nestedSwipers[0]);
    }
  });
</script>

{% schema %}
{
  "name": "Product Tabs Slider",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "collection_tab",
      "name": "Collection Tab",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tab Title",
          "default": "New Arrivals"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "range",
          "id": "limit",
          "min": 4,
          "max": 16,
          "step": 4,
          "label": "Products to show",
          "default": 8
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Tabs Slider",
      "blocks": [
        {
          "type": "collection_tab",
          "settings": {
            "title": "New Arrivals"
          }
        },
        {
          "type": "collection_tab",
          "settings": {
            "title": "Best Sellers"
          }
        }
      ]
    }
  ]
}
{% endschema %}

