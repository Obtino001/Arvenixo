  "name": "Trust Badges",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "page_width",
      "label": "Page Width",
      "options": [
        { "value": "max-w-screen-xl", "label": "Standard" },
        { "value": "max-w-[1440px]", "label": "Wide" },
        { "value": "max-w-screen-full", "label": "Full Width" }
