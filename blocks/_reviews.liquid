
{%- assign block_settings = block.settings -%}


<div class="trustpilot-wrapper" style="
  padding-top: {{ block_settings.padding_top }}px;
  padding-bottom: {{ block_settings.padding_bottom }}px;
  padding-left: {{ block_settings.padding_left }}px;
  padding-right: {{ block_settings.padding_right }}px;
  text-align: {{ block_settings.alignment }};
  --color-text: #000;
  --color-icon: {{ block_settings.icon_color }};
  --font-size: {{ block_settings.font_size }}px;
" {{ section.shopify_attributes }}>

  <div class="trustpilot-container">
    <div class="stars-row">
      {%- comment -%} Star 1 {%- endcomment -%}
      <svg height="18" width="18" viewBox="0 0 30 30"><path d="M28 30H2c-1.1 0-2-.9-2-2V2C0 .9.9 0 2 0h26c1.1 0 2 .9 2 2v26c0 1.1-.9 2-2 2z" fill="var(--color-icon)"></path><path d="M24.4 12.7c-.2-.5-.6-.9-1.1-1l-4.9-.7-2.1-4.3c-.4-.7-1.3-.9-2-.5-.2.1-.4.3-.5.5l-2.2 4.4-4.8.7c-.8.1-1.3.8-1.2 1.6 0 .3.2.6.4.8l3.5 3.4-.8 4.8c-.1.8.4 1.5 1.2 1.6.3.1.6 0 .9-.1l4.3-2.3 4.3 2.2c.7.4 1.5.1 1.9-.6.1-.3.2-.6.1-.9l-.8-4.8 3.5-3.4c.3-.3.4-.9.3-1.4z" fill="#fff"></path></svg>
      {%- comment -%} Star 2 {%- endcomment -%}
      <svg height="18" width="18" viewBox="0 0 30 30"><path d="M28 30H2c-1.1 0-2-.9-2-2V2C0 .9.9 0 2 0h26c1.1 0 2 .9 2 2v26c0 1.1-.9 2-2 2z" fill="var(--color-icon)"></path><path d="M24.4 12.7c-.2-.5-.6-.9-1.1-1l-4.9-.7-2.1-4.3c-.4-.7-1.3-.9-2-.5-.2.1-.4.3-.5.5l-2.2 4.4-4.8.7c-.8.1-1.3.8-1.2 1.6 0 .3.2.6.4.8l3.5 3.4-.8 4.8c-.1.8.4 1.5 1.2 1.6.3.1.6 0 .9-.1l4.3-2.3 4.3 2.2c.7.4 1.5.1 1.9-.6.1-.3.2-.6.1-.9l-.8-4.8 3.5-3.4c.3-.3.4-.9.3-1.4z" fill="#fff"></path></svg>
      {%- comment -%} Star 3 {%- endcomment -%}
      <svg height="18" width="18" viewBox="0 0 30 30"><path d="M28 30H2c-1.1 0-2-.9-2-2V2C0 .9.9 0 2 0h26c1.1 0 2 .9 2 2v26c0 1.1-.9 2-2 2z" fill="var(--color-icon)"></path><path d="M24.4 12.7c-.2-.5-.6-.9-1.1-1l-4.9-.7-2.1-4.3c-.4-.7-1.3-.9-2-.5-.2.1-.4.3-.5.5l-2.2 4.4-4.8.7c-.8.1-1.3.8-1.2 1.6 0 .3.2.6.4.8l3.5 3.4-.8 4.8c-.1.8.4 1.5 1.2 1.6.3.1.6 0 .9-.1l4.3-2.3 4.3 2.2c.7.4 1.5.1 1.9-.6.1-.3.2-.6.1-.9l-.8-4.8 3.5-3.4c.3-.3.4-.9.3-1.4z" fill="#fff"></path></svg>
      {%- comment -%} Star 4 {%- endcomment -%}
      <svg height="18" width="18" viewBox="0 0 30 30"><path d="M28 30H2c-1.1 0-2-.9-2-2V2C0 .9.9 0 2 0h26c1.1 0 2 .9 2 2v26c0 1.1-.9 2-2 2z" fill="var(--color-icon)"></path><path d="M24.4 12.7c-.2-.5-.6-.9-1.1-1l-4.9-.7-2.1-4.3c-.4-.7-1.3-.9-2-.5-.2.1-.4.3-.5.5l-2.2 4.4-4.8.7c-.8.1-1.3.8-1.2 1.6 0 .3.2.6.4.8l3.5 3.4-.8 4.8c-.1.8.4 1.5 1.2 1.6.3.1.6 0 .9-.1l4.3-2.3 4.3 2.2c.7.4 1.5.1 1.9-.6.1-.3.2-.6.1-.9l-.8-4.8 3.5-3.4c.3-.3.4-.9.3-1.4z" fill="#fff"></path></svg>
      {%- comment -%} Star 5 (Half/Mixed) {%- endcomment -%}
      <svg height="18" width="18" viewBox="0 0 30 30"><path d="M15 30H2c-1.1 0-2-.9-2-2V2C0 .9.9 0 2 0h13" fill="var(--color-icon)"></path><path d="M15 0h13c1.1 0 2 .9 2 2v26c0 1.1-.9 2-2 2H15" fill="#b5b5b5"></path><path d="M24.4 12.7c-.2-.5-.6-.9-1.1-1l-4.9-.7-2.1-4.3c-.4-.7-1.3-.9-2-.5-.2.1-.4.3-.5.5l-2.2 4.4-4.8.7c-.8.1-1.3.8-1.2 1.6 0 .3.2.6.4.8l3.5 3.4-.8 4.8c-.1.8.4 1.5 1.2 1.6.3.1.6 0 .9-.1l4.3-2.3 4.3 2.2c.7.4 1.5.1 1.9-.6.1-.3.2-.6.1-.9l-.8-4.8 3.5-3.4c.3-.3.4-.9.3-1.4z" fill="#fff"></path></svg>
      
      <p class="trust-text">{{ block_settings.text }}</p>
    </div>
  </div>

</div>

<style>
  .trustpilot-wrapper {
    width: 100%;
  }
  .trustpilot-container {
    display: flex;
    justify-content: {% if block_settings.alignment == 'center' %}center{% elsif block_settings.alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
  }
  .stars-row {
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }
  .trust-text {
    margin: 0 0 0 6px;
    font-size: var(--font-size);
    color: var(--color-text);
    line-height: 1;
  }
</style>

{% schema %}
{
  "name": "Trustpilot Icon",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "4.7 ud af 5 stjerner"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon & Text Color",
      "default": "#00b67a"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font Size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top Padding",
      "default": 5
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 5
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Left Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Right Padding",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Trustpilot Icon"
    }
  ]
}
{% endschema %}