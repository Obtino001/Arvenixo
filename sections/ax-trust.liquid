<section class="ax-trust">
  <div class="ax-wrap">
    <div class="ax-trust__grid">
      {%- for block in section.blocks -%}
        <div class="ax-trust__item" {{ block.shopify_attributes }}>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AX Trust row",
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AX Trust row",
      "blocks": [
        { "type": "item", "settings": { "title": "Free shipping", "text": "On qualifying orders." } },
        { "type": "item", "settings": { "title": "30-day returns", "text": "No fuss, no drama." } },
        { "type": "item", "settings": { "title": "Secure checkout", "text": "Encrypted payments." } },
        { "type": "item", "settings": { "title": "Built to last", "text": "Materials chosen for daily use." } }
      ]
    }
  ]
}
{% endschema %}
