{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="benefit-tabs section-{{ section.id }}-padding" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <section class="benefit-tabs__grid" data-scroll-slider="" style="position:relative;z-index:1;">
    <div class="benefit-tabs__image-col">
      <main class="benefit-tabs__slider-wrapper">
        <div class="benefit-tabs__slides-container" data-scroll-container="" tabindex="0">
          {%- for block in section.blocks -%}
            <figure class="benefit-tabs__slide{% if forloop.first %} active{% endif %}" data-scroll-item="" {{ block.shopify_attributes }}>
              <div class="benefit-tabs__slide-image">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 800 | image_tag:
                    srcset: block.settings.image | image_url: width: 400 | append: ' 400w, ' | append: block.settings.image | image_url: width: 600 | append: ' 600w, ' | append: block.settings.image | image_url: width: 800 | append: ' 800w',
                    sizes: '(max-width: 1024px) 100vw, 50vw',
                    alt: block.settings.title,
                    loading: 'lazy'
                  }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'benefit-tabs__placeholder' }}
                {%- endif -%}
              </div>
              <figcaption class="benefit-tabs__slide-caption">
                <div class="benefit-tabs__title"><p>{{ block.settings.title }}</p></div>
                <div class="benefit-tabs__content"><p>{{ block.settings.description }}</p></div>
              </figcaption>
            </figure>
          {%- endfor -%}
        </div>
        <div data-scroll-controls="" class="benefit-tabs__dots">
          {%- for block in section.blocks -%}
            <button class="benefit-tabs__dot{% if forloop.first %} active{% endif %}" type="button" data-scroll-tab-button="{{ forloop.index0 }}">
              <span class="benefit-tabs__dot-inner"></span>
            </button>
          {%- endfor -%}
        </div>
      </main>
    </div>
    <div class="benefit-tabs__content-col {{ section.settings.content_order }}">
      <div class="benefit-tabs__desktop-content">
        {%- for block in section.blocks -%}
          <button class="benefit-tabs__text-btn{% if forloop.first %} active{% endif %}" type="button" data-scroll-tab-button="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <div class="benefit-tabs__title"><p>{{ block.settings.title }}</p></div>
            <div class="benefit-tabs__content"><p>{{ block.settings.description }}</p></div>
          </button>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

<style>
  .benefit-tabs {
    width: 100%;
    overflow-x: hidden;
    box-sizing: border-box;
  }

  .benefit-tabs__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
    width: 100%;
    box-sizing: border-box;
  }

  @media screen and (min-width: 1024px) {
    .benefit-tabs__grid {
      grid-template-columns: 1fr 1fr;
      gap: 48px;
      padding: 0 40px;
    }
  }

  .benefit-tabs__image-col {
    position: relative;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    box-sizing: border-box;
  }

  .benefit-tabs__slider-wrapper {
    position: relative;
    display: flex;
    justify-content: center;
    flex-direction: column;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .benefit-tabs__slides-container {
    display: flex;
    gap: 32px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 16px;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .benefit-tabs__slides-container::-webkit-scrollbar {
    display: none;
  }

  .benefit-tabs__dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 16px;
  }

  .benefit-tabs__content-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
    max-width: 600px;
    margin: 0 auto;
  }

  .benefit-tabs__content-col.-order-1 {
    order: -1;
  }

  .benefit-tabs__content-col.order-2 {
    order: 2;
  }

  .benefit-tabs__desktop-content {
    display: none;
  }

  @media screen and (min-width: 1024px) {
    .benefit-tabs__desktop-content {
      display: grid;
      gap: 20px;
      justify-content: center;
      align-items: start;
    }
  }

  /* Slide items */
  .benefit-tabs__slide {
    flex: 0 0 100%;
    min-width: 100%;
    max-width: 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    transition: all 0.3s ease;
    width: 100%;
    box-sizing: border-box;
  }

  .benefit-tabs__slide-image {
    position: relative;
    padding-bottom: 100%;
    width: 100%;
    overflow: hidden;
    border-radius: 8px;
    background: #f5f5f5;
  }

  @media screen and (max-width: 749px) {
    .benefit-tabs__slide-image {
      width: 90%;
      padding-bottom: 90%;
      margin: 0 auto;
    }
  }

  .benefit-tabs__slide-image img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .benefit-tabs__slide-caption {
    text-align: center;
    margin-top: 16px;
    overflow: visible;
  }

  @media screen and (max-width: 749px) {
    .benefit-tabs__grid {
      padding: 0 16px;
      max-width: 100vw;
      width: 100%;
    }

    .benefit-tabs__image-col {
      width: 100%;
      max-width: 100%;
      overflow: hidden;
    }

    .benefit-tabs__slider-wrapper {
      width: 100%;
      max-width: 100%;
    }

    .benefit-tabs__slides-container {
      width: 100%;
      max-width: 100%;
    }

    .benefit-tabs__slide {
      width: 100%;
      max-width: 100%;
      flex: 0 0 100%;
      min-width: 100%;
    }

    .benefit-tabs__slide-caption {
      width: 100%;
      max-width: 100%;
      margin-left: auto;
      margin-right: auto;
      padding: 0 10px;
      box-sizing: border-box;
      overflow-wrap: break-word;
      word-wrap: break-word;
    }

    .benefit-tabs__title,
    .benefit-tabs__content {
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
      overflow-wrap: break-word;
      word-wrap: break-word;
    }

    .benefit-tabs__title {
      font-size: 18px !important;
      line-height: 1.3 !important;
    }

    .benefit-tabs__content {
      font-size: 14px !important;
      line-height: 1.4 !important;
    }
  }

  @media screen and (min-width: 1024px) {
    .benefit-tabs__slide-caption {
      display: none;
    }
  }

  /* Desktop text buttons */
  .benefit-tabs__text-btn {
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    padding: 8px 0 8px 40px;
    position: relative;
    opacity: 0.4;
    transition: opacity 0.2s ease;
    width: 100%;
    color: inherit;
  }

  .benefit-tabs__text-btn:hover,
  .benefit-tabs__text-btn:focus {
    opacity: 0.7;
  }

  .benefit-tabs__text-btn.active {
    opacity: 1;
  }

  .benefit-tabs__text-btn::before {
    content: '';
    position: absolute;
    left: 0;
    top: 24px;
    width: 0;
    height: 0;
    border-left: 12px solid currentColor;
    border-top: 7px solid transparent;
    border-bottom: 7px solid transparent;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .benefit-tabs__text-btn.active::before {
    opacity: 1;
  }

  .benefit-tabs__title {
    font-size: 20px;
    font-weight: 700;
    margin: 0 0 8px 0;
    line-height: 1.2;
  }

  .benefit-tabs__title h1,
  .benefit-tabs__title h2,
  .benefit-tabs__title h3,
  .benefit-tabs__title h4,
  .benefit-tabs__title h5,
  .benefit-tabs__title h6,
  .benefit-tabs__title p {
    margin: 0;
  }

  .benefit-tabs__content {
    font-size: 15px;
    line-height: 1.6;
    opacity: 0.8;
  }

  .benefit-tabs__content p {
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .benefit-tabs__title {
      font-size: 26px;
    }

    .benefit-tabs__content {
      font-size: 16px;
    }
  }

  /* Dot navigation */
  .benefit-tabs__dot {
    padding: 8px;
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    opacity: 0.5;
    transition: opacity 0.2s ease;
  }

  .benefit-tabs__dot:hover,
  .benefit-tabs__dot:focus {
    opacity: 0.7;
  }

  .benefit-tabs__dot.active {
    opacity: 1;
  }

  .benefit-tabs__dot-inner {
    height: 4px;
    width: 40px;
    background: currentColor;
    border-radius: 2px;
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .benefit-tabs__dot:hover .benefit-tabs__dot-inner,
  .benefit-tabs__dot.active .benefit-tabs__dot-inner {
    opacity: 1;
  }

  /* Placeholder */
  .benefit-tabs__placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e0e0e0;
    color: #999;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sliders = document.querySelectorAll('[data-scroll-slider]');

    sliders.forEach(slider => {
      const container = slider.querySelector('[data-scroll-container]');
      const dots = slider.querySelectorAll('[data-scroll-tab-button]');
      const textBtns = slider.querySelectorAll('.benefit-tabs__text-btn');

      if (!container) return;

      const slides = container.querySelectorAll('.benefit-tabs__slide');

      function setActiveSlide(index) {
        const slide = slides[index];
        if (slide) {
          container.scrollTo({
            left: slide.offsetLeft,
            behavior: 'smooth'
          });
        }

        dots.forEach((dot, i) => {
          dot.classList.toggle('active', i === index);
        });

        textBtns.forEach((btn, i) => {
          btn.classList.toggle('active', i === index);
        });
      }

      dots.forEach((dot, index) => {
        dot.addEventListener('click', () => setActiveSlide(index));
      });

      textBtns.forEach((btn, index) => {
        btn.addEventListener('click', () => setActiveSlide(index));
      });

      let scrollTimeout;
      container.addEventListener('scroll', () => {
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => {
          const scrollLeft = container.scrollLeft;
          const slideWidth = slides[0]?.offsetWidth || 1;
          const activeIndex = Math.round(scrollLeft / slideWidth);

          dots.forEach((dot, i) => {
            dot.classList.toggle('active', i === activeIndex);
          });

          textBtns.forEach((btn, i) => {
            btn.classList.toggle('active', i === activeIndex);
          });
        }, 50);
      });
    });
  });
</script>

{% schema %}
{
  "name": "Benefit Tabs",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "content_order",
      "label": "Text Position",
      "options": [
        { "value": "-order-1", "label": "Left (Text First)" },
        { "value": "order-2", "label": "Right (Image First)" }
      ],
      "default": "-order-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "QUALITY FIRST."
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Premium materials crafted with precision."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefit Tabs",
      "blocks": [
        { "type": "tab", "settings": { "title": "MAGSAFE COMPATIBLE.", "description": "Designed to work with all MagSafe accessories." } },
        { "type": "tab", "settings": { "title": "QUALITY FIRST.", "description": "Premium, full-grain-leather, 316L stainless-steel buttons." } },
        { "type": "tab", "settings": { "title": "UNMATCHED PRECISION.", "description": "Designed and crafted with micro-precision technology." } },
        { "type": "tab", "settings": { "title": "Trusted by 100,000+ Customers", "description": "Described by many as the best of the best." } }
      ]
    }
  ]
}
{% endschema %}
