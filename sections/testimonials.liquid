{% style %}
  .custom-masonry-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  /* Header Styles */
  .masonry-header-{{ section.id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .masonry-header-stars {
    color: #1a1a1a;
    font-size: 20px;
    letter-spacing: 2px;
    margin-bottom: 10px;
    line-height: 1;
  }

  .masonry-header-title {
    font-family: var(--typeHeaderPrimary), var(--typeHeaderFallback);
    font-size: calc(var(--typeHeaderSize) * 1.2);
    text-transform: uppercase;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0;
  }

  /* Masonry Grid Setup */
  .masonry-grid-{{ section.id }} {
    column-count: 1;
    column-gap: 20px;
    max-width: 1400px;
    margin: 0 auto;
  }

  @media screen and (min-width: 768px) {
    .masonry-grid-{{ section.id }} {
      column-count: 2;
    }
  }

  @media screen and (min-width: 1024px) {
    .masonry-grid-{{ section.id }} {
      column-count: 4;
    }
  }

  .masonry-item-{{ section.id }} {
    break-inside: avoid;
    margin-bottom: 20px;
    border-radius: 8px;
    overflow: hidden;
  }

  /* Text Review Card */
  .review-card-{{ section.id }} {
    background-color: #ffffff;
    padding: 30px 25px;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .review-card-stars {
    color: #1a1a1a;
    font-size: 14px;
    letter-spacing: 2px;
    margin-bottom: 15px;
  }

  .review-card-text {
    font-size: 13px;
    line-height: 1.6;
    color: #333333;
    margin-bottom: 25px;
    flex-grow: 1;
  }

  .review-card-author {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #1a1a1a;
    margin: 0 0 5px 0;
  }

  .review-card-verified {
    display: flex;
    align-items: center;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #666666;
  }

  .review-card-verified svg {
    width: 12px;
    height: 12px;
    margin-right: 5px;
    fill: currentColor;
  }

  /* Image Card */
  .image-card-{{ section.id }} {
    width: 100%;
    display: block;
  }
  
  .image-card-{{ section.id }} img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  /* Footer Button */
  .masonry-footer-{{ section.id }} {
    text-align: center;
    margin-top: 30px;
  }

  .masonry-btn-{{ section.id }} {
    display: inline-block;
    background-color: #2b2b2b;
    color: #ffffff;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 16px 30px;
    text-decoration: none;
    border-radius: 2px;
    transition: background-color 0.2s ease;
  }

  .masonry-btn-{{ section.id }}:hover {
    background-color: #000000;
  }
{% endstyle %}

<div class="custom-masonry-{{ section.id }}">
  <div class="page-width">
    
    <div class="masonry-header-{{ section.id }}">
      {% if section.settings.show_header_stars %}
        <div class="masonry-header-stars">★★★★★</div>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="masonry-header-title">{{ section.settings.heading }}</h2>
      {% endif %}
    </div>

    <div class="masonry-grid-{{ section.id }}">
      {% for block in section.blocks %}
        <div class="masonry-item-{{ section.id }}" {{ block.shopify_attributes }}>
          
          {% case block.type %}
            {% when 'review' %}
              <div class="review-card-{{ section.id }}">
                <div class="review-card-stars">★★★★★</div>
                <div class="review-card-text">{{ block.settings.review_text }}</div>
                <p class="review-card-author">{{ block.settings.author_name }}</p>
                {% if block.settings.show_verified %}
                  <div class="review-card-verified">
                    <svg viewBox="0 0 24 24"><path d="M12 0c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm-1.25 17.292l-4.5-4.364 1.857-1.858 2.643 2.506 5.643-5.784 1.857 1.857-7.5 7.643z"/></svg>
                    VERIFIED BUYER
                  </div>
                {% endif %}
              </div>

            {% when 'image' %}
              <div class="image-card-{{ section.id }}">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy' }}
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
              </div>
          {% endcase %}
          
        </div>
      {% endfor %}
    </div>

    {% if section.settings.button_text != blank and section.settings.button_link != blank %}
      <div class="masonry-footer-{{ section.id }}">
        <a href="{{ section.settings.button_link }}" class="masonry-btn-{{ section.id }}">{{ section.settings.button_text }}</a>
      </div>
    {% endif %}

  </div>
</div>

{% schema %}
{
  "name": "Masonry Reviews",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f9f8f6"
    },
    {
      "type": "checkbox",
      "id": "show_header_stars",
      "label": "Show Header Stars",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "OVER 4,000,000+ PAIRS SOLD"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "READ MORE REVIEWS"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Text Review",
      "settings": [
        {
          "type": "richtext",
          "id": "review_text",
          "label": "Review Text",
          "default": "<p>I'm very happy with this purchase, they are a quality product. They feel great and are very comfortable.</p>"
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author Name",
          "default": "STEVE J"
        },
        {
          "type": "checkbox",
          "id": "show_verified",
          "label": "Show Verified Buyer",
          "default": true
        }
      ]
    },
    {
      "type": "image",
      "name": "Image Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Masonry Reviews",
      "blocks": [
        { "type": "review" },
        { "type": "image" },
        { "type": "image" },
        { "type": "review" },
        { "type": "image" },
        { "type": "review" },
        { "type": "image" },
        { "type": "image" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}