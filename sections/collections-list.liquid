{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    overflow: hidden; /* Prevents horizontal scrollbar on the whole page */
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .horizon-circular-collections {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
  }

  .horizon-circular-header {
    text-align: center;
    margin-bottom: 2rem;
    padding: 0 1.5rem;
  }

  .horizon-circular-header h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    margin: 0;
  }

  /* 📱 MOBILE SLIDER LOGIC (Scroll Snapping) */
  .horizon-circular-grid {
    display: flex;
    flex-wrap: nowrap;
    gap: 16px;
    padding: 0 1.5rem 1rem 1.5rem; /* Padding for mobile edges */
    overflow-x: auto;
    scroll-snap-type: x mandatory; /* Enables the snapping effect */
    -webkit-overflow-scrolling: touch; /* Smooth scrolling on iOS */
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE/Edge */
  }

  /* Hide scrollbar for Chrome/Safari */
  .horizon-circular-grid::-webkit-scrollbar {
    display: none; 
  }

  /* 💻 DESKTOP GRID LOGIC */
  @media screen and (min-width: 990px) {
    .horizon-circular-grid {
        gap: 50px;
      justify-content: center;
      flex-wrap: wrap; /* Allows wrapping on huge screens if needed */
      scroll-snap-type: none; /* Turn off snapping on desktop */
      overflow-x: visible;
    }
  }

  /* Card Styling */
  .horizon-circular-card {
    /* Shows roughly ~3.2 items on mobile so the user knows they can swipe */
    flex: 0 0 calc(30vw - 16px); 
    max-width: 65px; 
    min-width: 65px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: inherit;
    gap: 12px;
    scroll-snap-align: start; /* Snaps exactly to the left edge of the item */
  }

  @media screen and (min-width: 750px) {
    .horizon-circular-card {
      flex: 0 0 100px;
      max-width: 100px;
    }
  }

  .horizon-circular-image {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transform: translateZ(0); 
    transition: transform 0.3s ease-out;
    outline: 1px solid transparent;
    outline-offset: 3px;
  }

  .horizon-circular-card:hover .horizon-circular-image{
    outline: 1px solid currentColor;
    outline-offset: 3px;
    transition: all 0.3s ease-in-out;
  }

  .horizon-circular-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  

  .horizon-circular-title {
    font-size: 14px;
    font-weight: 500;
    text-align: center;
    line-height: 1.3;
    word-break: break-word;
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding">
  <div class="horizon-circular-collections">

    <div class="horizon-circular-grid">
      {%- for block in section.blocks -%}
        {%- assign collection = block.settings.collection -%}
        
        <a href="{{ collection.url | default: '#' }}" class="horizon-circular-card" {{ block.shopify_attributes }}>
          <div class="horizon-circular-image">
            {%- if block.settings.custom_asset_image != blank -%}
              <img src="{{ block.settings.custom_asset_image | asset_url }}" 
                   alt="{{ block.settings.custom_title | escape }}" 
                   loading="lazy" 
                   width="300" 
                   height="300">
            {%- elsif block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 300 }}" 
                   alt="{{ block.settings.image.alt | escape }}" 
                   loading="lazy" 
                   width="300" 
                   height="300">
            {%- elsif collection.image != blank -%}
              <img src="{{ collection.image | image_url: width: 300 }}" 
                   alt="{{ collection.image.alt | escape }}" 
                   loading="lazy" 
                   width="300" 
                   height="300">
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          
          <div class="horizon-circular-title">
            {%- if block.settings.custom_title != blank -%}
              {{ block.settings.custom_title }}
            {%- else -%}
              {{ collection.title | default: 'Collection name' }}
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Circular Category List",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image",
          "info": "Overrides the default collection image"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Title",
          "info": "Overrides the default collection title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Circular Category List",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}