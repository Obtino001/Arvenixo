<section class="ax-hero" style="min-height: {{ section.settings.min_height }}vh;">
  <div class="ax-hero__media" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', alt: '' }}
    {%- else -%}
      <img src="{{ 'ax-hero-lifestyle.png' | asset_url }}" alt="" width="1920" height="1080" loading="eager" fetchpriority="high">
    {%- endif -%}
  </div>
  <div class="ax-hero__overlay"></div>
  <div class="ax-hero__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="ax-hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="ax-hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="ax-hero__text">{{ section.settings.text }}</p>
    {%- endif -%}
    <div class="ax-hero__actions">
      {%- if section.settings.button_label != blank -%}
        <a class="ax-btn ax-btn--solid" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.button2_label != blank -%}
        <a class="ax-btn ax-btn--ghost" href="{{ section.settings.button2_link | default: routes.all_products_collection_url }}">{{ section.settings.button2_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AX Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "range", "id": "min_height", "min": 70, "max": 100, "step": 1, "unit": "vh", "label": "Height", "default": 88 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Arvenixo" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Carry lighter." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Precision MagSafe cases and beauty tech, made for everyday luxury." },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "Shop MagSafe" },
    { "type": "url", "id": "button_link", "label": "Primary link" },
    { "type": "text", "id": "button2_label", "label": "Secondary button", "default": "Explore beauty" },
    { "type": "url", "id": "button2_link", "label": "Secondary link" }
  ],
  "presets": [{ "name": "AX Hero" }]
}
{% endschema %}
