<div class="ax-foot">
  <div class="ax-foot__brand ax-wrap">
    {% render 'ax-logo' %}
  </div>
  <div class="ax-foot__top ax-wrap">
    {%- for i in (1..4) -%}
      {%- liquid
        case i
          when 1
            assign col_title = section.settings.col1_title
            assign col_menu = section.settings.col1_menu
            assign col_links = section.settings.col1_links
          when 2
            assign col_title = section.settings.col2_title
            assign col_menu = section.settings.col2_menu
            assign col_links = section.settings.col2_links
          when 3
            assign col_title = section.settings.col3_title
            assign col_menu = section.settings.col3_menu
            assign col_links = section.settings.col3_links
          when 4
            assign col_title = section.settings.col4_title
            assign col_menu = section.settings.col4_menu
            assign col_links = section.settings.col4_links
        endcase
      -%}
      <nav class="ax-foot__col" aria-label="{{ col_title | escape }}">
        {%- if col_title != blank -%}
          <h2>{{ col_title }}</h2>
        {%- endif -%}
        <ul>
          {%- if col_menu != blank -%}
            {%- for link in col_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- elsif col_links != blank -%}
            {%- assign rows = col_links | newline_to_br | split: '<br />' -%}
            {%- for row in rows -%}
              {%- assign parts = row | strip | split: '|' -%}
              {%- if parts[0] != blank -%}
                <li><a href="{{ parts[1] | default: '#' | strip }}">{{ parts[0] | strip }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </nav>
    {%- endfor -%}

    <div class="ax-foot__community">
      {%- if section.settings.community_title != blank -%}
        <h2>{{ section.settings.community_title }}</h2>
      {%- endif -%}
      {%- if section.settings.community_text != blank -%}
        <p>{{ section.settings.community_text }}</p>
      {%- endif -%}

      {% form 'customer', class: 'ax-foot__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="ax-foot-email-{{ section.id }}">Email</label>
        <input
          id="ax-foot-email-{{ section.id }}"
          type="email"
          name="contact[email]"
          placeholder="{{ section.settings.email_placeholder }}"
          required
          autocomplete="email"
        >
        <button type="submit" aria-label="Subscribe">→</button>
        {%- if form.posted_successfully? -%}
          <p class="ax-foot__ok">You're in. Check your inbox.</p>
        {%- endif -%}
      {% endform %}

      {%- if section.settings.follow_title != blank -%}
        <p class="ax-foot__follow">{{ section.settings.follow_title }}</p>
      {%- endif -%}
      <div class="ax-foot__social">
        {%- if section.settings.instagram != blank -%}
          <a href="{{ section.settings.instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="17.4" cy="6.6" r="1" fill="currentColor"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.facebook != blank -%}
          <a href="{{ section.settings.facebook }}" target="_blank" rel="noopener" aria-label="Facebook">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M14.5 8.5V6.8c0-.7.5-1.3 1.2-1.3H17V3h-2.2C12.3 3 11 4.5 11 6.6v1.9H9v2.6h2V21h3.5v-9.9h2.3l.4-2.6h-2.7z"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.linkedin != blank -%}
          <a href="{{ section.settings.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.5 9H4v11h2.5V9zM5.2 3.5A1.6 1.6 0 1 0 5.2 6.7 1.6 1.6 0 0 0 5.2 3.5zM20 20h-2.5v-5.5c0-1.5-.5-2.5-1.8-2.5-1 0-1.5.7-1.8 1.3-.1.2-.1.6-.1.9V20H11s.1-9.2 0-10.1h2.5v1.4c.4-.6 1.1-1.6 2.8-1.6 2 0 3.7 1.3 3.7 4.2V20z"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.tiktok != blank -%}
          <a href="{{ section.settings.tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M14.2 3v11.1a3.2 3.2 0 1 1-2.7-3.2V8.4a5.7 5.7 0 1 0 5.2 5.7V8.6A7 7 0 0 0 21 10V6.7a7 7 0 0 1-4.3-1.5A7 7 0 0 1 14.2 3z"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.threads != blank -%}
          <a href="{{ section.settings.threads }}" target="_blank" rel="noopener" aria-label="Threads">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.6" d="M8.2 8.4c2.8-3.6 9.3-2.4 9.3 3.2 0 5.2-4.4 8.2-8.5 8.2-5.2 0-7.3-3.4-7.3-6.4 0-5.7 5.6-8 9.3-8 3.2 0 6.3 1.3 7.2 4.4"/><path fill="none" stroke="currentColor" stroke-width="1.6" d="M9.6 12.4c.3 3.2 5.2 3.4 5.6-.2.3-2.6-1.7-3.4-3.5-3.4-2.4 0-3.3 1.5-3.3 2.8 0 2.6 2.8 3.2 5.1 3.2"/></svg>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="ax-foot__bar">
    <div class="ax-foot__bar-inner ax-wrap">
      <div class="ax-foot__locale">
        {% form 'localization', id: 'ax-footer-localization' %}
          <input type="hidden" name="language_code" value="{{ localization.language.iso_code }}">
          <label class="visually-hidden" for="ax-footer-country">Country/region</label>
          <select
            name="country_code"
            id="ax-footer-country"
            onchange="this.form.submit()"
          >
            {%- for country in localization.available_countries -%}
              <option
                value="{{ country.iso_code }}"
                {% if country.iso_code == localization.country.iso_code %}selected{% endif %}
              >
                {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
              </option>
            {%- endfor -%}
          </select>
        {% endform %}
      </div>

      <p class="ax-foot__legal">
        © {{ 'now' | date: '%Y' }} {{ shop.name }} — ALL RIGHTS RESERVED
        {%- for policy in shop.policies -%}
          {%- if policy != blank -%}
            <span aria-hidden="true"> | </span>
            <a href="{{ policy.url }}">{{ policy.title }}</a>
          {%- endif -%}
        {%- endfor -%}
      </p>

      <div class="ax-foot__pay">
        <span>{{ section.settings.pay_label }}</span>
        <ul>
          {%- assign pay_types = shop.enabled_payment_types -%}
          {%- if pay_types.size == 0 -%}
            {%- assign pay_types = 'american_express,apple_pay,google_pay,master,paypal,shopify_pay,unionpay,visa' | split: ',' -%}
          {%- endif -%}
          {%- for type in pay_types limit: 8 -%}
            <li>{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "AX Footer",
  "class": "ax-footer-section",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "text", "id": "col1_title", "label": "Column 1 title", "default": "Support" },
    { "type": "link_list", "id": "col1_menu", "label": "Column 1 menu" },
    { "type": "textarea", "id": "col1_links", "label": "Column 1 fallback links", "info": "One per line: Label|/path", "default": "Shipping Info|/policies/shipping-policy\nReturns|/policies/refund-policy\nWarranty|#\nHelp Center|/pages/contact\nGift Card|/products" },
    { "type": "text", "id": "col2_title", "label": "Column 2 title", "default": "About" },
    { "type": "link_list", "id": "col2_menu", "label": "Column 2 menu" },
    { "type": "textarea", "id": "col2_links", "label": "Column 2 fallback links", "default": "Our Story|/pages/about\nJournal|/blogs/news\nSustainability|/pages/sustainability" },
    { "type": "text", "id": "col3_title", "label": "Column 3 title", "default": "Contact" },
    { "type": "link_list", "id": "col3_menu", "label": "Column 3 menu" },
    { "type": "textarea", "id": "col3_links", "label": "Column 3 fallback links", "default": "Customer Service|/pages/contact\nPress|/pages/contact\nWholesale|/pages/contact\nCareers|/pages/contact" },
    { "type": "text", "id": "col4_title", "label": "Column 4 title", "default": "Explore" },
    { "type": "link_list", "id": "col4_menu", "label": "Column 4 menu" },
    { "type": "textarea", "id": "col4_links", "label": "Column 4 fallback links", "default": "Shop All Products|/collections/all\nMagSafe|/collections/all\nBeauty Tech|/collections/all" },
    { "type": "header", "content": "Community" },
    { "type": "text", "id": "community_title", "label": "Heading", "default": "Join our community" },
    { "type": "textarea", "id": "community_text", "label": "Text", "default": "Subscribe to receive first-hand brand updates, access to exclusive deals, and 15% discount off your first order." },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "Your e-mail" },
    { "type": "text", "id": "follow_title", "label": "Follow heading", "default": "Follow us" },
    { "type": "url", "id": "instagram", "label": "Instagram" },
    { "type": "url", "id": "facebook", "label": "Facebook" },
    { "type": "url", "id": "linkedin", "label": "LinkedIn" },
    { "type": "url", "id": "tiktok", "label": "TikTok" },
    { "type": "url", "id": "threads", "label": "Threads" },
    { "type": "text", "id": "pay_label", "label": "Payments label", "default": "We accept" }
  ],
  "presets": [{ "name": "AX Footer" }]
}
{% endschema %}
