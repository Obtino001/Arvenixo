{%- if section.settings.enable_popup -%}
<style>
  .newsletter-popup-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0,0,0,0.5);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .newsletter-popup-overlay.show {
    opacity: 1;
    visibility: visible;
  }
  .newsletter-popup-modal {
    background: #fff;
    width: 90%;
    max-width: 800px;
    height: 500px;
    display: flex;
    flex-direction: row;
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    transform: translateY(20px);
    transition: transform 0.3s ease;
  }
  .newsletter-popup-overlay.show .newsletter-popup-modal {
    transform: translateY(0);
  }
  .newsletter-popup-close {
    position: absolute;
    top: 15px;
    right: 15px;
    background: none;
    border: none;
    font-size: 24px;
    cursor: pointer;
    color: #000;
    z-index: 10;
  }
  .newsletter-popup-image {
    flex: 1;
    background-size: cover;
    background-position: center;
    background-color: #f4f4f4;
  }
  .newsletter-popup-content {
    flex: 1;
    padding: 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
  }
  .newsletter-popup-content h2 {
    font-size: 32px;
    margin: 0 0 10px;
    font-weight: bold;
    color: #000;
  }
  .newsletter-popup-content p {
    font-size: 14px;
    color: #555;
    margin-bottom: 20px;
  }
  .newsletter-popup-form {
    width: 100%;
  }
  .newsletter-popup-form input[type="email"] {
    width: 100%;
    padding: 12px;
    border: 1px solid #ccc;
    margin-bottom: 15px;
    border-radius: 4px;
  }
  .newsletter-popup-form button {
    width: 100%;
    padding: 15px;
    background: #000;
    color: #fff;
    border: none;
    font-weight: bold;
    cursor: pointer;
    border-radius: 4px;
    text-transform: uppercase;
  }
  .newsletter-popup-form button:hover {
    background: #333;
  }
  .newsletter-popup-dismiss {
    margin-top: 15px;
    font-size: 12px;
    color: #888;
    text-decoration: underline;
    cursor: pointer;
    background: none;
    border: none;
  }
  .newsletter-popup-disclaimer {
    font-size: 10px;
    color: #aaa;
    margin-top: 20px;
  }
  @media (max-width: 767px) {
    .newsletter-popup-modal {
      flex-direction: column;
      height: auto;
      max-height: 90vh;
      overflow-y: auto;
    }
    .newsletter-popup-image {
      min-height: 200px;
    }
    .newsletter-popup-content {
      padding: 30px 20px;
    }
  }
</style>

<div class="newsletter-popup-overlay" id="NewsletterPopup">
  <div class="newsletter-popup-modal">
    <button class="newsletter-popup-close" id="NewsletterPopupClose">&times;</button>
    <div class="newsletter-popup-image" style="background-image: url('{{ section.settings.image | image_url: width: 800 }}');"></div>
    <div class="newsletter-popup-content">
      {%- if section.settings.logo_text != blank -%}
        <div style="font-weight: bold; margin-bottom: 20px; font-size: 18px;">{{ section.settings.logo_text }}</div>
      {%- endif -%}
      
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      
      {% form 'customer', class: 'newsletter-popup-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter, popup">
        <input type="email" name="contact[email]" placeholder="Email" required>
        <button type="submit">{{ section.settings.button_label }}</button>
      {% endform %}
      
      <button class="newsletter-popup-dismiss" id="NewsletterPopupDismiss">{{ section.settings.dismiss_text }}</button>
      
      <div class="newsletter-popup-disclaimer">
        {{ section.settings.disclaimer }}
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var popup = document.getElementById('NewsletterPopup');
    if (!popup) return;
    var closeBtn = document.getElementById('NewsletterPopupClose');
    var dismissBtn = document.getElementById('NewsletterPopupDismiss');
    
    // Check if popup has been seen
    if (!localStorage.getItem('newsletter_popup_seen')) {
      var delay = {{ section.settings.delay }} * 1000;
      setTimeout(function() {
        popup.classList.add('show');
      }, delay);
    }
    
    function closePopup() {
      popup.classList.remove('show');
      localStorage.setItem('newsletter_popup_seen', 'true');
    }
    
    if (closeBtn) closeBtn.addEventListener('click', closePopup);
    if (dismissBtn) dismissBtn.addEventListener('click', closePopup);
    
    // Close on outside click
    popup.addEventListener('click', function(e) {
      if (e.target === popup) {
        closePopup();
      }
    });

    // If form is submitted successfully, set local storage
    var form = popup.querySelector('form');
    if (form) {
      form.addEventListener('submit', function() {
        localStorage.setItem('newsletter_popup_seen', 'true');
      });
    }
  });
</script>
{%- endif -%}

{% schema %}
{
  "name": "Newsletter Popup",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_popup",
      "label": "Enable Popup",
      "default": true
    },
    {
      "type": "range",
      "id": "delay",
      "min": 1,
      "max": 30,
      "step": 1,
      "unit": "sec",
      "label": "Delay before showing",
      "default": 3
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo \/ Brand Text",
      "default": "Arvenixo"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "15% OFF"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Save on your first order:"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "GET MY CODE"
    },
    {
      "type": "text",
      "id": "dismiss_text",
      "label": "Dismiss Text",
      "default": "No thanks, I'll pay full price"
    },
    {
      "type": "richtext",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "<p>By clicking the link above you agree to receive our newsletter. You can unsubscribe at any time.<\/p>"
    }
  ],
  "presets": [
    {
      "name": "Newsletter Popup"
    }
  ]
}
{% endschema %}
