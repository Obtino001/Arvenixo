{% doc %}
  Renders the search modal dialog with predictive search.

  @param {block} [block] - The block object, used for Shopify editor attributes.
  @param {string} [class] - Additional CSS classes to apply to the predictive search component.
{% enddoc %}

{% render 'pills-styles' %}
{% render 'dialog-styles' %}
{% render 'predictive-search-styles' %}

<script src="{{ 'dialog.js' | asset_url }}" type="module"></script>
<script src="{{ 'predictive-search.js' | asset_url }}" type="module" fetchpriority="low"></script>

<dialog-component id="search-modal" class="search-modal" {{ block.shopify_attributes }}>
  <dialog
    ref="dialog"
    on:click="/closeDialogOnClickOutside"
    on:keydown="/closeDialogOnEscapePress"
    class="search-modal__content dialog-modal overflow-hidden shadow-2xl"
    scroll-lock
    aria-labelledby="search-modal-heading"
    style="width: 95vw !important; max-width: 1200px !important; height: auto !important; max-height: 85dvh !important; margin: auto !important; margin-top: 5dvh !important; border-radius: 8px !important; border: none !important; padding: 0 !important; background-color: #f5f5f7 !important;"
  >
    <style>
      #search-modal dialog::backdrop {
        background: rgba(0, 0, 0, 0.6) !important;
        backdrop-filter: blur(4px) !important;
      }
    </style>
    <h2 id="search-modal-heading" class="visually-hidden">{{ 'content.search' | t }}</h2>
    
    <predictive-search-component
      class="predictive-search w-full h-full flex flex-col{% if class != blank %} {{ class | strip }}{% endif %}"
      data-section-id="predictive-search"
      data-testid="{{ 'search-component--modal' }}"
      role="search"
      aria-label="{{ 'content.search_input_label' | t }}"
    >
      <div class="search-modal modal__content py-7 sm:py-10 lg:py-12 bg-[#f5f5f7] w-full h-full flex flex-col">
        <div class="h-full overflow-y-auto">
          
          <!-- SEARCH INPUT HEADER -->
          <div class="search-modal__content px-6 sm:px-10 lg:px-0 border-gray-300" tabindex="-1">
            <div class="w-full lg:w-11/12 xl:w-5/6 max-w-screen-full mx-auto pb-4 sm:pb-5 border-b border-gray-300 flex justify-between items-center relative">
              
              <form action="{{ routes.search_url }}" method="get" role="search" class="search w-full relative z-10" ref="form" on:keydown="/onSearchKeyDown">
                <div class="w-full flex justify-between items-center space-x-3 sm:space-x-4 lg:space-x-5">
                  <button type="submit" class="search__button h-6 w-6 text-black" aria-label="Search">
                    <svg xmlns="http://www.w3.org/2000/svg" class="block w-full h-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                  </button>
                  <input
                    class="search-input w-full text-[16px] sm:text-[18px] lg:text-[20px] xl:text-[24px] bg-transparent outline-none border-none shadow-none text-black placeholder:text-gray-400 font-light"
                    id="Search-In-Modal"
                    type="search"
                    name="q"
                    role="combobox"
                    aria-expanded="false"
                    aria-owns="predictive-search-results"
                    aria-controls="predictive-search-results"
                    aria-haspopup="listbox"
                    aria-autocomplete="list"
                    autocomplete="off"
                    autocorrect="off"
                    autocapitalize="off"
                    spellcheck="false"
                    placeholder="Search"
                    ref="searchInput"
                    on:input="/search"
                    on:keydown="/onSearchKeyDown"
                  >
                  <input name="options[prefix]" type="hidden" value="last">
                  
                  <!-- Loading State (managed by predictive search JS) -->
                  <div class="hidden">
                    <button type="button" class="predictive-search__reset-button" ref="resetButton" hidden on:click="/resetSearch">Clear</button>
                  </div>
                </div>
              </form>
              
              <button type="button" aria-label="Close" class="search-modal__close-button ml-6 sm:ml-8 p-2 rounded-full hover:bg-gray-200 transition-colors" on:click="dialog-component/closeDialog">
                <svg aria-hidden="true" focusable="false" width="16" height="16" class="icon icon-close" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 4L4 12M4 4L12 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          </div>
          
          <!-- PREDICTIVE SEARCH RESULTS CONTAINER -->
          <div class="predictive-search-form__content w-full pb-10" ref="predictiveSearchResults" on:click="/handleModalClick"></div>

          <!-- STATIC CONTENT BODY -->
          <div class="static-search-content p-6 sm:px-10 lg:px-0 bg-[#f5f5f7]">
            <div class="w-full lg:w-11/12 xl:w-5/6 max-w-screen-full mx-auto">
              
              <!-- Frequency Terms -->
              <div class="md:flex justify-between items-start md:space-x-6 lg:space-x-8">
                <h4 class="md:w-32 flex-shrink-0 text-[14px] sm:text-[16px] leading-none mb-5 sm:mb-6 md:mb-0 font-medium">
                  Frequency Terms
                </h4>
                <div class="flex-1 flex flex-wrap text-[13px] sm:text-[14px] lg:text-[16px]">
                  {%- if section.settings.frequency_menu != blank -%}
                    {%- for link in section.settings.frequency_menu.links -%}
                      <a href="{{ link.url }}" class="block w-max px-4 py-2 mb-3 mr-3 sm:mr-4 bg-[#e5e5ea] hover:bg-[#d1d1d6] transition-colors rounded-full text-gray-700 font-light">{{ link.title }}</a>
                    {%- endfor -%}
                  {%- else -%}
                    <a href="/search?q=google-pixel-11" class="block w-max px-4 py-2 mb-3 mr-3 sm:mr-4 bg-[#e5e5ea] hover:bg-[#d1d1d6] transition-colors rounded-full text-gray-700 font-light">Google Pixel 11</a>
                    <a href="/search?q=galaxy-z-fold8" class="block w-max px-4 py-2 mb-3 mr-3 sm:mr-4 bg-[#e5e5ea] hover:bg-[#d1d1d6] transition-colors rounded-full text-gray-700 font-light">Galaxy Z Fold8</a>
                    <a href="/search?q=galaxy-z-fold8-ultra" class="block w-max px-4 py-2 mb-3 mr-3 sm:mr-4 bg-[#e5e5ea] hover:bg-[#d1d1d6] transition-colors rounded-full text-gray-700 font-light">Galaxy Z Fold8 Ultra</a>
                    <a href="/search?q=galaxy-s26-ultra" class="block w-max px-4 py-2 mb-3 mr-3 sm:mr-4 bg-[#e5e5ea] hover:bg-[#d1d1d6] transition-colors rounded-full text-gray-700 font-light">Galaxy S26 Ultra</a>
                    <a href="/search?q=iphone-air" class="block w-max px-4 py-2 mb-3 mr-3 sm:mr-4 bg-[#e5e5ea] hover:bg-[#d1d1d6] transition-colors rounded-full text-gray-700 font-light">iPhone Air</a>
                    <a href="/search?q=iphone-17-pro-max" class="block w-max px-4 py-2 mb-3 mr-3 sm:mr-4 bg-[#e5e5ea] hover:bg-[#d1d1d6] transition-colors rounded-full text-gray-700 font-light">iPhone 17 Pro Max</a>
                    <a href="/search?q=iphone-17-pro" class="block w-max px-4 py-2 mb-3 mr-3 sm:mr-4 bg-[#e5e5ea] hover:bg-[#d1d1d6] transition-colors rounded-full text-gray-700 font-light">iPhone 17 Pro</a>
                    <a href="/search?q=wallet" class="block w-max px-4 py-2 mb-3 mr-3 sm:mr-4 bg-[#e5e5ea] hover:bg-[#d1d1d6] transition-colors rounded-full text-gray-700 font-light">Wallet</a>
                    <a href="/search?q=power-bank" class="block w-max px-4 py-2 mb-3 mr-3 sm:mr-4 bg-[#e5e5ea] hover:bg-[#d1d1d6] transition-colors rounded-full text-gray-700 font-light">Power Bank</a>
                  {%- endif -%}
                </div>
              </div>
              
              <!-- Top Picks -->
              <div class="md:flex md:space-x-6 lg:space-x-8 mt-10 lg:mt-14">
                <h4 class="md:w-32 flex-shrink-0 pb-2 border-b border-gray-300 md:border-b-0 md:border-r text-[14px] sm:text-[16px] leading-none mb-5 sm:mb-6 md:mb-0 font-medium">
                  Top Picks
                </h4>
                <div class="flex-1 flex flex-wrap gap-y-6 sm:gap-y-8 lg:gap-y-10 justify-between text-[12px] sm:text-[14px] lg:text-[15px]">
                  {%- if section.settings.top_picks_collection != blank and section.settings.top_picks_collection.products.size > 0 -%}
                    {%- for product in section.settings.top_picks_collection.products limit: 6 -%}
                    <a href="{{ product.url }}" class="w-full sm:w-[48%] flex space-x-4 items-center group">
                      {%- if product.featured_image -%}
                        <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title }}" class="block w-[70px] h-[70px] flex-shrink-0 bg-[#e5e5ea] rounded-xl object-contain p-2 shadow-sm transition-transform group-hover:scale-105" loading="lazy">
                      {%- else -%}
                        <div class="w-[70px] h-[70px] flex-shrink-0 bg-[#e5e5ea] rounded-xl p-2 shadow-sm">{{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover opacity-30' }}</div>
                      {%- endif -%}
                      <h4 class="font-light leading-snug">
                        {%- if product.tags contains 'NEW' or product.tags contains 'New' -%}
                          <span class="block text-orange-400 font-medium mb-1 tracking-wider text-[11px] uppercase">NEW</span>
                        {%- endif -%}
                        <span class="block text-gray-500 line-clamp-3">{{ product.title }}</span>
                      </h4>
                    </a>
                    {%- endfor -%}
                  {%- else -%}
                    <!-- Static Fallback (Image 1 style) -->
                    <a href="#" class="w-full sm:w-[48%] flex space-x-4 items-center group">
                      <img src="//www.ipitaka.com/cdn/shop/files/Google-Pixel-11-pro-fold-back-only-california-dream-04_5ea67e99-0862-4550-b73b-a38e69495c7b_small.webp?v=1786700650" alt="California Dream" class="block w-[70px] h-[70px] flex-shrink-0 bg-[#e5e5ea] rounded-xl object-contain p-2 shadow-sm transition-transform group-hover:scale-105" loading="lazy">
                      <h4 class="font-light leading-snug text-[13px] sm:text-[14px]">
                        <span class="block text-orange-400 font-medium mb-1 tracking-wider text-[11px] uppercase">NEW</span>
                        <span class="block text-gray-500">California Dream-01 Google Pixel 11 Pro Fold<br>Edge Case</span>
                      </h4>
                    </a>
                    <a href="#" class="w-full sm:w-[48%] flex space-x-4 items-center group">
                      <img src="//www.ipitaka.com/cdn/shop/files/Fold8-black-back-case-only-1_247996dd-3cc6-4683-a6cc-a6e64bb6d18c_small.webp?v=1784803088" alt="Fold 8" class="block w-[70px] h-[70px] flex-shrink-0 bg-[#e5e5ea] rounded-xl object-contain p-2 shadow-sm transition-transform group-hover:scale-105" loading="lazy">
                      <h4 class="font-light leading-snug text-[13px] sm:text-[14px]">
                        <span class="block text-orange-400 font-medium mb-1 tracking-wider text-[11px] uppercase">NEW</span>
                        <span class="block text-gray-500">600D Black/Grey (Twill) Fold8<br>Edge Case</span>
                      </h4>
                    </a>
                    <a href="#" class="w-full sm:w-[48%] flex space-x-4 items-center group">
                      <img src="//www.ipitaka.com/cdn/shop/files/Fold8-california-dream-01-back-case-only-1_e361a7ea-43d5-415b-ab19-abc14f0dafe8_small.webp?v=1784805092" alt="California Dream Fold 8" class="block w-[70px] h-[70px] flex-shrink-0 bg-[#e5e5ea] rounded-xl object-contain p-2 shadow-sm transition-transform group-hover:scale-105" loading="lazy">
                      <h4 class="font-light leading-snug text-[13px] sm:text-[14px]">
                        <span class="block text-orange-400 font-medium mb-1 tracking-wider text-[11px] uppercase">NEW</span>
                        <span class="block text-gray-500">California Dream-01 Fold8<br>Edge Case</span>
                      </h4>
                    </a>
                    <a href="#" class="w-full sm:w-[48%] flex space-x-4 items-center group">
                      <img src="//www.ipitaka.com/cdn/shop/files/Fold8-moonrise-back-case-only-1_036f96c1-26fe-426a-8fca-5155ef8ea098_small.webp?v=1784803717" alt="Moonrise Fold8" class="block w-[70px] h-[70px] flex-shrink-0 bg-[#e5e5ea] rounded-xl object-contain p-2 shadow-sm transition-transform group-hover:scale-105" loading="lazy">
                      <h4 class="font-light leading-snug text-[13px] sm:text-[14px]">
                        <span class="block text-orange-400 font-medium mb-1 tracking-wider text-[11px] uppercase">NEW</span>
                        <span class="block text-gray-500">Moonrise Fold8<br>Edge Case</span>
                      </h4>
                    </a>
                    <a href="#" class="w-full sm:w-[48%] flex space-x-4 items-center group">
                      <img src="//www.ipitaka.com/cdn/shop/files/Fold8-ultra-sunset-back-case-only-1_f55582ca-88d8-4331-b684-df6891a353bb_small.webp?v=1784803420" alt="Sunset Fold8 Ultra" class="block w-[70px] h-[70px] flex-shrink-0 bg-[#e5e5ea] rounded-xl object-contain p-2 shadow-sm transition-transform group-hover:scale-105" loading="lazy">
                      <h4 class="font-light leading-snug text-[13px] sm:text-[14px]">
                        <span class="block text-orange-400 font-medium mb-1 tracking-wider text-[11px] uppercase">NEW</span>
                        <span class="block text-gray-500">Sunset Fold8 Ultra<br>Edge Case</span>
                      </h4>
                    </a>
                    <a href="#" class="w-full sm:w-[48%] flex space-x-4 items-center group">
                      <img src="//www.ipitaka.com/cdn/shop/files/iPhone17air-black-slim_3e78f7f4-04ff-437b-a7af-cbbaba794f7d_small.webp?v=1785987187" alt="iPhone 17 Air" class="block w-[70px] h-[70px] flex-shrink-0 bg-[#e5e5ea] rounded-xl object-contain p-2 shadow-sm transition-transform group-hover:scale-105" loading="lazy">
                      <h4 class="font-light leading-snug text-[13px] sm:text-[14px]">
                        <span class="block text-[#bfa780] font-medium mb-1 tracking-wider text-[11px] uppercase">HOT</span>
                        <span class="block text-gray-500">600D Black/Grey (Twill) iPhone Air<br>Edge Case</span>
                      </h4>
                    </a>
                  {%- endif -%}
                </div>
              </div>
              
              <!-- Case Series Accordion -->
              {%- if section.settings.accordion_heading != blank -%}
              <div class="md:flex md:space-x-6 lg:space-x-8 mt-12 sm:mt-16 md:mt-20 border-t border-gray-300 pt-8">
                <div class="mega-search-accordion w-full">
                  <div class="item text-[14px] sm:text-[16px] font-light leading-relaxed">
                    <div class="title flex items-center justify-between cursor-pointer pb-4 group" onclick="this.nextElementSibling.classList.toggle('hidden'); this.querySelector('.accordion-icon').classList.toggle('rotate-180')">
                      <div>
                        <h4 class="font-medium text-[16px] sm:text-[18px] text-black">{{ section.settings.accordion_heading }}</h4>
                        {%- if section.settings.accordion_subheading != blank -%}
                          <span class="block font-light text-gray-500 mt-1">{{ section.settings.accordion_subheading }}</span>
                        {%- endif -%}
                      </div>
                      <span class="accordion-icon ml-4 text-gray-500 transition-transform duration-300 group-hover:text-black flex-shrink-0">
                        <svg width="24" height="24" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                        </svg>
                      </span>
                    </div>
                    
                    <!-- Accordion Content -->
                    <div class="content pt-4 sm:pt-6 hidden border-t border-dashed border-gray-300 mt-2 text-gray-600 pb-8 rte">
                      {{ section.settings.accordion_content }}
                    </div>
                  </div>
                </div>
              </div>
              {%- endif -%}

            </div>
          </div>
          
        </div>
      </div>
    </predictive-search-component>
  </dialog>
</dialog-component>

<style>
  /* Base Dialog resets */
  .dialog-modal[open].search-modal__content {
    animation: search-element-slide-in-bottom 300ms cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  }
  .dialog-modal.search-modal__content.dialog-closing {
    animation: search-element-slide-out-bottom 200ms cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  }
  
  /* Predictive Search inline positioning */
  .predictive-search-form__content:empty {
    display: none;
  }
  
  .predictive-search-form__content:not(:empty) + .static-search-content {
    display: none;
  }
</style>

{% schema %}
{
  "name": "Predictive Search Modal",
  "settings": [
    {
      "type": "header",
      "content": "Frequency Terms"
    },
    {
      "type": "link_list",
      "id": "frequency_menu",
      "label": "Frequency Terms Menu"
    },
    {
      "type": "header",
      "content": "Top Picks"
    },
    {
      "type": "collection",
      "id": "top_picks_collection",
      "label": "Top Picks Collection"
    },
    {
      "type": "header",
      "content": "Info Accordion"
    },
    {
      "type": "text",
      "id": "accordion_heading",
      "label": "Heading",
      "default": "We've Updated Our Case Series"
    },
    {
      "type": "text",
      "id": "accordion_subheading",
      "label": "Subheading",
      "default": "Don't worry — you'll still find the same designs, just under new names."
    },
    {
      "type": "richtext",
      "id": "accordion_content",
      "label": "Content",
      "default": "<p>Content goes here.</p>"
    }
  ]
}
{% endschema %}
