                },
                "feature_EUnbTc": {
                    "type": "feature",
                    "settings": {
                        "title": "Rask levering",
                        "text": "<p>Vi sender direkte fra vårt lager rett utenfor Oslo – levering tar omtrent 2 dager.<\/p>"
                    }
                },
                "feature_QaJP64": {
                    "type": "feature",
                    "settings": {
                        "title": "Enkel betaling",
                        "text": "<p>Handle trygt med Vipps eller Klarna – få produktene hjem først og betal senere.<\/p>"
                    }
                },
                "feature_wNwKza": {
                    "type": "feature",
                    "settings": {
                        "title": "Personlig kundeservice",
                        "text": "<p>Vi har topp kundeservice og hjelper deg om du må bytte størrelse.<\/p>"
                    }
                },
                "feature_xGLkwx": {
                    "type": "feature",
                    "settings": {
                        "title": "Trygghet og kvalitet",
                        "text": "<p>Vi er et norsk selskap og følger norske forbrukerlover – selvfølgelig.<\/p>"
                    }
                },
