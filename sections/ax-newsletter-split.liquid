<section class="ax-nl-strip">
  <div class="ax-nl-strip__media" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: '' }}
    {%- else -%}
      <img src="{{ 'ax-newsletter-lifestyle.png' | asset_url }}" alt="" width="1200" height="900" loading="lazy">
    {%- endif -%}
  </div>
  <div class="ax-nl-strip__form">
    {%- if section.settings.kicker != blank -%}
      <p class="ax-kicker">{{ section.settings.kicker }}</p>
    {%- endif -%}
    <p class="ax-offer">{{ section.settings.offer }}</p>
    <p>{{ section.settings.text }}</p>
    {% form 'customer', class: 'ax-nl-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="visually-hidden" for="ax-nl-email-{{ section.id }}">Email</label>
      <input id="ax-nl-email-{{ section.id }}" type="email" name="contact[email]" placeholder="Email" required>
      <button type="submit">{{ section.settings.button_label }}</button>
      {%- if form.posted_successfully? -%}
        <p>You're in. Check your inbox.</p>
      {%- endif -%}
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "AX Newsletter split",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "kicker", "label": "Brand line", "default": "Arvenixo" },
    { "type": "text", "id": "offer", "label": "Offer", "default": "15% OFF" },
    { "type": "text", "id": "text", "label": "Text", "default": "Save on your first order." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Get my code" }
  ],
  "presets": [{ "name": "AX Newsletter split" }]
}
{% endschema %}
