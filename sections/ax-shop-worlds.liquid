<section class="ax-worlds">
  <div class="ax-wrap">
    {%- if section.settings.kicker != blank -%}
      <p class="ax-kicker">{{ section.settings.kicker }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="ax-section-title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="ax-worlds__grid">
      {%- for block in section.blocks -%}
        <a class="ax-world" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: block.settings.title }}
          {%- elsif block.settings.asset != blank -%}
            <img src="{{ block.settings.asset | asset_url }}" alt="{{ block.settings.title | escape }}" width="800" height="800" loading="lazy">
          {%- endif -%}
          <p class="ax-world__label">{{ block.settings.title }}</p>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AX Shop worlds",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Shop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Protect. Charge. Glow." }
  ],
  "blocks": [
    {
      "type": "world",
      "name": "World",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Protect" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "asset", "label": "Asset filename", "info": "Fallback in /assets" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AX Shop worlds",
      "blocks": [
        { "type": "world", "settings": { "title": "Protect", "asset": "ax-world-protect.png" } },
        { "type": "world", "settings": { "title": "Charge", "asset": "ax-world-charge.png" } },
        { "type": "world", "settings": { "title": "Beauty", "asset": "ax-world-beauty.png" } }
      ]
    }
  ]
}
{% endschema %}
