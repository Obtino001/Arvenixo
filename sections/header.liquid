    <div class="lf-monk-offer-row">
      <div class="lf-monk-offer-dot"></div>
      <div class="lf-monk-offer-text">Complimentary samples with qualifying brand orders</div>
    </div>
    <div class="lf-monk-offer-row">
      <div class="lf-monk-offer-dot"></div>
      <div class="lf-monk-offer-text">Exclusive seasonal gifts across selected collections</div>
    </div>
