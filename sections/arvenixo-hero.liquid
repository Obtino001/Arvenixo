{% comment %}
  Arvenixo full-bleed premium hero — uses theme asset images (no Shopify Files required).
{% endcomment %}

{%- liquid
  assign hero_asset = section.settings.hero_asset | default: 'arvenixo-hero-magsafe.png'
  assign min_vh = section.settings.min_height | default: 88
-%}

<section
  class="ax-hero section-arvenixo-hero"
  style="--ax-hero-min: {{ min_vh }}vh;"
  data-ax-hero
>
  <div class="ax-hero__media" aria-hidden="true">
    <img
      class="ax-hero__img ax-hero__img--desktop"
      src="{{ hero_asset | asset_url }}"
      alt=""
      width="1920"
      height="1080"
      loading="eager"
      fetchpriority="high"
    >
    <div class="ax-hero__overlay"></div>
  </div>

  <div class="ax-hero__content page-width">
    <div class="ax-hero__inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ax-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="ax-hero__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="ax-hero__text">{{ section.settings.text }}</p>
      {%- endif -%}
      <div class="ax-hero__actions">
        {%- if section.settings.button_label != blank -%}
          <a class="ax-btn ax-btn--primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.button2_label != blank -%}
          <a class="ax-btn ax-btn--ghost" href="{{ section.settings.button2_link | default: '/collections/all' }}">
            {{ section.settings.button2_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .ax-hero {
    position: relative;
    min-height: var(--ax-hero-min, 85vh);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    color: #fff;
    background: #0b0c0e;
    margin: 0;
    width: 100%;
  }
  .ax-hero__media {
    position: absolute;
    inset: 0;
  }
  .ax-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .ax-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(11, 12, 14, 0.2) 0%, rgba(11, 12, 14, 0.78) 100%);
    pointer-events: none;
  }
  .ax-hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding: 4.5rem 1.25rem 3.25rem;
  }
  .ax-hero__inner {
    max-width: 36rem;
    animation: ax-rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .ax-hero__eyebrow {
    margin: 0 0 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #c4a35a;
  }
  .ax-hero__heading {
    margin: 0 0 0.85rem;
    font-size: clamp(2.4rem, 5.2vw, 4.1rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 650;
    color: #fff;
  }
  .ax-hero__text {
    margin: 0 0 1.5rem;
    font-size: 1.05rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.86);
  }
  .ax-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  @keyframes ax-rise {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (max-width: 749px) {
    .ax-hero { min-height: 78vh; }
    .ax-hero__content { padding: 3.5rem 1rem 2.5rem; }
  }
</style>

{% schema %}
{
  "name": "Arvenixo Hero",
  "tag": "section",
  "class": "section-arvenixo-hero-wrap",
  "settings": [
    {
      "type": "text",
      "id": "hero_asset",
      "label": "Hero image filename (in assets)",
      "default": "arvenixo-hero-magsafe.png"
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 60,
      "max": 100,
      "step": 1,
      "unit": "vh",
      "label": "Minimum height",
      "default": 88
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "ARVENIXO"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Carry lighter. Charge smarter."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Supporting text",
      "default": "Precision MagSafe cases and beauty tech — crafted for everyday luxury."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button",
      "default": "Shop collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button2_label",
      "label": "Secondary button",
      "default": "Explore beauty tech"
    },
    {
      "type": "url",
      "id": "button2_link",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "Arvenixo Hero"
    }
  ]
}
{% endschema %}
