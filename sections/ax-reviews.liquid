<section class="ax-reviews" data-ax-reviews>
  <div class="ax-reviews__grid">
    <div class="ax-reviews__copy">
      <div class="ax-reviews__stars" aria-hidden="true">★★★★★</div>
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="ax-reviews__avg">{{ section.settings.subheading }}</p>
      {%- endif -%}

      <div class="ax-reviews__quotes">
        {%- for block in section.blocks -%}
          <article class="ax-reviews__quote{% if forloop.first %} is-active{% endif %}" data-ax-quote {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}
              <h3>{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p>{{ block.settings.text }}</p>
            {%- endif -%}
            {%- if block.settings.author != blank -%}
              <p class="ax-reviews__author">
                {{ block.settings.author }}
                <span class="ax-reviews__verified" title="Verified buyer" aria-label="Verified buyer">
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.2A6.8 6.8 0 1 1 1.2 8 6.8 6.8 0 0 1 8 1.2zm3.1 4.5L7.1 10.8 4.7 8.4l.9-.9 1.5 1.5 3.1-3.4.9.9z" fill="currentColor"/></svg>
                </span>
              </p>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    </div>

    <div class="ax-reviews__media">
      {%- for block in section.blocks -%}
        <figure class="ax-reviews__slide{% if forloop.first %} is-active{% endif %}" data-ax-slide>
          {%- if block.settings.image != blank -%}
            {%- assign review_alt = block.settings.title | default: section.settings.heading -%}
            {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: review_alt }}
          {%- elsif block.settings.asset != blank -%}
            <img src="{{ block.settings.asset | asset_url }}" alt="" width="1200" height="900" loading="lazy">
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'ax-reviews__ph' }}
          {%- endif -%}
        </figure>
      {%- endfor -%}
      {%- if section.blocks.size > 1 -%}
        <button type="button" class="ax-reviews__next" data-ax-next aria-label="Next review">→</button>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function () {
    document.querySelectorAll('[data-ax-reviews]').forEach(function (root) {
      var quotes = root.querySelectorAll('[data-ax-quote]');
      var slides = root.querySelectorAll('[data-ax-slide]');
      var i = 0;
      function show(n) {
        if (!quotes.length) return;
        i = (n + quotes.length) % quotes.length;
        quotes.forEach(function (q, idx) { q.classList.toggle('is-active', idx === i); });
        slides.forEach(function (s, idx) { s.classList.toggle('is-active', idx === i); });
      }
      var next = root.querySelector('[data-ax-next]');
      if (next) next.addEventListener('click', function () { show(i + 1); });
    });
  })();
</script>

{% schema %}
{
  "name": "AX Reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "2500+ 5 Star Reviews" },
    { "type": "text", "id": "subheading", "label": "Average rating text", "default": "4.8 out of 5 stars on average" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Review" },
        { "type": "text", "id": "author", "label": "Author" },
        { "type": "image_picker", "id": "image", "label": "Lifestyle image" },
        { "type": "text", "id": "asset", "label": "Fallback asset filename", "info": "e.g. ax-review-pocket.png" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AX Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "title": "Great warranty",
            "text": "I dropped my case and Arvenixo replaced it without the runaround. Fast, honest support — the product feels as considered as the service.",
            "author": "Customer S. Verified Buyer",
            "asset": "ax-review-pocket.png"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Everyday carry, sorted",
            "text": "Slim enough to forget it's there, strong enough that MagSafe never misses. My phone, cards, and charger finally feel like one system.",
            "author": "Customer M. Verified Buyer",
            "asset": "ax-review-charge.png"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Built to last",
            "text": "Materials feel expensive, edges stay clean, and it still looks new after months of pockets and travel. This is the case I actually keep.",
            "author": "Customer A. Verified Buyer",
            "asset": "ax-review-carry.png"
          }
        }
      ]
    }
  ]
}
{% endschema %}
