<style>
  /* Global wishlist heart on product cards (restored) */
  .pcg-img-outer, .sb-rv__img, .lf-sc, .lf-sc-img-wrap { position: relative; }
  .sb-card-wish { position: absolute; top: 10px; right: 10px; z-index: 5; width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center; padding: 0; margin: 0; border: none; border-radius: 50%; background: rgba(255,255,255,.9); box-shadow: 0 1px 5px rgba(0,0,0,.14); color: #1a1a1a; cursor: pointer; transition: transform .18s ease, background .18s ease; -webkit-backdrop-filter: blur(2px); backdrop-filter: blur(2px); }
  .sb-card-wish:hover { transform: scale(1.09); background: #fff; }
  .sb-card-wish svg { width: 18px; height: 18px; display: block; pointer-events: none; }
  .sb-card-wish[aria-pressed="true"] { color: #e0556e; }
  .sb-card-wish[aria-pressed="true"] svg { fill: #e0556e; stroke: #e0556e; }
  @media (max-width: 749px) { .sb-card-wish { width: 30px; height: 30px; top: 8px; right: 8px; } .sb-card-wish svg { width: 16px; height: 16px; } }

  :root {
    --promo-bg: {{ section.settings.promo_bg }};
    --promo-text: {{ section.settings.promo_text_color }};
    --font-stack: var(--font-body--family);
    --nav-dt: {{ section.settings.nav_font_size }}px;
    --nav-mob: {{ section.settings.nav_font_size_mobile }}px;
    --ann-dt: {{ section.settings.announcement_font_size }}px;
    --ann-mob: {{ section.settings.announcement_font_size_mobile }}px;
    --mega-header: {{ section.settings.mega_title_font_size }}px;
  }

  body {
    padding-top: 192px;
    margin: 0;
    font-family: var(--font-body--family), sans-serif;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
    font-weight: var(--font-body--weight);
  }
  @media (max-width: 1023px) { body { padding-top: 174px; } }

  #header-group {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    background: #fff;
  }

  #header-group .shopify-section-group-header-group {
    display: block;
    width: 100%;
    max-width: none;
  }

  #header-group .trust-bar-section,
  #header-group [id*="trust_bar"],
  #header-group [id*="trust-bar"] {
    display: block;
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  .lf-header-root h1,
  .lf-header-root h2,
  .lf-header-root h3,
  .lf-header-root h4,
  .lf-header-root h5,
  .lf-header-root h6 {
    font-family: var(--font-heading--family), serif;
    font-weight: var(--font-heading--weight);
  }

  .lf-header-root p,
  .lf-header-root li,
  .lf-header-root label,
  .lf-header-root input,
  .lf-header-root textarea,
  .lf-header-root select,
  .lf-header-root blockquote {
    font-family: var(--font-body--family), sans-serif;
  }

  .lf-header-root { position: relative; width: 100%; background: #fff; border-bottom: 1px solid #e5e5e5; }
  .container-wide { max-width: 1600px; margin: 0 auto; padding: 0 20px; position: relative; }

  /* --- ANNOUNCEMENT --- */
  .lf-promo-bar { position: relative; background: var(--promo-bg); color: var(--promo-text); padding: 10px 68px; line-height: 1.2; display: flex; align-items: center; justify-content: center; }
  .lf-promo-bar__text { color: var(--promo-text); text-align: center; font-size: var(--ann-dt); font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; text-decoration: none; transition: opacity 0.15s ease; }
  .lf-promo-bar__text:hover { opacity: 0.85; }
  .lf-promo-social { position: absolute; top: 50%; right: 20px; transform: translateY(-50%); display: flex; align-items: center; gap: 15px; }
  .lf-promo-social a { display: flex; color: var(--promo-text); text-decoration: none; opacity: 0.82; transition: opacity 0.15s ease; }
  .lf-promo-social a:hover { opacity: 1; }
  .lf-promo-social svg { width: 15px; height: 15px; display: block; fill: currentColor; }
  @media (max-width: 749px) {
    .lf-promo-bar { padding: 9px 44px; }
    .lf-promo-social { right: 12px; gap: 12px; }
    .lf-promo-social svg { width: 13px; height: 13px; }
  }

  /* --- MAIN HEADER --- */
  .lf-main-header {
    padding: 15px 0;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
  }

  .lf-left-col { display: flex; align-items: center; gap: 10px; width: auto; flex-shrink: 0; }
  .lf-desktop-search { width: 260px; max-width: 260px; flex-shrink: 0; }
  .lf-desktop-search .ds-header-search { width: 260px; max-width: 260px; }

  .lf-logo-wrap { display: flex; justify-content: center; align-items: center; }
  .lf-logo-wrap a { display: flex; justify-content: center; align-items: center; }
  .lf-logo-wrap img { width: {{ section.settings.logo_width }}px; height: auto; display: block; }
  @media (max-width: 1023px) { .lf-logo-wrap img { width: {{ section.settings.logo_width_mobile }}px !important; } }

  .lf-tool-flex { display: flex; justify-content: flex-end; align-items: center; gap: 18px; }
  .icon-btn { text-decoration: none; color: #000; display: flex; align-items: center; background: none; border: none; cursor: pointer; padding: 0; position: relative; transition: opacity 0.15s ease; }
  .icon-btn:hover { opacity: 0.55; }
  .icon-btn svg { width: 24px; height: 24px; stroke-width: 1.1px; }
  .basket-badge { position: absolute; top: -8px; right: -8px; background: #000; color: #fff; border-radius: 50%; width: 18px; height: 18px; font-size: 9px; display: flex; align-items: center; justify-content: center; font-weight: 500; }

  /* Search trigger */
  .lf-left-col .ds-header-search { width: 260px; max-width: 260px; }
  .lf-menu-btn {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
  }

  .lf-mobile-search-row { display: none; }

  @media (max-width: 1023px) {
    .lf-main-header {
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 8px;
      padding: 8px 0 6px;
    }
    .lf-left-col {
      width: auto;
      min-width: 0;
      flex-shrink: 0;
    }
    .lf-logo-wrap {
      min-width: 0;
      overflow: hidden;
    }
    .lf-tool-flex {
      flex-shrink: 0;
      gap: 12px;
    }
    .lf-mobile-search-row {
      display: block;
      width: 100%;
      padding: 0 0 10px;
    }
    .lf-mobile-search-row .ds-header-search {
      width: 100%;
      max-width: none;
      display: block;
    }
    .lf-mobile-search-row .lf-search-trigger {
      width: 100% !important;
      max-width: none !important;
    }
  }

  .lf-search-trigger {
    display: flex !important;
    align-items: center;
    gap: 10px;
    width: 260px;
    max-width: 260px;
    height: 40px;
    padding: 0 14px !important;
    margin: 0;
    background: #f7f5f2;
    border: 1px solid rgba(12,12,12,0.08);
    border-radius: 999px;
    cursor: text;
    color: #0c0c0c;
    list-style: none;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.7);
    transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
  }
  .lf-search-trigger::-webkit-details-marker { display: none; }
  .lf-search-trigger::marker { content: none; }
  .lf-search-trigger:hover,
  .lf-search-trigger:focus {
    border-color: rgba(184,146,90,0.55);
    box-shadow: 0 0 0 3px rgba(184,146,90,0.12);
    background: #fbf9f4;
    opacity: 1;
  }
  details[open] > .lf-search-trigger {
    border-color: rgba(184,146,90,0.7);
    box-shadow: 0 0 0 3px rgba(184,146,90,0.14);
  }
  .lf-search-trigger__icon {
    display: flex;
    flex-shrink: 0;
    color: #8a7a62;
  }
  .lf-search-trigger__icon svg { width: 16px; height: 16px; display: block; }
  .lf-search-trigger__placeholder {
    font-family: var(--font-body--family), sans-serif;
    font-size: 12.5px;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: rgba(12,12,12,0.42);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  @media (max-width: 1023px) {
    .lf-search-trigger { height: 36px; padding: 0 12px !important; }
    .lf-search-trigger__placeholder { font-size: 11.5px; }
  }

  /* --- DESKTOP NAV --- */
  .lf-nav-bar { position: relative; }
  .nav-ul { list-style: none !important; margin: 0; padding: 0; display: flex; justify-content: center; gap: 30px; }
  .nav-li { position: static; }
  .nav-a { position: relative; display: block; padding: 16px 2px; text-decoration: none; color: #0c0c0c; font-size: var(--nav-dt); font-weight: 600; text-transform: uppercase; letter-spacing: 0.11em; transition: color 0.18s ease; }
  .nav-a::after { content:""; position:absolute; left:2px; right:2px; bottom:11px; height:2px; background:linear-gradient(90deg,#0c0c0c,#b8925a); transform:scaleX(0); transform-origin:left; transition:transform .28s cubic-bezier(.4,0,.2,1); }
  .nav-li:hover .nav-a::after, .nav-li.mega-touch-open .nav-a::after { transform:scaleX(1); }
  .nav-a[href$="/collections/sale"]::after, .nav-a[href*="/pages/gifts"]::after { display:none; }
  .nav-a:hover { color:#0c0c0c; }
  /* Top-level nav boxes: SALE (red) + FREE GIFTS (black + gift icon) */
  .nav-a[href$="/collections/sale"], .nav-a[href*="/pages/gifts"] { padding: 7px 15px; margin: 8px 0; border-radius: 3px; letter-spacing: 0.12em; line-height: 1; }
  .nav-a[href$="/collections/sale"] { background: #c8102e; color: #fff !important; }
  .nav-a[href$="/collections/sale"]:hover { background: #a30c22; opacity: 1; }
  .nav-a[href*="/pages/gifts"] { display: inline-flex; align-items: center; gap: 6px; background: #141414; color: #fff !important; }
  .nav-a[href*="/pages/gifts"]:hover { background: #333; opacity: 1; }
  .nav-a[href*="/pages/gifts"] svg { width: 14px; height: 14px; flex-shrink: 0; }

  /* Mega menu: full-width luxury editorial panel */
  .mega-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(-3px);
    width: 100vw;
    background: #fff;
    border-top: 1px solid rgba(0,0,0,0.05);
    border-bottom: 1px solid rgba(0,0,0,0.07);
    padding: 56px 0 64px;
    z-index: 100;
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition: opacity 0.22s ease, transform 0.22s ease, visibility 0s linear 0.22s;
  }
  .nav-li:hover .mega-menu,
  .nav-li:focus-within .mega-menu {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
    visibility: visible;
    transition: opacity 0.22s ease, transform 0.22s ease;
  }
  .mega-grid { display: grid; grid-template-columns: repeat(6, max-content); gap: 0 clamp(38px, 4.2vw, 64px); justify-content: center; }
  .mega-grid--auto { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 16px 36px; }

  /* ── BRANDS alphabetical panel ─────────────────────────────────── */
  .mega-menu--brands { padding: 48px 0 56px; }
  .brands-panel__header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 24px; border-bottom: 1px solid rgba(0,0,0,0.07); padding-bottom: 12px; }
  .brands-panel__eyebrow { font-family: var(--font-body--family), sans-serif; font-size: 0.5rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(0,0,0,0.35); }
  .brands-panel__view-all { font-size: 10px; font-weight: 400; color: #000; text-decoration: none; letter-spacing: 0.04em; opacity: 0.55; transition: opacity 0.15s ease; }
  .brands-panel__view-all:hover { opacity: 1; }
  .brands-panel__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(155px, 1fr)); gap: 0 28px; }
  .brands-alpha-group { margin-bottom: 18px; }
  .brands-alpha-letter { display: block; font-family: var(--font-body--family), sans-serif; font-size: 0.5rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(0,0,0,0.2); margin-bottom: 6px; }
  .brand-mega-link { display: block; text-decoration: none; color: #555; font-family: var(--font-body--family), sans-serif; font-size: calc(var(--mega-header) - 1px); font-weight: 400; letter-spacing: 0.06em; text-transform: uppercase; padding: 3px 0; transition: color 0.12s ease; }
  .brand-mega-link:hover { color: #000; }

  /* ── Brand hover-reveal range flyout ── */
  .brands-layout { display: grid; grid-template-columns: minmax(0,1fr) 320px; gap: 0 48px; }
  .brands-flyout { border-left: 1px solid rgba(0,0,0,0.08); padding-left: 44px; min-height: 250px; }
  .brands-flyout__hint { font-family: var(--font-body--family), sans-serif; font-size: 0.6875rem; letter-spacing: 0.05em; color: rgba(0,0,0,0.3); font-style: italic; }
  .brands-flyout.has-active .brands-flyout__hint { display: none; }
  .brand-ranges { display: none; }
  .brand-ranges.is-active { display: block; animation: brandFade 0.22s ease; }
  @keyframes brandFade { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  .brand-ranges__title { display: block; font-family: var(--font-heading--family), serif; font-size: 1.15rem; color: #0c0c0c; text-decoration: none; letter-spacing: 0.01em; margin: 0 0 15px; padding-bottom: 12px; border-bottom: 1px solid rgba(0,0,0,0.07); }
  .brand-ranges__title:hover { color: rgba(0,0,0,0.55); }
  .brand-ranges__eyebrow { display: block; font-family: var(--font-body--family), sans-serif; font-size: 0.5rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(0,0,0,0.32); margin-bottom: 7px; }
  .brand-ranges__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1px 22px; margin-bottom: 18px; }
  .brand-ranges__link { display: block; font-family: var(--font-body--family), sans-serif; font-size: 0.8125rem; color: #555; text-decoration: none; letter-spacing: 0.02em; padding: 5px 0; transition: color 0.12s ease, padding-left 0.12s ease; }
  .brand-ranges__link:hover { color: #0c0c0c; padding-left: 4px; }
  .brand-ranges__all { display: inline-block; font-family: var(--font-body--family), sans-serif; font-size: 0.625rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #0c0c0c; text-decoration: none; border-bottom: 1px solid #0c0c0c; padding-bottom: 2px; }
  .brand-arrow { margin-left: 5px; color: rgba(0,0,0,0.28); }
  .brand-mega-link.has-ranges:hover .brand-arrow { color: #0c0c0c; }

  /* ── Touch/iPad: first tap opens, second tap navigates ─────────── */
  .nav-li.mega-touch-open .mega-menu { opacity: 1; transform: translateX(-50%) translateY(0); pointer-events: auto; visibility: visible; transition: opacity 0.22s ease, transform 0.22s ease; }

  /* ── Mobile brands 2-column grid ───────────────────────────────── */
  .mob-brands-grid { display: grid; grid-template-columns: 1fr 1fr; padding: 10px 20px 16px; gap: 0 16px; }
  .mob-brand-letter { padding: 12px 20px 5px; font-family: var(--font-body--family), sans-serif; font-size: 0.5rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(0,0,0,0.3); border-bottom: 1px solid #f2f2f2; }
  .mob-brand-link { display: block; padding: 9px 0; text-decoration: none; color: #555; font-family: var(--font-body--family), sans-serif; font-size: 10px; font-weight: 400; letter-spacing: 0.06em; text-transform: uppercase; border-bottom: 1px solid #f5f5f5; transition: color 0.12s ease; }
  .mob-brand-link:hover { color: #000; }
  .mega-title {
    font-family: var(--font-heading--family), serif;
    font-size: 15.5px; font-weight: 500; color: #0c0c0c;
    margin-bottom: 15px; display: block; text-decoration: none;
    padding-bottom: 10px; position: relative;
    text-transform: none; letter-spacing: 0.01em;
    transition: color 0.15s ease;
  }
  .mega-title::after { content:""; position:absolute; left:0; bottom:0; width:26px; height:2px; background:linear-gradient(90deg,#0c0c0c,#b8925a); border-radius:2px; }
  .mega-title:hover { color: rgba(0,0,0,0.55); }
  /* SALE column header → red box, white text */
  .mega-title[href$="/collections/sale"] { display:inline-block; background:#c8102e; color:#fff; border:none; padding:5px 14px; border-radius:3px; letter-spacing:0.12em; }
  .mega-title[href$="/collections/sale"]:hover { color:#fff; background:#a30c22; }
  /* SALE pill is desktop mega only — mobile drawer uses collection-image rows */
  /* SkinCeuticals PREVENT / CORRECT / PROTECT → black boxes, white text */
  .mega-title[href$="/collections/skinceuticals-prevent"],
  .mega-title[href$="/collections/skinceuticals-correct-1"],
  .mega-title[href$="/collections/skinceuticals-protect-2"] { display:inline-block; background:#141414; color:#fff; border:none; padding:5px 14px; border-radius:3px; letter-spacing:0.12em; }
  .mega-title[href$="/collections/skinceuticals-prevent"]:hover,
  .mega-title[href$="/collections/skinceuticals-correct-1"]:hover,
  .mega-title[href$="/collections/skinceuticals-protect-2"]:hover { color:#fff; background:#333; }
  /* FREE GIFTS column header → black box, white text, gift icon */
  .mega-title[href*="/pages/gifts"] { display:inline-flex; align-items:center; gap:6px; background:#141414; color:#fff; border:none; padding:5px 12px; border-radius:3px; letter-spacing:0.12em; text-transform:uppercase; }
  .mega-title[href*="/pages/gifts"]:hover { color:#fff; background:#333; }
  .mega-title .mega-ico { width:14px; height:14px; flex:0 0 auto; }
  /* keep pill headers (SALE / SkinCeuticals / Free Gifts) in Lato with no gold accent bar */
  .mega-title[href$="/collections/sale"], .mega-title[href$="/collections/skinceuticals-prevent"], .mega-title[href$="/collections/skinceuticals-correct-1"], .mega-title[href$="/collections/skinceuticals-protect-2"], .mega-title[href*="/pages/gifts"] { font-family: var(--font-body--family), sans-serif; font-weight:700; font-size:12px; }
  .mega-title[href$="/collections/sale"]::after, .mega-title[href$="/collections/skinceuticals-prevent"]::after, .mega-title[href$="/collections/skinceuticals-correct-1"]::after, .mega-title[href$="/collections/skinceuticals-protect-2"]::after, .mega-title[href*="/pages/gifts"]::after { display:none; }
  /* MAKE UP mega — centered columns + icons */
  .mega-menu--make-up .mega-grid { display:flex; justify-content:center; gap:0 clamp(28px,4vw,60px); }
  .mega-menu--make-up .mega-title { display:flex; flex-direction:column; align-items:center; gap:9px; text-align:center; }
  .mega-menu--make-up .mega-ico { width:26px; height:26px; }
  .mega-menu--make-up .mega-list { text-align:center; }
  .mega-list { list-style: none !important; padding: 0; margin: 0; }
  .mega-list li + li { margin-top: 2px; }
  .mega-list a {
    text-decoration: none; color: #555;
    font-size: 13px; display: block;
    padding: 6px 0; font-weight: 400; letter-spacing: 0.02em;
    transition: color 0.15s ease, padding-left 0.15s ease;
  }
  .mega-list a:hover { color: #0c0c0c; padding-left: 4px; }

  /* --- MOBILE NAV (Naillak 1:1) --- */
  .lf-mob-drawer {
    position: fixed;
    top: 0;
    left: -100%;
    width: 100%;
    max-width: 100%;
    height: 100%;
    height: 100dvh;
    background: #fff;
    z-index: 2200;
    transition: left 0.35s cubic-bezier(0.77, 0, 0.175, 1);
    overflow: hidden;
    padding-bottom: env(safe-area-inset-bottom);
    display: flex;
    flex-direction: column;
  }
  .lf-mob-drawer.active { left: 0; }
  @media (min-width: 750px) {
    .lf-mob-drawer { max-width: 420px; box-shadow: 8px 0 40px rgba(0,0,0,0.12); }
  }

  .nlk-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 18px 18px 14px;
    flex-shrink: 0;
    background: #fff;
    position: relative;
    z-index: 3;
    border-bottom: 1px solid #f0f0f0;
    min-height: 58px;
  }
  .nlk-head-logo { display: flex; align-items: center; line-height: 0; margin-right: auto; }
  .nlk-head-logo.is-hidden { visibility: hidden; pointer-events: none; }
  .nlk-head-logo img { height: 26px; width: auto; max-width: 170px; object-fit: contain; display: block; }
  .nlk-back {
    background: none;
    border: none;
    padding: 6px;
    margin: -6px 0 -6px -6px;
    cursor: pointer;
    color: #111;
    display: none;
    align-items: center;
    justify-content: center;
    line-height: 0;
    flex-shrink: 0;
  }
  .nlk-back.is-visible { display: flex; }
  .nlk-back svg { width: 22px; height: 22px; display: block; }
  .nlk-head-title {
    flex: 1;
    min-width: 0;
    font-family: var(--font-body--family), sans-serif;
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-transform: lowercase;
    color: #222;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: none;
    margin: 0;
    padding: 0 8px;
  }
  .nlk-head-title.is-visible { display: block; }
  .nlk-close {
    background: none;
    border: none;
    padding: 6px;
    margin: -6px;
    cursor: pointer;
    color: #111;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
  }
  .nlk-close svg { width: 22px; height: 22px; display: block; }

  .nlk-viewport {
    flex: 1;
    min-height: 0;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  .nlk-root-scroll {
    height: 100%;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    transition: transform 0.35s cubic-bezier(0.77, 0, 0.175, 1);
    will-change: transform;
  }

  .nlk-viewport.is-sub-open .nlk-root-scroll {
    transform: translateX(-18%);
  }

  .nlk-submenu {
    position: absolute;
    inset: 0;
    z-index: 4;
    background: #fff;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    transform: translate3d(100%, 0, 0);
    visibility: hidden;
    pointer-events: none;
    transition: transform 0.35s cubic-bezier(0.77, 0, 0.175, 1), visibility 0.35s;
    display: flex;
    flex-direction: column;
  }

  .nlk-submenu.is-open {
    transform: translate3d(0, 0, 0);
    visibility: visible;
    pointer-events: auto;
    z-index: 6;
  }

  .nlk-submenu.is-behind {
    transform: translate3d(-18%, 0, 0);
    visibility: visible;
    pointer-events: none;
    z-index: 5;
  }

  .nlk-submenu-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    border-bottom: 1px solid #f0f0f0;
    flex-shrink: 0;
    background: #fff;
    position: sticky;
    top: 0;
    z-index: 2;
  }

  .nlk-submenu-back {
    background: none;
    border: none;
    padding: 6px;
    margin: -6px;
    cursor: pointer;
    color: #111;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
  }

  .nlk-submenu-back svg { width: 22px; height: 22px; display: block; }

  .nlk-submenu-title {
    margin: 0;
    font-family: var(--font-body--family), sans-serif;
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-transform: lowercase;
    color: #222;
  }

  .nlk-nav { flex: 1 0 auto; }

  .nlk-item { margin: 0; }

  .nlk-bar {
    display: flex;
    align-items: stretch;
    border-bottom: 1px solid #ececec;
  }

  .nlk-row .nlk-chevron {
    margin-left: auto;
    flex-shrink: 0;
    width: auto;
    height: auto;
    min-height: 58px;
    padding-right: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1a1a1a;
  }
  .nlk-row .nlk-chevron svg { width: 16px; height: 16px; display: block; }

  .lf-mob-drawer a.nlk-row,
  .lf-mob-drawer .nlk-row,
  .lf-mob-drawer button.nlk-row {
    display: flex !important;
    align-items: center !important;
    gap: 14px;
    flex: 1;
    min-width: 0;
    min-height: 58px;
    padding: 8px 18px !important;
    margin: 0 !important;
    text-decoration: none !important;
    color: #1a1a1a !important;
    background: transparent !important;
    border: none !important;
    border-radius: 0 !important;
    opacity: 1 !important;
    letter-spacing: 0 !important;
    text-transform: none !important;
    font-weight: 400 !important;
    width: 100% !important;
    cursor: pointer;
    text-align: left;
    font-family: inherit;
  }
  .lf-mob-drawer a.nlk-row:hover,
  .nlk-row:hover { color: #1a1a1a !important; background: transparent !important; }

  .nlk-thumb {
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    border-radius: 6px;
    overflow: hidden;
    background: #f4f4f4;
    display: block;
  }
  .nlk-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .nlk-label {
    flex: 1;
    min-width: 0;
    font-family: var(--font-body--family), sans-serif !important;
    font-size: 16px !important;
    font-weight: 400 !important;
    line-height: 1.25;
    letter-spacing: -0.01em !important;
    color: #222 !important;
    text-transform: lowercase !important;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .nlk-chevron svg { width: 16px; height: 16px; display: block; }

  .nlk-panel .nlk-thumb { width: 38px; height: 38px; border-radius: 6px; }
  .nlk-submenu .nlk-row { min-height: 54px; }
  .nlk-submenu .nlk-label { font-size: 15px !important; }

  .nlk-letter {
    padding: 14px 18px 6px;
    font-family: var(--font-body--family), sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(0,0,0,0.32);
    border-bottom: 1px solid #f2f2f2;
  }

  .nlk-panel-footer { flex-shrink: 0; padding-bottom: 28px; }

  .nlk-promo { padding: 18px 16px 8px; }
  .nlk-promo-card {
    display: grid;
    grid-template-columns: 0.92fr 1.08fr;
    min-height: 148px;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    background: #f4f4f4;
    color: inherit;
    box-shadow: 0 1px 10px rgba(0,0,0,0.06);
  }
  .nlk-promo-img {
    min-height: 148px;
    height: 100%;
    align-self: stretch;
    background: #e8e4df center / cover no-repeat;
  }
  .nlk-promo-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .nlk-promo-body {
    background: #fff;
    padding: 16px 14px 14px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .nlk-promo-title {
    margin: 0 0 8px;
    font-family: var(--font-body--family), sans-serif;
    font-size: 16px;
    font-weight: 500;
    color: #111;
    display: flex;
    align-items: center;
    gap: 6px;
    text-transform: lowercase;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .nlk-promo-title svg { width: 15px; height: 15px; color: #c9a0a0; flex-shrink: 0; }
  .nlk-promo-text {
    margin: 0 0 12px;
    font-family: var(--font-body--family), sans-serif;
    font-size: 12.5px;
    line-height: 1.4;
    color: #444;
    font-weight: 400;
  }
  .nlk-promo-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    background: #c9a0a0;
    color: #fff;
    font-family: var(--font-body--family), sans-serif;
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: lowercase;
    padding: 8px 16px;
    border-radius: 3px;
    line-height: 1;
  }

  .nlk-socials {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 14px;
    padding: 22px 16px 6px;
    border-top: 1px solid #f0f0f0;
    margin-top: 4px;
  }

  .nlk-social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 50%;
    text-decoration: none;
    transition: border-color 0.3s ease, background 0.3s ease, transform 0.3s ease;
  }

  .nlk-social-link:hover {
    border-color: #c9b79b;
    background: #c9b79b;
    transform: translateY(-2px);
  }

  .nlk-social-icon {
    width: 19px;
    height: 19px;
    display: block;
  }

  .nlk-social-icon path {
    fill: #1a1a1a;
    transition: fill 0.3s ease;
  }

  .nlk-social-link:hover .nlk-social-icon path {
    fill: #111111;
  }

  /* ── Overlay ── */
  .overlay-bg { position: fixed; inset: 0; z-index: 1500; background: rgba(0,0,0,0); visibility: hidden; transition: background 0.4s ease, visibility 0s linear 0.4s; }
  .overlay-bg.active { background: rgba(0,0,0,0.52); visibility: visible; transition: background 0.4s ease; cursor: pointer; }

  /* ── Cart Drawer Shell (replaced by wi-cartdrawer; kept as fallback) ── */
  #lux-cart-drawer { display: none !important; }

  /* Header */
  #lf-cart-header { display: flex; align-items: center; justify-content: space-between; padding: 22px 24px 18px; border-bottom: 1px solid rgba(0,0,0,0.07); flex-shrink: 0; }
  #lf-cart-title { font-family: var(--font-body--family), sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: #0c0c0c; display: flex; align-items: center; gap: 6px; }
  #lf-cart-count { font-weight: 400; opacity: 0.5; }
  #lf-cart-close { background: none; border: none; cursor: pointer; width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; opacity: 0.4; transition: opacity 0.15s ease; padding: 0; margin-right: -6px; }
  #lf-cart-close:hover { opacity: 1; }

  /* Shipping bar */
  #lf-cart-shipping { padding: 13px 24px 12px; border-bottom: 1px solid rgba(0,0,0,0.06); flex-shrink: 0; background: #fafafa; }
  #lf-ship-msg { font-family: var(--font-body--family), sans-serif; font-size: 9px; font-weight: 500; letter-spacing: 0.04em; color: #555; margin-bottom: 8px; line-height: 1.4; }
  #lf-ship-msg strong { color: #0c0c0c; font-weight: 700; }
  #lf-ship-msg.lf-unlocked { color: #2e7d52; }
  #lf-ship-track { height: 2px; background: rgba(0,0,0,0.1); border-radius: 2px; overflow: hidden; }
  #lf-ship-fill { height: 100%; background: #0c0c0c; border-radius: 2px; transition: width 0.7s cubic-bezier(0.4,0,0.2,1); width: 0%; }
  #lf-ship-fill.lf-full { background: #2e7d52; }

  /* Items scroll zone */
  #lux-cart-items { flex: 1; overflow-y: auto; padding: 0; -webkit-overflow-scrolling: touch; scrollbar-width: thin; scrollbar-color: rgba(0,0,0,0.1) transparent; }
  #lux-cart-items::-webkit-scrollbar { width: 3px; }
  #lux-cart-items::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.1); border-radius: 3px; }

  /* Item card */
  .lf-ci { display: grid; grid-template-columns: 90px 1fr; gap: 16px; padding: 20px 24px; border-bottom: 1px solid rgba(0,0,0,0.06); }
  .lf-ci-img-wrap { width: 90px; height: 90px; background: #f7f7f7; overflow: hidden; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .lf-ci-img { width: 100%; height: 100%; object-fit: contain; object-position: center; display: block; padding: 6px; box-sizing: border-box; }
  .lf-ci-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .lf-ci-vendor { font-family: var(--font-body--family), sans-serif; font-size: 7.5px; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: #bbb; margin-bottom: 1px; }
  .lf-ci-name { font-family: var(--font-body--family), sans-serif; font-size: 12px; font-weight: 400; color: #0c0c0c; line-height: 1.4; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lf-ci-variant { font-family: var(--font-body--family), sans-serif; font-size: 11px; color: #aaa; }
  .lf-ci-price-row { display: flex; align-items: baseline; gap: 7px; margin-top: 5px; }
  .lf-ci-price { font-family: var(--font-body--family), sans-serif; font-size: 12px; font-weight: 600; color: #0c0c0c; }
  .lf-ci-price-was { font-family: var(--font-body--family), sans-serif; font-size: 10px; color: #bbb; text-decoration: line-through; margin-left: 5px; }
  .lf-ci-save-badge { font-family: var(--font-body--family), sans-serif; font-size: 7.5px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #2e7d52; background: rgba(46,125,82,0.09); padding: 2px 6px; margin-left: 5px; display: inline-block; }
  .lf-ci-gift-badge { font-family: var(--font-body--family), sans-serif; font-size: 7px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; background: #0c0c0c; color: #fff; padding: 2px 6px; display: inline-block; }
  .lf-ci-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 11px; }
  .lf-qty { display: inline-flex; align-items: stretch; border: 1px solid rgba(0,0,0,0.16); height: 28px; }
  .lf-qty-btn { background: none; border: none; cursor: pointer; width: 30px; display: flex; align-items: center; justify-content: center; font-size: 15px; color: #0c0c0c; transition: background 0.12s; padding: 0; font-weight: 300; line-height: 1; }
  .lf-qty-btn:hover:not(:disabled) { background: rgba(0,0,0,0.04); }
  .lf-qty-btn:disabled { opacity: 0.25; cursor: not-allowed; }
  .lf-qty-val { min-width: 32px; text-align: center; font-family: var(--font-body--family), sans-serif; font-size: 10px; font-weight: 600; color: #0c0c0c; letter-spacing: 0.04em; display: flex; align-items: center; justify-content: center; border-left: 1px solid rgba(0,0,0,0.12); border-right: 1px solid rgba(0,0,0,0.12); }
  .lf-ci-remove { background: none; border: none; cursor: pointer; font-family: var(--font-body--family), sans-serif; font-size: 8px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #ccc; padding: 0; text-decoration: underline; text-underline-offset: 2px; transition: color 0.12s; }
  .lf-ci-remove:hover { color: #0c0c0c; }

  /* Upsell strip */
  #lf-cart-upsells { flex-shrink: 0; border-top: 1px solid rgba(0,0,0,0.07); padding: 16px 0 0; background: #fff; }
  #lf-upsell-label { padding: 0 24px 10px; font-family: var(--font-body--family), sans-serif; font-size: 8px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #bbb; }
  #lf-upsell-strip { display: flex; gap: 10px; overflow-x: auto; padding: 0 24px 16px; scrollbar-width: none; }
  #lf-upsell-strip::-webkit-scrollbar { display: none; }
  .lf-up-card { display: flex; flex-direction: column; flex: 0 0 96px; }
  .lf-up-img-wrap { width: 96px; height: 96px; background: #f7f7f7; overflow: hidden; margin-bottom: 7px; }
  .lf-up-img { width: 100%; height: 100%; object-fit: contain; padding: 6px; box-sizing: border-box; display: block; }
  .lf-up-name { font-family: var(--font-body--family), sans-serif; font-size: 9.5px; color: #333; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .lf-up-price { font-family: var(--font-body--family), sans-serif; font-size: 9.5px; font-weight: 600; color: #0c0c0c; margin-top: 3px; }
  .lf-up-atc { margin-top: 7px; background: none; border: 1px solid rgba(0,0,0,0.2); font-family: var(--font-body--family), sans-serif; font-size: 7.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #0c0c0c; padding: 5px 4px; cursor: pointer; transition: all 0.14s; width: 100%; }
  .lf-up-atc:hover { background: #0c0c0c; color: #fff; border-color: #0c0c0c; }
  .lf-up-atc:disabled { opacity: 0.5; cursor: default; background: #0c0c0c; color: #fff; }

  /* Empty state */
  #lf-cart-empty { display: none; flex-direction: column; align-items: center; justify-content: center; padding: 56px 32px; text-align: center; flex: 1; }
  #lf-cart-empty.lf-visible { display: flex; }
  #lf-cart-empty svg { opacity: 0.12; margin-bottom: 20px; }
  .lf-ce-title { font-family: var(--font-body--family), sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: #0c0c0c; margin-bottom: 10px; }
  .lf-ce-body { font-family: var(--font-body--family), sans-serif; font-size: 13px; color: #999; line-height: 1.6; margin-bottom: 28px; max-width: 220px; }
  .lf-ce-links { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
  .lf-ce-link { display: inline-block; padding: 10px 24px; border: 1px solid #0c0c0c; color: #0c0c0c; font-family: var(--font-body--family), sans-serif; font-size: 8.5px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; text-decoration: none; transition: all 0.14s; }
  .lf-ce-link:hover { background: #0c0c0c; color: #fff; }

  /* Cart footer */
  #lf-cart-footer { flex-shrink: 0; border-top: 1px solid rgba(0,0,0,0.09); padding: 18px 24px 24px; background: #fff; }
  #lf-cart-savings { display: none; justify-content: space-between; align-items: center; margin-bottom: 12px; padding: 10px 13px; background: #eaf6ef; border: 1px solid #cbe6d7; border-radius: 7px; }
  #lf-cart-savings.lf-visible { display: flex; }
  #lf-savings-label { font-family: var(--font-body--family), sans-serif; font-size: 10px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: #2e7d52; display: flex; align-items: center; gap: 6px; }
  #lf-savings-label svg { width: 13px; height: 13px; }
  #lf-savings-val { font-family: var(--font-body--family), sans-serif; font-size: 16px; font-weight: 800; color: #2e7d52; }
  #lf-savings-val .lf-savings-gift { font-size: 11px; font-weight: 800; letter-spacing: .02em; color: #b0812e; }
  #lf-cart-subtotal { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 14px; }
  #lf-cart-subtotal-label { font-family: var(--font-body--family), sans-serif; font-size: 8.5px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: #888; }
  #drawer-total-val { font-family: var(--font-body--family), sans-serif; font-size: 17px; font-weight: 700; color: #0c0c0c; letter-spacing: -0.01em; }
  #lf-cart-checkout-btn { width: 100%; padding: 16px 20px; background: #0c0c0c; color: #fff; border: none; border-radius: 50px; cursor: pointer; font-family: var(--font-body--family), sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; transition: background 0.18s; display: flex; align-items: center; justify-content: center; gap: 9px; }
  #lf-cart-checkout-btn:hover { background: #2a2a2a; }
  #lf-cart-trust { display: flex; align-items: center; justify-content: center; gap: 5px; margin-top: 11px; font-family: var(--font-body--family), sans-serif; font-size: 8px; color: #bbb; letter-spacing: 0.07em; text-transform: uppercase; }
  #lf-cart-payments { display: flex; align-items: center; justify-content: center; gap: 7px; margin-top: 10px; flex-wrap: wrap; }
  #lf-cart-payments .payment-icon { height: 20px; width: auto; opacity: 0.4; }

  /* ── Monk: luxury offers panel ── */
  #lf-monk-offers { flex-shrink: 0; background: #faf8f5; border-bottom: 1px solid rgba(0,0,0,0.06); padding: 14px 24px 16px; display: none; }
  #lf-monk-offers.lf-mo-visible { display: block; }
  #lf-monk-offers-label { font-family: var(--font-body--family), sans-serif; font-size: 7.5px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: #bbb; margin-bottom: 10px; display: flex; align-items: center; gap: 6px; }
  #lf-monk-offers-label::before { content: '✦'; color: #c9a96e; font-size: 8px; }
  #lf-monk-gift-msg { font-family: var(--font-body--family), sans-serif; font-size: 12.5px; color: #555; line-height: 1.45; margin-bottom: 9px; }
  #lf-monk-gift-msg strong { color: #0c0c0c; font-weight: 700; }
  #lf-monk-gift-msg.lf-mo-unlocked { color: #2e7d52; }
  #lf-monk-gift-track { height: 1.5px; background: rgba(0,0,0,0.1); border-radius: 2px; overflow: hidden; margin-bottom: 12px; }
  #lf-monk-gift-fill { height: 100%; background: #0c0c0c; border-radius: 2px; transition: width 0.8s cubic-bezier(0.4,0,0.2,1); width: 0%; }
  #lf-monk-gift-fill.lf-mo-full { background: #2e7d52; }
  .lf-monk-offer-row { display: flex; align-items: flex-start; gap: 9px; padding-top: 8px; }
  .lf-monk-offer-row + .lf-monk-offer-row { border-top: 1px solid rgba(0,0,0,0.05); }
  .lf-monk-offer-dot { width: 3px; height: 3px; border-radius: 50%; background: #c9a96e; flex-shrink: 0; margin-top: 6px; }
  .lf-monk-offer-text { font-family: var(--font-body--family), sans-serif; font-size: 11.5px; color: #888; line-height: 1.4; }

  /* Mobile: full-width drawer */
  @media (max-width: 480px) {
    #lux-cart-drawer { max-width: 100%; }
    .lf-ci { padding: 16px 18px; }
    #lf-cart-header, #lf-cart-shipping, #lf-monk-offers, #lf-cart-footer { padding-left: 18px; padding-right: 18px; }
    #lf-upsell-strip, #lf-upsell-label { padding-left: 18px; padding-right: 18px; }
  }

  .desktop-only { display: block; }
  .mobile-only { display: none; }
  @media (max-width: 1023px) { .desktop-only { display: none !important; } .mobile-only { display: flex !important; } }

  /* Cookie consent */
  @media (max-width: 749px) { #shopify-pc__banner { max-height: 50vh !important; overflow-y: auto !important; } }

  /* Avada Joy */
  .Avada-Joy_ButtonWidget { bottom: 80px !important; }
