{% comment %}
  Arvenixo hero — full-bleed media, Horizon page-width content column.
{% endcomment %}

{%- liquid
  assign hero_image = section.settings.image
  assign hero_image_mobile = section.settings.image_mobile
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  id="ArvenixoHero-{{ section.id }}"
  class="ax-hero section section--full-width color-{{ section.settings.color_scheme }}"
  style="--ax-hero-min: {{ section.settings.min_height }}vh;"
  {{ section.shopify_attributes }}
>
  <div class="ax-hero__media" aria-hidden="true">
    {%- if hero_image != blank -%}
      {{
        hero_image
        | image_url: width: 2400
        | image_tag:
          class: 'ax-hero__img ax-hero__img--desktop',
          loading: 'eager',
          fetchpriority: 'high',
          widths: '800,1200,1600,2000,2400',
          sizes: '100vw',
          alt: ''
      }}
    {%- else -%}
      <img
        class="ax-hero__img ax-hero__img--desktop"
        src="{{ 'arvenixo-hero-banner.png' | asset_url }}"
        alt=""
        loading="eager"
        fetchpriority="high"
        width="1920"
        height="1080"
      >
    {%- endif -%}

    {%- if hero_image_mobile != blank -%}
      {{
        hero_image_mobile
        | image_url: width: 1200
        | image_tag:
          class: 'ax-hero__img ax-hero__img--mobile',
          loading: 'eager',
          widths: '400,800,1200',
          sizes: '100vw',
          alt: ''
      }}
    {%- endif -%}
    <div class="ax-hero__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
  </div>

  <div class="ax-hero__content">
    <div class="ax-hero__inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ax-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="ax-hero__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="ax-hero__text">{{ section.settings.text }}</p>
      {%- endif -%}
      <div class="ax-hero__actions">
        {%- if section.settings.button_label != blank -%}
          <a class="ax-btn ax-btn--primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a class="ax-btn ax-btn--ghost" href="{{ section.settings.button_link_2 | default: routes.all_products_collection_url }}">
            {{ section.settings.button_label_2 }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Arvenixo Hero",
  "tag": "section",
  "class": "section-arvenixo-hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop hero image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile hero image (optional)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "ARVENIXO" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Elevate everyday" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Supporting text",
      "default": "Premium MagSafe cases and beauty tech designed for modern living. Free standard shipping on every order."
    },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "Shop bestsellers" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "button_label_2", "label": "Secondary button", "default": "Shop phone cases" },
    { "type": "url", "id": "button_link_2", "label": "Secondary button link" },
    { "type": "range", "id": "min_height", "min": 60, "max": 100, "step": 5, "unit": "vh", "label": "Minimum height", "default": 85 },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Overlay opacity", "default": 45 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Arvenixo Hero" }]
}
{% endschema %}
