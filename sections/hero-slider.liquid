{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="shopify-section slideshow-index section-{{ section.id }}-padding" id="Slider-{{ section.id }}">
  <div class="w-full mx-auto {{ section.settings.page_width }} px-6 sm:px-10 lg:px-12 xl:px-16">
    <div class="aspect-w-3 aspect-h-4 sm:aspect-w-5 sm:aspect-h-6 md:aspect-h-2 lg:aspect-w-8 lg:aspect-h-3 xl:aspect-w-11 xl:aspect-h-4 relative rounded-2xl md:rounded-3xl overflow-hidden shadow-2xl">
      <div class="w-full h-full absolute inset-0">
        <div class="swiper hero-slider w-full h-full" id="swiper_{{ section.id }}">
          <div class="swiper-wrapper">
            {%- for block in section.blocks -%}
              <div class="swiper-slide w-full h-full relative" {{ block.shopify_attributes }}>
                <div class="absolute inset-0 px-4 sm:px-6 lg:px-8 xl:px-12 py-6 sm:py-10 md:py-12 lg:py-16 xl:py-20 z-10 pointer-events-none flex flex-col justify-end md:justify-center">
                  <div class="w-full max-w-screen-full mx-auto md:px-6 lg:px-10 xl:px-0">
                    <div class="w-max max-w-full space-y-2 mb-6 sm:mb-8 xl:mb-10 relative" style="color: {{ block.settings.text_color }};">
                      {%- if block.settings.heading != blank -%}
                        <h2 class="text-[28px] xs:text-[32px] sm:text-[36px] md:text-[42px] lg:text-[48px] xl:text-[56px] leading-tight font-medium tracking-tight">
                          {{ block.settings.heading | newline_to_br }}
                        </h2>
                      {%- endif -%}
                      {%- if block.settings.subheading != blank -%}
                        <h3 class="text-[16px] xs:text-[18px] sm:text-[20px] lg:text-[24px] xl:text-[28px] font-light opacity-90">
                          {{ block.settings.subheading | newline_to_br }}
                        </h3>
                      {%- endif -%}
                    </div>
                    {%- if block.settings.button_label != blank -%}
                      <a href="{{ block.settings.button_link }}" class="pointer-events-auto relative z-10 w-max block text-[14px] xs:text-[15px] sm:text-[16px] xl:text-[18px] leading-none py-3 sm:py-3.5 lg:py-4 px-6 sm:px-8 lg:px-10 rounded-full font-medium transition-all duration-300 hover:scale-105" style="background-color: {{ block.settings.button_bg_color }}; color: {{ block.settings.button_text_color }};">
                        {{ block.settings.button_label }}
                      </a>
                    {%- endif -%}
                  </div>
                </div>
                
                <div class="absolute inset-0 w-full h-full z-0" style="background-color: rgba(0,0,0,{{ block.settings.overlay_opacity | divided_by: 100.0 }});"></div>

                {%- if block.settings.video != blank -%}
                  {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: 'absolute inset-0 w-full h-full object-cover z-[-1]' }}
                {%- elsif block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 3840 | image_tag: class: 'absolute inset-0 w-full h-full object-cover z-[-1] hidden md:block' }}
                  {%- if block.settings.image_mobile != blank -%}
                    {{ block.settings.image_mobile | image_url: width: 1200 | image_tag: class: 'absolute inset-0 w-full h-full object-cover z-[-1] md:hidden' }}
                  {%- else -%}
                    {{ block.settings.image | image_url: width: 1200 | image_tag: class: 'absolute inset-0 w-full h-full object-cover z-[-1] md:hidden' }}
                  {%- endif -%}
                {%- else -%}
                  <div class="absolute inset-0 w-full h-full bg-gray-100 z-[-1] flex items-center justify-center">
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'w-full h-full object-cover opacity-50' }}
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
          <div class="swiper-pagination !bottom-6"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  #Slider-{{ section.id }} .swiper-pagination-bullet {
    background: #ffffff;
    opacity: 0.5;
    width: 10px;
    height: 10px;
    transition: all 0.3s ease;
  }
  #Slider-{{ section.id }} .swiper-pagination-bullet-active {
    opacity: 1;
    width: 24px;
    border-radius: 5px;
    background: #ffffff;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    new Swiper('#swiper_{{ section.id }}', {
      loop: true,
      autoplay: {
        delay: {{ section.settings.autoplay_duration | times: 1000 }},
        disableOnInteraction: false,
      },
      pagination: {
        el: '.swiper-pagination',
        clickable: true,
      }
    });
  });
</script>

{% schema %}
{
  "name": "Hero Slider",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "page_width",
      "label": "Page Width",
      "options": [
        { "value": "max-w-screen-xl", "label": "Standard" },
        { "value": "max-w-[1440px]", "label": "Wide" },
        { "value": "max-w-screen-full", "label": "Full Width" }
      ],
      "default": "max-w-screen-xl"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "autoplay_duration",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay Duration",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop Image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile Image (Optional)"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Background Video",
          "info": "Overrides images if selected."
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "label": "Image Overlay Opacity",
          "default": 20
        },
        {
          "type": "textarea",
          "id": "heading",
          "label": "Heading",
          "default": "Designed to Disappear"
        },
        {
          "type": "textarea",
          "id": "subheading",
          "label": "Subheading",
          "default": "For Google Pixel 11 series"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "header",
          "content": "Colors"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text Color",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "button_bg_color",
          "label": "Button Background",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "button_text_color",
          "label": "Button Text",
          "default": "#000000"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Slider",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
