{
  "type": "footer",
  "name": "Footer",
  "sections": {
    "newsletter_ax": {
      "type": "section",
      "blocks": {
        "heading": {
          "type": "text",
          "settings": {
            "text": "<h3>Stay in the loop</h3>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "center",
            "type_preset": "h3"
          }
        },
        "sub": {
          "type": "text",
          "settings": {
            "text": "<p>New drops, MagSafe tips, and beauty-tech guides — no spam.</p>",
            "width": "100%",
            "alignment": "center",
            "type_preset": "rte"
          }
        },
        "signup": {
          "type": "email-signup",
          "settings": {
            "width": "custom",
            "custom_width": 50,
            "heading": "",
            "border_style": "all",
            "border_width": 1,
            "border_radius": 100,
            "style_class": "button-unstyled",
            "display_type": "arrow",
            "label": "Subscribe",
            "integrated_button": true
          }
        }
      },
      "block_order": ["heading", "sub", "signup"],
      "settings": {
        "content_direction": "column",
        "horizontal_alignment_flex_direction_column": "center",
        "gap": 12,
        "section_width": "page-width",
        "color_scheme": "scheme-1",
        "padding-block-start": 56,
        "padding-block-end": 56
      }
    },
    "footer_ax": {
      "type": "footer",
      "blocks": {
        "about": {
          "type": "group",
          "settings": {
            "content_direction": "column",
            "gap": 12,
            "width": "fill"
          },
          "blocks": {
            "brand": {
              "type": "text",
              "settings": {
                "text": "<h3>Arvenixo</h3>",
                "type_preset": "h4",
                "padding-block-start": 8
              }
            },
            "blurb": {
              "type": "text",
              "settings": {
                "text": "<p>Everyday essentials elevated — MagSafe cases, beauty tech, and smart gadgets with clear shipping, secure checkout, and responsive support.</p>",
                "type_preset": "rte"
              }
            }
          },
          "block_order": ["brand", "blurb"]
        },
        "menu_shop": {
          "type": "menu",
          "settings": {
            "menu": "main-menu",
            "heading": "Shop",
            "menu_spacing": 8,
            "show_as_accordion": true,
            "accordion_icon": "plus",
            "heading_preset": "h4",
            "link_preset": "paragraph"
          }
        },
        "menu_help": {
          "type": "menu",
          "settings": {
            "menu": "footer",
            "heading": "Help",
            "menu_spacing": 8,
            "show_as_accordion": true,
            "accordion_icon": "plus",
            "heading_preset": "h4",
            "link_preset": "paragraph"
          }
        },
        "contact": {
          "type": "group",
          "settings": {
            "content_direction": "column",
            "gap": 10,
            "width": "fill"
          },
          "blocks": {
            "h": {
              "type": "text",
              "settings": {
                "text": "<h4>Support</h4>",
                "type_preset": "h4",
                "padding-block-start": 8
              }
            },
            "p": {
              "type": "text",
              "settings": {
                "text": "<p>Email: support@arvenixo.com<br/>We typically reply within 1–2 business days.</p><p><a href=\"/pages/contact\">Contact form</a> · <a href=\"/policies/shipping-policy\">Shipping</a> · <a href=\"/policies/refund-policy\">Returns</a></p>",
                "type_preset": "rte"
              }
            }
          },
          "block_order": ["h", "p"]
        }
      },
      "block_order": ["about", "menu_shop", "menu_help", "contact"],
      "settings": {
        "section_width": "page-width",
        "gap": 24,
        "color_scheme": "scheme-5",
        "padding-block-start": 40,
        "padding-block-end": 30
      }
    },
    "footer_utilities_ax": {
      "type": "footer-utilities",
      "blocks": {
        "copyright": {
          "type": "footer-copyright",
          "settings": {
            "show_powered_by": true,
            "font_size": "0.75rem",
            "case": "none"
          }
        },
        "payments": {
          "type": "payment-icons",
          "settings": {
            "horizontal_alignment": "flex-end",
            "gap": 10
          }
        }
      },
      "block_order": ["copyright", "payments"],
      "settings": {
        "section_width": "page-width",
        "gap": 24,
        "divider_thickness": 1,
        "color_scheme": "scheme-5",
        "padding-block-start": 16,
        "padding-block-end": 20
      }
    }
  },
  "order": ["newsletter_ax", "footer_ax", "footer_utilities_ax"]
}
