<section class="ax-cats">
  <div class="ax-cats__copy">
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="ax-cats__sub">{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="ax-cats__text">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="ax-btn ax-btn--ink" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
  <div class="ax-cats__grid">
    {%- for block in section.blocks -%}
      <a class="ax-cats__tile" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.title }}
        {%- elsif block.settings.asset != blank -%}
          <img src="{{ block.settings.asset | asset_url }}" alt="{{ block.settings.title | escape }}" width="800" height="800" loading="lazy">
        {%- endif -%}
        <span>{{ block.settings.title }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "AX Product categories",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Product Categories" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Charge / Carry / Protect" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We believe in less, but better. Better design, better materials, better daily use.</p><p>Every piece is made to last — plant-based and recycled whenever we can, without compromising the feel.</p>" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "See all Products" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "asset", "label": "Asset filename" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AX Product categories",
      "blocks": [
        { "type": "category", "settings": { "title": "All Cables", "asset": "ax-cat-cables.png" } },
        { "type": "category", "settings": { "title": "iPhone Cases & Accessories", "asset": "ax-cat-cases.png" } },
        { "type": "category", "settings": { "title": "Magnetic Chargers", "asset": "ax-cat-charger.png" } },
        { "type": "category", "settings": { "title": "Carry", "asset": "ax-cat-bags.png" } }
      ]
    }
  ]
}
{% endschema %}
