{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="shopify-section section px-6 sm:px-10 lg:px-12 xl:px-16 section-{{ section.id }}-padding" id="TrustBadges-{{ section.id }}" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="w-full mx-auto {{ section.settings.page_width }} {% if section.settings.show_border %}border-t border-b border-gray-200{% endif %} relative">
    
    {%- if section.blocks.size > 0 -%}
      <div class="w-full md:w-11/12 lg:w-5/6 xl:w-3/4 mx-auto grid grid-cols-2 md:grid-cols-4 gap-8 sm:gap-10 lg:gap-12 xl:gap-16">
        {%- for block in section.blocks -%}
          <div class="col-span-1 text-center" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link_url | default: '#' }}" class="flex flex-col items-center group transition-transform duration-300 hover:-translate-y-2">
              
              <!-- Icon Container -->
              <div class="w-16 h-16 sm:w-20 sm:h-20 lg:w-24 lg:h-24 mx-auto mb-4 sm:mb-6 lg:mb-8 flex items-center justify-center transition-transform duration-300 group-hover:scale-110">
                {%- if block.settings.custom_svg != blank -%}
                  <div class="w-full h-full [&>svg]:w-full [&>svg]:h-full [&>svg]:object-contain" style="fill: currentColor;">
                    {{ block.settings.custom_svg }}
                  </div>
                {%- elsif block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 200 | image_tag: class: 'w-full h-full object-contain' }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'w-full h-full text-gray-200' }}
                {%- endif -%}
              </div>
              
              <!-- Heading -->
              {%- if block.settings.heading != blank -%}
                <h2 class="text-[15px] sm:text-[18px] lg:text-[20px] xl:text-[24px] font-medium leading-tight mb-2 sm:mb-3">
                  {{ block.settings.heading | newline_to_br }}
                </h2>
              {%- endif -%}
              
              <!-- Link Label -->
              {%- if block.settings.link_label != blank -%}
                <span class="block w-max mx-auto text-[13px] sm:text-[14px] lg:text-[16px] font-light border-b border-current pb-0.5 opacity-60 group-hover:opacity-100 transition-opacity">
                  {{ block.settings.link_label }}
                </span>
              {%- endif -%}

            </a>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
    
  </div>
</div>

{% schema %}
