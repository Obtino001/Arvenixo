{% schema %}
{
  "name": "Flex Case Promo",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#faf6f0"
    },
    {
      "type": "color",
      "id": "trust_bg",
      "label": "Trust Bar Background Color",
      "default": "#f0ebe3"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#30231e"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "content_gap",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Content Gap",
      "default": 8
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "#1 Best-Seller"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Original Leather Case"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Made to get better with age. Its rich two tone finish develops more depth and character over time, creating a look that is completely unique to you. The leather softens and wears in naturally with everyday use, giving it a lived in feel you cannot replicate. Hand finished and built with intention, it remains one of the only handmade cases on the market today.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Designed in the USA"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Flex Case Promo",
      "blocks": [
        {
          "type": "trust_item",
          "settings": {
            "text": "Designed in the USA"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "text": "100% Full-Grain Leather"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "text": "Lifetime Warranty"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "text": "Free US Shipping Over $150"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<style>
  .flex-case-promo-wrapper {
    width: 100%;
  }
  .flex-case-promo {
    background-color: var(--flex-case-bg);
    color: var(--flex-case-text);
    padding-top: var(--flex-case-padding-top);
    padding-bottom: var(--flex-case-padding-bottom);
    display: flex;
    flex-direction: column;
  }
  .flex-case-promo__main {
    display: flex;
    flex-direction: column;
    gap: var(--flex-case-content-gap);
    padding: 2rem;
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
  }
  @media (min-width: 768px) {
    .flex-case-promo__main {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
    .flex-case-promo__content {
      flex: 1;
      padding-right: 2rem;
    }
    .flex-case-promo__media {
      flex: 1;
    }
  }
  .flex-case-promo__eyebrow {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }
  .flex-case-promo__heading {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.2;
    margin-top: 0;
  }
  .flex-case-promo__description {
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 2rem;
  }
  .flex-case-promo__button {
    display: inline-block;
    background-color: #000;
    color: #fff;
    padding: 1rem 2rem;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
    transition: background-color 0.3s;
  }
  .flex-case-promo__button:hover {
    background-color: #333;
  }
  .flex-case-promo__media img {
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 8px;
  }
  .flex-case-promo__trust-bar {
    background-color: var(--flex-case-trust-bg);
    padding: 1rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem;
  }
  .flex-case-promo__trust-item {
    font-size: 0.875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .flex-case-promo__trust-sep {
    font-size: 1.2rem;
    line-height: 1;
    color: var(--flex-case-text);
  }
</style>

<div class="flex-case-promo" style="
  --flex-case-bg: {{ section.settings.bg_color }};
  --flex-case-trust-bg: {{ section.settings.trust_bg }};
  --flex-case-text: {{ section.settings.text_color }};
  --flex-case-padding-top: {{ section.settings.padding_top }}px;
  --flex-case-padding-bottom: {{ section.settings.padding_bottom }}px;
  --flex-case-content-gap: {{ section.settings.content_gap }}px;
">
  <div class="flex-case-promo__main">
    <div class="flex-case-promo__content">
      <p class="flex-case-promo__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="flex-case-promo__heading">{{ section.settings.heading }}</h2>
      <div class="flex-case-promo__description rte">
        {{ section.settings.description }}
      </div>
      <a href="{{ section.settings.button_link | default: '#' }}" class="flex-case-promo__button button">
        {{ section.settings.button_label }}
      </a>
    </div>

    <div class="flex-case-promo__media">
      {% if section.settings.image %}
        <img src="{{ section.settings.image | image_url: width: 1400 }}" alt="{{ section.settings.heading }}" width="1400" height="916" loading="lazy" class="flex-case-promo__image" sizes="(max-width: 749px) 100vw, 55vw" style="object-position:26.66% 35.938%;">
      {% else %}
        <img src="//bullstrap.co/cdn/shop/files/new_CC_16_carousel_pics_17.svg?v=1779520821&width=1400" alt="Original Leather Case" srcset="//bullstrap.co/cdn/shop/files/new_CC_16_carousel_pics_17.svg?v=1779520821&width=600 600w, //bullstrap.co/cdn/shop/files/new_CC_16_carousel_pics_17.svg?v=1779520821&width=900 900w, //bullstrap.co/cdn/shop/files/new_CC_16_carousel_pics_17.svg?v=1779520821&width=1200 1200w, //bullstrap.co/cdn/shop/files/new_CC_16_carousel_pics_17.svg?v=1779520821&width=1400 1400w" width="1400" height="916" loading="lazy" class="flex-case-promo__image" sizes="(max-width: 749px) 100vw, 55vw" style="object-position:26.66% 35.938%;">
      {% endif %}
    </div>
  </div>
  
  <div class="flex-case-promo__trust-bar" role="list">
    {% for block in section.blocks %}
      <span class="flex-case-promo__trust-item" role="listitem">
        {{ block.settings.text }}
      </span>
      {% unless forloop.last %}
        <span class="flex-case-promo__trust-sep" aria-hidden="true">*</span>
      {% endunless %}
    {% endfor %}
  </div>
</div>
