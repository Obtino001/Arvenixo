<div
  class="ax-popup"
  id="ax-newsletter-popup"
  hidden
  data-delay="{{ section.settings.delay | times: 1000 }}"
>
  <button class="ax-popup__scrim" type="button" data-ax-popup-close aria-label="Close"></button>
  <div class="ax-popup__card" role="dialog" aria-labelledby="ax-popup-offer">
    <div class="ax-popup__media" aria-hidden="true">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: '' }}
      {%- else -%}
        <img src="{{ 'ax-newsletter-lifestyle.png' | asset_url }}" alt="" width="800" height="900" loading="lazy">
      {%- endif -%}
    </div>
    <div class="ax-popup__form">
      <button class="ax-popup__close" type="button" data-ax-popup-close aria-label="Close">&times;</button>
      <p class="ax-popup__brand">{{ section.settings.kicker }}</p>
      <p class="ax-offer" id="ax-popup-offer">{{ section.settings.offer }}</p>
      <p>{{ section.settings.text }}</p>
      {% form 'customer', class: 'ax-nl-form', id: 'ax-popup-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter,popup">
        <label class="visually-hidden" for="ax-popup-email">Email</label>
        <input id="ax-popup-email" type="email" name="contact[email]" placeholder="Email" required autocomplete="email">
        <button type="submit">{{ section.settings.button_label }}</button>
        {%- if form.posted_successfully? -%}
          <p>You're in. Check your inbox.</p>
        {%- endif -%}
      {% endform %}
      <button class="ax-popup__decline" type="button" data-ax-popup-close>
        {{ section.settings.decline_label }}
      </button>
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('ax-newsletter-popup');
    if (!root) return;
    var key = 'ax_nl_popup_dismissed';
    try {
      if (localStorage.getItem(key)) return;
    } catch (e) {}
    var delay = parseInt(root.getAttribute('data-delay') || '4000', 10);
    function openPopup() {
      root.hidden = false;
      root.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }
    function closePopup() {
      root.classList.remove('is-open');
      root.hidden = true;
      document.body.style.overflow = '';
      try { localStorage.setItem(key, '1'); } catch (e) {}
    }
    root.querySelectorAll('[data-ax-popup-close]').forEach(function (el) {
      el.addEventListener('click', closePopup);
    });
    setTimeout(openPopup, delay);
  })();
</script>

{% schema %}
{
  "name": "AX Newsletter popup",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "delay", "min": 1, "max": 20, "step": 1, "unit": "s", "label": "Delay", "default": 5 },
    { "type": "text", "id": "kicker", "label": "Brand line", "default": "Arvenixo" },
    { "type": "text", "id": "offer", "label": "Offer", "default": "15% OFF" },
    { "type": "text", "id": "text", "label": "Text", "default": "Save on your first order." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Get my code" },
    { "type": "text", "id": "decline_label", "label": "Decline", "default": "No thanks, I'll pay full price." }
  ],
  "presets": [{ "name": "AX Newsletter popup" }]
}
{% endschema %}
