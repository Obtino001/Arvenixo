<style>
  /* ===============  SHOP BY CATEGORY  =============== */

  .collection-selector_main {
    background-color: {{ section.settings.bg_color | default: '#fffdfa' }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  /* Contenedor centrado tipo "page width" */
  .cs-container {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  /* Header */
  .cs-header {
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: var(--page-margin, 24px);
    padding-right: var(--page-margin, 24px);
    color: inherit;
  }

  .cs-header__inner {
    display: flex;
    flex-direction: column;
    align-items: {{ section.settings.header_alignment }};
    text-align: {{ section.settings.header_alignment }};
    width: 100%;
    max-width: none;
  }

  .cs-title {
    margin: 0;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: {{ section.settings.text_color | default: '#000000' }};
  }

  .cs-subtitle {
    margin: 6px 0 14px;
    color: {{ section.settings.text_color | default: '#000000' }};
  }

  /* ===============  PILLS  =============== */

  .pill-container-test-b {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    margin: 0;
    padding: 0;
    gap: 0;
  }

  .pill-test-b {
    position: relative;
    flex: 1 1 25%;
    max-width: 25%;
    aspect-ratio: 2 / 1;
    border-radius: 0;
    overflow: hidden;
    margin: 0;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .pill-test-b img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s ease;
  }

  /* Overlay text */
  .text-overlay-test-b {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: #ffffff;
    padding: 8px 16px;
    border-radius: 20px;
    font-family: 'Encode Sans Expanded', sans-serif;
    font-size: 18px;
    text-align: center;
    white-space: nowrap;
    font-weight: 500;
    font-style: normal;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    line-height: 1.2;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
    pointer-events: none;
  }

  /* Link */
  .pill-link {
    text-decoration: none;
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
  }
  
  .pill-link::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, {{ section.settings.image_overlay_opacity | divided_by: 100.0 }});
    transition: background 0.3s ease;
    z-index: 1;
  }
  
  .text-overlay-test-b {
    z-index: 2;
  }

  /* Hover */
  .pill-test-b:hover img {
    transform: scale(1.05);
  }
  
  .pill-test-b:hover .pill-link::before {
    background: rgba(0, 0, 0, {{ section.settings.image_overlay_opacity | divided_by: 100.0 | plus: 0.15 | at_most: 0.9 }});
  }

  /* Tablets */
  @media screen and (max-width: 1024px) and (min-width: 769px) {
    .pill-test-b {
      flex: 1 1 50%;
      max-width: 50%;
    }

    .text-overlay-test-b {
      font-size: 20px;
      padding: 10px 20px;
    }
  }

  /* Mobile */
  @media screen and (max-width: 768px) {
    .pill-test-b {
      flex: 1 1 100%;
      max-width: 100%;
      aspect-ratio: 3 / 1;
    }

    .text-overlay-test-b {
      font-size: 16px;
      padding: 12px 24px;
    }

    .collection-selector_main {
      padding-top: {{ section.settings.padding_top | divided_by: 2 }}px;
      padding-bottom: {{ section.settings.padding_bottom | divided_by: 2 }}px;
    }
  }
</style>

<section class="collection-selector_main collection-selector-test-b">
  <!-- Header -->
  {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
    <div class="cs-header">
      <div class="cs-container">
        <div class="cs-header__inner">
          {%- if section.settings.title != blank -%}
            <h2 class="_h1 cs-title text-2xl md:text-3xl lg:text-4xl">{{ section.settings.title }}</h2>
          {%- endif -%}
          
          {%- if section.settings.subtitle != blank -%}
            <p class="_p cs-subtitle text-gray-600">{{ section.settings.subtitle }}</p>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  <!-- Pills / Category Cards -->
  <div class="pill-container-test-b">
    {%- for block in section.blocks -%}
      <div class="pill-test-b" {{ block.shopify_attributes }}>
        <a class="pill-link" href="{{ block.settings.link | default: '#' }}" aria-label="{{ block.settings.title | escape }}">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1080 | image_tag: alt: block.settings.image.alt, loading: 'lazy' }}
          {%- else -%}
            {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'w-full h-full object-cover bg-gray-200' }}
          {%- endif -%}
          <div class="text-overlay-test-b">{{ block.settings.title }}</div>
        </a>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop by Category",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Take A Look Around"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header Alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "flex-start"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fffdfa"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Image Overlay Opacity",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Name",
          "default": "CATEGORY NAME"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Category",
      "blocks": [
        { "type": "category", "settings": { "title": "Phone CASES" } },
        { "type": "category", "settings": { "title": "WALLETS" } },
        { "type": "category", "settings": { "title": "WATCH STRAPS" } },
        { "type": "category", "settings": { "title": "BELTS" } }
      ]
    }
  ]
}
{% endschema %}
