<section class="ax-pstories">
  {%- for block in section.blocks -%}
    <article class="ax-pstory{% if block.settings.dark %} is-dark{% endif %}" {{ block.shopify_attributes }}>
      <div class="ax-wrap ax-pstory__inner">
        {%- if block.settings.kicker != blank -%}
          <p class="ax-kicker">{{ block.settings.kicker }}</p>
        {%- endif -%}
        {%- if block.settings.heading != blank -%}
          <h2>{{ block.settings.heading }}</h2>
        {%- endif -%}
        {%- if block.settings.text != blank -%}
          <p>{{ block.settings.text }}</p>
        {%- endif -%}
      </div>
    </article>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "AX Product stories",
  "blocks": [
    {
      "type": "story",
      "name": "Story",
      "settings": [
        { "type": "text", "id": "kicker", "label": "Kicker" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "checkbox", "id": "dark", "label": "Dark background", "default": false }
      ]
    }
  ],
  "enabled_on": { "templates": ["product"] },
  "presets": [
    {
      "name": "AX Product stories",
      "blocks": [
        {
          "type": "story",
          "settings": {
            "kicker": "Always with you",
            "heading": "Everything in its place",
            "text": "Your phone and essentials, all in one. A lighter load — everything you need, always at hand."
          }
        },
        {
          "type": "story",
          "settings": {
            "kicker": "Thoughtful considerations",
            "heading": "Protected core, instant access",
            "text": "Intentional design that organizes your essentials by priority — whether it's speed or security.",
            "dark": true
          }
        },
        {
          "type": "story",
          "settings": {
            "kicker": "Durable by design",
            "heading": "Consciously crafted",
            "text": "Built for longevity with a lighter footprint. Smarter carry, kinder materials."
          }
        }
      ]
    }
  ]
}
{% endschema %}
