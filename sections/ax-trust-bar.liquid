{%- style -%}
  .iwao-trust-bar-{{ section.id }} {
    width: 100%;
    min-height: 38px;
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    overflow: hidden;
    border-bottom: 1px solid {{ section.settings.text_color | color_modify: 'alpha', 0.08 }};
    font-family: inherit;
    position: relative;
    z-index: 2;
    box-sizing: border-box;
  }

  .iwao-trust-bar-{{ section.id }} *,
  .iwao-trust-bar-{{ section.id }} *::before,
  .iwao-trust-bar-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__inner {
    width: 100%;
    min-height: 38px;
    padding: 0 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__desktop {
    width: 100%;
    max-width: 1480px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    white-space: nowrap;
  }

  .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__usp-wrap {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-width: 0;
    flex: 1 1 auto;
  }

  .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__desktop--centered .iwao-trust-bar__usp-wrap {
    justify-content: center;
  }

  .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__item,
  .iwao-trust-bar-{{ section.id }} a.iwao-trust-bar__phone,
  .iwao-trust-bar-{{ section.id }} a.iwao-trust-bar__phone:link,
  .iwao-trust-bar-{{ section.id }} a.iwao-trust-bar__phone:visited {
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: {{ section.settings.text_color | color_modify: 'alpha', 0.94 }} !important;
    font-size: 13px;
    line-height: 1;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
  }

  .iwao-trust-bar-{{ section.id }} a.iwao-trust-bar__phone {
    margin-right: 34px;
    font-weight: 600;
    flex: 0 0 auto;
  }

  .iwao-trust-bar-{{ section.id }} a.iwao-trust-bar__phone:hover {
    color: {{ section.settings.text_color }} !important;
    text-decoration: none;
  }

  .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__icon,
  .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__icon svg {
    width: 17px;
    height: 17px;
    flex: 0 0 17px;
    color: {{ section.settings.icon_color }};
    display: block;
  }

  .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__divider {
    width: 1px;
    height: 16px;
    margin: 0 22px;
    background: {{ section.settings.text_color | color_modify: 'alpha', 0.22 }};
    flex: 0 0 1px;
  }

  .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__mobile { display: none; }

  @media (max-width: 1180px) {
    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__inner { padding: 0 28px; }
    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__divider { margin: 0 18px; }
    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__item,
    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__phone { font-size: 12.5px; }
  }

  @media (max-width: 989px) {
    .iwao-trust-bar-{{ section.id }} { min-height: 36px; }
    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__inner {
      min-height: 36px;
      padding: 0;
      justify-content: flex-start;
    }
    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__desktop { display: none; }

    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__mobile {
      width: 100%;
      min-height: 36px;
      display: flex;
      align-items: center;
      position: relative;
      background: {{ section.settings.bg_color }};
    }

    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__ticker {
      position: relative;
      min-width: 0;
      flex: 1 1 auto;
      height: 36px;
      overflow: hidden;
      display: flex;
      align-items: center;
      padding-left: 12px;
    }

    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__ticker::after {
      content: "";
      position: absolute;
      top: 0; right: 0;
      width: 44px; height: 100%;
      pointer-events: none;
      background: linear-gradient(to right, {{ section.settings.bg_color | color_modify: 'alpha', 0 }}, {{ section.settings.bg_color }});
      z-index: 2;
    }

    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__track {
      display: flex;
      align-items: center;
      width: max-content;
      will-change: transform;
      animation: iwaoTrustBarTicker-{{ section.id }} {{ section.settings.marquee_speed }}s linear infinite;
    }

    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__group {
      display: flex;
      align-items: center;
      flex: 0 0 auto;
      white-space: nowrap;
    }

    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__mobile .iwao-trust-bar__item {
      min-height: 36px;
      font-size: 12.5px;
      gap: 7px;
    }

    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__mobile .iwao-trust-bar__icon,
    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__mobile .iwao-trust-bar__icon svg {
      width: 15px; height: 15px; flex-basis: 15px;
    }

    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__mobile .iwao-trust-bar__divider {
      height: 14px;
      margin: 0 16px;
    }

    .iwao-trust-bar-{{ section.id }} a.iwao-trust-bar__mobile-phone,
    .iwao-trust-bar-{{ section.id }} a.iwao-trust-bar__mobile-phone:link,
    .iwao-trust-bar-{{ section.id }} a.iwao-trust-bar__mobile-phone:visited {
      height: 36px;
      flex: 0 0 auto;
      min-width: 116px;
      padding: 0 10px;
      margin-left: 4px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      color: {{ section.settings.text_color }} !important;
      text-decoration: none;
      font-size: 13px;
      font-weight: 600;
      white-space: nowrap;
      background: {{ section.settings.bg_color }};
      border-left: 1px solid {{ section.settings.text_color | color_modify: 'alpha', 0.16 }};
      position: relative;
      z-index: 3;
    }

    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__mobile-phone svg {
      width: 15px; height: 15px; flex: 0 0 15px;
      color: {{ section.settings.icon_color }};
      display: block;
    }

    @keyframes iwaoTrustBarTicker-{{ section.id }} {
      from { transform: translateX(0); }
      to   { transform: translateX(-50%); }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__track { animation: none; }
  }
{%- endstyle -%}

<div class="iwao-trust-bar-{{ section.id }}" data-iwao-trust-bar>
  <div class="iwao-trust-bar__inner">
    <div class="iwao-trust-bar__desktop{% if section.settings.phone_text == blank %} iwao-trust-bar__desktop--centered{% endif %}">
      {%- if section.settings.phone_text != blank -%}
        <a class="iwao-trust-bar__phone" href="{{ section.settings.phone_url | default: '#' }}" aria-label="{{ section.settings.phone_text | escape }}">
          <div class="iwao-trust-bar__icon">{{ section.settings.phone_icon }}</div>
          <span>{{ section.settings.phone_text }}</span>
        </a>
      {%- endif -%}

      <div class="iwao-trust-bar__usp-wrap">
        {%- for block in section.blocks -%}
          <span class="iwao-trust-bar__item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <div class="iwao-trust-bar__icon">{{ block.settings.icon }}</div>
            {%- endif -%}
            <span>{{ block.settings.text }}</span>
          </span>
          {%- unless forloop.last -%}
            <span class="iwao-trust-bar__divider" aria-hidden="true"></span>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="iwao-trust-bar__mobile">
      <div class="iwao-trust-bar__ticker">
        <div class="iwao-trust-bar__track">
          {%- for i in (1..2) -%}
            <div class="iwao-trust-bar__group">
              {%- for block in section.blocks -%}
                <span class="iwao-trust-bar__item">
                  {%- if block.settings.icon != blank -%}
                    <div class="iwao-trust-bar__icon">{{ block.settings.icon }}</div>
                  {%- endif -%}
                  <span>{{ block.settings.text }}</span>
                </span>
                <span class="iwao-trust-bar__divider" aria-hidden="true"></span>
              {%- endfor -%}
            </div>
          {%- endfor -%}
        </div>
      </div>

      {%- if section.settings.phone_text != blank -%}
        <a class="iwao-trust-bar__mobile-phone" href="{{ section.settings.phone_url | default: '#' }}" aria-label="{{ section.settings.phone_text | escape }}">
          <div class="iwao-trust-bar__icon">{{ section.settings.phone_icon }}</div>
          <span>{{ section.settings.phone_text }}</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Trust announcement bar",
  "tag": "section",
  "class": "ax-trust-bar-section",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#111111" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#f4f1ec" },
    { "type": "color", "id": "icon_color", "label": "Icons", "default": "#f4f1ec" },
    { "type": "text", "id": "phone_text", "label": "Phone text" },
    { "type": "url", "id": "phone_url", "label": "Phone link" },
    {
      "type": "textarea",
      "id": "phone_icon",
      "label": "Phone SVG",
      "default": "<svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M7.2 4.4l2-.8c.7-.3 1.5.1 1.8.8l.9 2.2c.2.6.1 1.3-.4 1.7l-1.1.9c.8 1.8 2.2 3.2 4 4l.9-1.1c.4-.5 1.1-.7 1.7-.4l2.2.9c.7.3 1.1 1.1.8 1.8l-.8 2c-.3.7-1 1.1-1.8 1-6.1-.7-10.9-5.5-11.6-11.6-.1-.7.3-1.4 1.4-1.8Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"></path></svg>"
    },
    { "type": "range", "id": "marquee_speed", "min": 10, "max": 60, "step": 2, "unit": "s", "label": "Marquee speed", "default": 22 }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "Trust item",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping" },
        { "type": "textarea", "id": "icon", "label": "Icon SVG" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust announcement bar",
      "blocks": [
        {
          "type": "usp",
          "settings": {
            "text": "Free shipping on qualifying orders",
            "icon": "<svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M3.5 7H14v9H3.5V7Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"></path><path d=\"M14 10h3.6l2.9 3v3H14v-6Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"></path><circle cx=\"7.2\" cy=\"17.2\" r=\"1.8\" stroke=\"currentColor\" stroke-width=\"1.8\"></circle><circle cx=\"17.3\" cy=\"17.2\" r=\"1.8\" stroke=\"currentColor\" stroke-width=\"1.8\"></circle></svg>"
          }
        },
        {
          "type": "usp",
          "settings": {
            "text": "30-day hassle-free returns",
            "icon": "<svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4.5 12a7.5 7.5 0 1 0 2.2-5.3\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"></path><path d=\"M4.5 4.8v4.2h4.2\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>"
          }
        },
        {
          "type": "usp",
          "settings": {
            "text": "MagSafe compatible",
            "icon": "<svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"8.2\" stroke=\"currentColor\" stroke-width=\"1.8\"></circle><circle cx=\"12\" cy=\"12\" r=\"3.2\" stroke=\"currentColor\" stroke-width=\"1.8\"></circle><circle cx=\"12\" cy=\"12\" r=\"1\" fill=\"currentColor\"></circle></svg>"
          }
        },
        {
          "type": "usp",
          "settings": {
            "text": "Secure checkout",
            "icon": "<svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M12 3.5l7 3v5.2c0 4.2-2.8 7.8-7 9.4-4.2-1.6-7-5.2-7-9.4V6.5l7-3Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"></path></svg>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
